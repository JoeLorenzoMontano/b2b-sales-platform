@model ProductDetailsModel

<div id="product-attributes"></div>
@{
    //dynamic update support
    var attributeChangeHandlerFuncName = $"attribute_change_handler_{Model.Id}";
    var fileLink = Url.RouteUrl("UploadFileProductAttribute");
    //render scripts
    <div id="product-attributes">
        <template v-if="standardProductAttributes_@(Model.Id).ProductAttributes !== 'undefined'">
            <div class="attributes">
                <table class="table">
                    <tr v-for="attribute in standardProductAttributes_@(Model.Id).ProductAttributes">
                        <td :id="'product_attribute_label_' + attribute.Id">
                            <span class="attribute-name">{{attribute.Name}}</span> <span v-if="attribute.IsRequired" class="required">*</span>
                            <template v-if="attribute.TextPrompt !==null">
                                <span class="text-prompt">{{attribute.TextPrompt}}</span>
                            </template>
                            <template v-if="attribute.Description !==null">
                                <span v-html="attribute.Description" class="attribute-description"></span>
                            </template>
                        </td>
                        <td :id="'product_attribute_input_' + attribute.Id">
                            <template v-if="attribute.AttributeControlType==4">
                                <label :for="'product_attribute_' + attribute.Id" class="sr-only">product_attribute_{{attribute.Id}}</label>
                                <input :name="'attributes[' + attribute.Id+']'" type="text" class="form-control textbox" :id="'product_attribute_' + attribute.Id" :value="attribute.DefaultValue" @@change="standardProductAttributes_@(Model.Id).attrchange"/>
                            </template>
                            <template v-if="attribute.AttributeControlType==1">
                                <label :for="'product_attribute_' + attribute.Id" class="sr-only">product_attribute_{{attribute.Id}}</label>
                                <select :id="'product_attribute_' + attribute.Id" class="form-control custom-select" :name="'attributes[' + attribute.Id+']'" @@change="standardProductAttributes_@(Model.Id).attrchange">
                                    <template v-if="attribute.IsRequired==false">
                                        <option value="">---</option>
                                    </template>
                                    <option v-for="attributeValue in attribute.Values" :selected="attributeValue.IsPreSelected" :value="attributeValue.Id" :data-disable="attributeValue.Id">
                                        <template v-if="attributeValue.PriceAdjustment==null">
                                            {{attributeValue.Name}}
                                        </template>
                                        <template v-else>
                                            {{attributeValue.Name}}[{{attributeValue.PriceAdjustment}}]
                                        </template>
                                    </option>
                                </select>
                            </template>
                            <template v-if="attribute.AttributeControlType==2">
                                <ul class="option-list px-0 mb-0">
                                    <li v-for="attributeValue in attribute.Values">
                                        <fieldset>
                                            <legend class="sr-only">product_attribute_{{attribute.Id}}</legend>
                                            <label class="custom-control custom-radio">
                                                <input class="custom-control-input"
                                                       :id="'product_attribute_' + attribute.Id + '_' + attributeValue.Id"
                                                       type="radio"
                                                       :name="'attributes[' + attribute.Id+']'"
                                                       :value="attributeValue.Id"
                                                       :checked="attributeValue.IsPreSelected"
                                                       :data-disable="attributeValue.Id"
                                                       @@change="standardProductAttributes_@(Model.Id).attrchange"/>
                                                <span class="custom-control-label"></span>
                                                <span class="custom-control-description" :for="'product_attribute_' + attribute.Id + '_' + attributeValue.Id">
                                                    <template v-if="attributeValue.PriceAdjustment==null">
                                                        {{attributeValue.Name}}
                                                    </template>
                                                    <template v-else>
                                                        {{attributeValue.Name}}[{{attributeValue.PriceAdjustment}}]
                                                    </template>
                                                </span>
                                            </label>
                                        </fieldset>
                                    </li>
                                </ul>
                            </template>
                            <template v-if="attribute.AttributeControlType==3 || attribute.AttributeControlType==50">
                                <fieldset>
                                    <legend></legend>
                                    <ul class="option-list px-0 mb-0">
                                        <li v-for="attributeValue in attribute.Values">
                                            <label class="custom-control custom-checkbox">
                                                <input v-if="attribute.AttributeControlType==50"
                                                       class="custom-control-input"
                                                       :id="'product_attribute_' + attribute.Id + '_' + attributeValue.Id"
                                                       type="checkbox"
                                                       :name="'attributes[' + attribute.Id+']'"
                                                       :value="attributeValue.Id"
                                                       :checked="attributeValue.IsPreSelected"
                                                       @@change="standardProductAttributes_@(Model.Id).attrchange"
                                                       disabled="disabled"/>
                                                <input v-else
                                                       class="custom-control-input"
                                                       :id="'product_attribute_' + attribute.Id + '_' + attributeValue.Id"
                                                       type="checkbox"
                                                       :name="'attributes[' + attribute.Id+']'"
                                                       :value="attributeValue.Id"
                                                       :checked="attributeValue.IsPreSelected"
                                                       :data-disable="attributeValue.Id"
                                                       @@change="standardProductAttributes_@(Model.Id).attrchange"/>
                                                <span class="custom-control-label"></span>
                                                <span class="custom-control-description" :for="'product_attribute_' + attribute.Id + '_' + attributeValue.Id">
                                                    <template v-if="attributeValue.PriceAdjustment==null">
                                                        {{attributeValue.Name}}
                                                    </template>
                                                    <template v-else>
                                                        {{attributeValue.Name}}[{{attributeValue.PriceAdjustment}}]
                                                    </template>
                                                </span>
                                            </label>
                                        </li>
                                    </ul>
                                </fieldset>
                            </template>
                            <template v-if="attribute.AttributeControlType==10">
                                <textarea :id="'product_attribute_' + attribute.Id" :name="'attributes[' + attribute.Id+']'">{{attribute.DefaultValue}}</textarea>
                            </template>
                            <template v-if="attribute.AttributeControlType==30">
                                <template>
                                    <div :id="'product_attribute_' + attribute.Id + 'uploader'">
                                        <b-form-file :accept="attribute.AllowedFileExtensions"
                                                     type="file"
                                                     id="qqfile"
                                                     name="qqfile"
                                                     :data-url="'@fileLink/' + attribute.Id + '?productId=' + attribute.ProductId"
                                                     @@change="vm.uploadFile($event.target)"/>
                                    </div>
                                </template>
                                <input class="hidden-upload-input"
                                       type="hidden"
                                       :id="'product_attribute_' + attribute.Id"
                                       :name="'attributes[' + attribute.Id+']'"
                                       v-model="attribute.DefaultValue"
                                       :value="attribute.DefaultValue"/>
                                <div id="download-message" class="alert my-2" style="display: none;"></div>
                                <div :id="'product_attribute_' + attribute.Id + 'downloadurl'" class="download-file" style="display: none;">
                                    <a class="btn btn-outline-info"> Download </a>
                                </div>
                            </template>
                            <template v-if="attribute.AttributeControlType==40">
                                <ul class="option-list color-squares w-100 d-inline-flex flex-wrap px-0 mb-0" :id="'color-squares-' + attribute.Id">
                                    <li v-for="attributeValue in attribute.Values" class="mr-1 p-0">
                                        <label :for="'product_attribute_' + attribute.Id + '_' + attributeValue.Id" class="mb-0">
                                            <input :id="'product_attribute_' + attribute.Id + '_' + attributeValue.Id" type="radio" :name="'attributes[' + attribute.Id+']'" :value="attributeValue.Id" :checked="attributeValue.IsPreSelected" :data-disable="attributeValue.Id" @@change="standardProductAttributes_@(Model.Id).attrchange"/>
                                            <template v-if="attributeValue.PriceAdjustment==null">
                                                <span class="color-container" :title="attributeValue.Name">
                                                    <span class="color" :style="'background-color:' + attributeValue.ColorSquaresRgb"></span>
                                                </span>
                                            </template>
                                            <template v-else>
                                                <span class="color-container" :title="attributeValue.Name + ' [' + attributeValue.PriceAdjustment + ']'">
                                                    <span class="color" :style="'background-color:' + attributeValue.ColorSquaresRgb"></span>
                                                </span>
                                            </template>
                                        </label>
                                    </li>
                                </ul>
                            </template>
                            <template v-if="attribute.AttributeControlType==45">
                                <ul class="option-list color-squares w-100 d-inline-flex flex-wrap px-0 mb-0" :id="'color-squares-' + attribute.Id">
                                    <li v-for="attributeValue in attribute.Values" class="mr-1 p-0">
                                        <label :for="'product_attribute_' + attribute.Id + '_' + attributeValue.Id" class="mb-0">
                                            <template v-if="attributeValue.PriceAdjustment==null">
                                                <input :id="'product_attribute_' + attribute.Id + '_' + attributeValue.Id" type="radio" :name="'attributes[' + attribute.Id+']'" :value="attributeValue.Id" :checked="attributeValue.IsPreSelected" :data-disable="attributeValue.Id" @@change="standardProductAttributes_@(Model.Id).attrchange"/>
                                                <span :id="'imgSqr_' + attributeValue.Id" class="color-container">
                                                    <span class="color" :style="'background: url(' + attributeValue.ImageSquaresPictureModel.ImageUrl + ') 50% 50% no-repeat;'"></span>
                                                </span>
                                                <b-tooltip :target="'imgSqr_' + attributeValue.Id" placement="bottom">
                                                    <div class="image-square-tooltip">
                                                        <img :src="attributeValue.ImageSquaresPictureModel.FullSizeImageUrl" :alt="attributeValue.Name"/> <span>{{attributeValue.Name}}</span>
                                                    </div>
                                                </b-tooltip>
                                            </template>
                                            <template v-else>
                                                <input :id="'product_attribute_' + attribute.Id + '_' + attributeValue.Id" type="radio" :name="'attributes[' + attribute.Id+']'" :value="attributeValue.Id" :checked="attributeValue.IsPreSelected" :data-disable="attributeValue.Id" @@change="standardProductAttributes_@(Model.Id).attrchange"/>
                                                <span :id="'imgSqr_' + attributeValue.Id" class="color-container">
                                                    <span class="color" :style="'background: url(' + attributeValue.ImageSquaresPictureModel.ImageUrl + ') 50% 50% no-repeat;'"></span>
                                                </span>
                                                <b-tooltip :target="'imgSqr_' + attributeValue.Id" placement="bottom">
                                                    <div class="image-square-tooltip">
                                                        <img :src="attributeValue.ImageSquaresPictureModel.FullSizeImageUrl" :alt="attributeValue.Name + ' [' + attributeValue.PriceAdjustment + ']'"/>
                                                        <span>{{attributeValue.Name}}[{{attributeValue.PriceAdjustment}}]</span>
                                                    </div>
                                                </b-tooltip>
                                            </template>
                                        </label>
                                    </li>
                                </ul>
                            </template>
                        </td>
                    </tr>
                </table>
            </div>
        </template>
    </div>
    <script asp-location="Footer" asp-order="300">
        var standardProductAttributes_@(Model.Id) = new Vue({
            data: function () {
                return {
                    ProductAttributes: null
                }
            },
            methods: {
                attrchange: function @(attributeChangeHandlerFuncName)() {
                    var form = document.getElementById('@($"product-details-form-{Model.Id}")');
                    var data = new FormData(form);
                    
                    // Always include the most current quantity value in the form data
                    // Overwrite any existing EnteredQuantity to ensure the latest value is used
                    var qtyInput = document.querySelector('#EnteredQuantity_@Model.Id');
                    if (qtyInput) {
                        // Remove existing EnteredQuantity entry if it exists
                        if (data.has('EnteredQuantity')) {
                            data.delete('EnteredQuantity');
                        }
                        // Add the current quantity value
                        data.append('EnteredQuantity', qtyInput.value);
                    }
                    
                    axios({
                        url: '@Html.Raw(Url.Action("productdetails_attributechange", "product", new { productId = Model.Id, loadPicture = true }))',
                        data: data,
                        method: 'post',
                        params: { product: '@Model.Id' },
                    }).then(function (response) {
                        if (response.data.price) {
                            if (document.querySelector('.price-value-@Model.Id .actual-price'))
                                document.querySelector('.price-value-@Model.Id .actual-price').innerText = response.data.price;
                            else
                                document.querySelector('.price-value-@Model.Id').innerText = response.data.price;
                        }
                        if (response.data.sku) {
                            if(document.querySelector('#sku-@Model.Id'))
                                document.querySelector('#sku-@Model.Id').innerText = response.data.sku;
                        }
                        if (response.data.mpn) {
                            if(document.querySelector('#mpn-@Model.Id'))
                                document.querySelector('#mpn-@Model.Id').innerText = response.data.mpn;
                        }
                        if (response.data.gtin) {
                            if(document.querySelector('#gtin-@Model.Id'))
                                document.querySelector('#gtin-@Model.Id').innerText = response.data.gtin;
                        }
                        if (response.data.stockAvailability) {
                            if(document.querySelector('#stock-availability-value-@Model.Id'))
                                document.querySelector('#stock-availability-value-@Model.Id').innerText = response.data.stockAvailability;
                        }
                        if (response.data.outOfStockSubscription) {
                            var element = document.querySelector('#out-of-stock-subscribe-@Model.Id');
                            if (element)
                                element.style.display = "block";
                        }
                        if (response.data.outOfStockSubscription == false) {
                            var element = document.querySelector('#out-of-stock-subscribe-@Model.Id');
                            if (element) {
                                element.style.display = "none";
                            }
                        }
                        if (response.data.buttonTextOutOfStockSubscription) {
                            var element = document.querySelector('#out-of-stock-subscribe-@Model.Id');
                            if (element)
                                element.value = response.data.buttonTextOutOfStockSubscription;
                        }
                        if (response.data.enabledattributemappingids) {
                            for (var i = 0; i < response.data.enabledattributemappingids.length; i++) {
                                document.querySelector('#product_attribute_label_' + response.data.enabledattributemappingids[i]).style.display = "table-cell";
                                document.querySelector('#product_attribute_input_' + response.data.enabledattributemappingids[i]).style.display = "table-cell";
                            }
                        }
                        if (response.data.disabledattributemappingids) {
                            for (var i = 0; i < response.data.disabledattributemappingids.length; i++) {
                                document.querySelector('#product_attribute_label_' + response.data.disabledattributemappingids[i]).style.display = "none";
                                document.querySelector('#product_attribute_input_' + response.data.disabledattributemappingids[i]).style.display = "none";
                            }
                        }
                        @*if (response.data.notAvailableAttributeMappingids) {
                            document.querySelectorAll('[data-disable]').forEach((element) => element.disabled = false);
                            for (var i = 0; i < response.data.notAvailableAttributeMappingids.length; i++) {
                                if (document.querySelectorAll("[data-disable='" + response.data.notAvailableAttributeMappingids[i] + "']").length > 0) {
                                    document.querySelectorAll("[data-disable='" + response.data.notAvailableAttributeMappingids[i] + "']")[0].disabled = true;
                                }
                            }
                        }*@
                        setTimeout(function () {
                            if (response.data.pictureDefaultSizeUrl) {
                                document.getElementById('main-product-img-@Model.Id').setAttribute("src", response.data.pictureDefaultSizeUrl);
                            }
                        }, 100);
                        
                        // Update allowed quantities if they are in the response
                        if (response.data.allowedQuantities && response.data.allowedQuantities.length > 0) {
                            var quantitySelect = document.querySelector('#EnteredQuantity_@Model.Id');
                            if (quantitySelect) {
                                // Save current selection
                                var currentValue = quantitySelect.value;
                                
                                // Clear current options
                                quantitySelect.innerHTML = '';
                                
                                // Add new options
                                response.data.allowedQuantities.forEach(function(option) {
                                    var opt = document.createElement('option');
                                    opt.value = option.value;
                                    opt.text = option.text;
                                    
                                    quantitySelect.appendChild(opt);
                                });
                                
                                // Try to restore selection if it exists in new options
                                var optionExists = Array.from(quantitySelect.options).some(function(option) {
                                    return option.value === currentValue;
                                });
                                
                                if (optionExists) {
                                    quantitySelect.value = currentValue;
                                } else if (quantitySelect.options.length > 0) {
                                    // If the previous selection is no longer available, select the first option
                                    quantitySelect.selectedIndex = 0;
                                }
                                
                                // We'll skip triggering an additional attribute change here
                                // to prevent recursion/infinite loops
                            }
                            
                            // Show or hide the sample notification
                            var sampleNotification = document.querySelector('#sample-notification-@Model.Id');
                            if (!sampleNotification) {
                                // Create notification if it doesn't exist
                                sampleNotification = document.createElement('div');
                                sampleNotification.id = 'sample-notification-@Model.Id';
                                sampleNotification.className = 'sample-notification alert alert-info mt-2';
                                sampleNotification.style.display = 'none';
                                sampleNotification.innerHTML = '<small>Sample size (1) available for this product</small>';
                                
                                // Insert after the quantity dropdown
                                if (quantitySelect) {
                                    quantitySelect.parentNode.insertBefore(sampleNotification, quantitySelect.nextSibling);
                                }
                            }
                            
                            // Show or hide based on SampleEnabled
                            if (response.data.sampleEnabled) {
                                sampleNotification.style.display = 'block';
                                
                                // Add event listener to quantity dropdown to show/hide "Ordering Sample" badge
                                if (quantitySelect && !quantitySelect.hasAttribute('data-sample-listener')) {
                                    // Create or get the sample indicator badge
                                    var sampleIndicator = document.querySelector('#sample-indicator-@Model.Id');
                                    if (!sampleIndicator) {
                                        sampleIndicator = document.createElement('div');
                                        sampleIndicator.id = 'sample-indicator-@Model.Id';
                                        sampleIndicator.className = 'sample-indicator badge badge-warning mt-2 ml-2';
                                        sampleIndicator.style.display = 'none';
                                        sampleIndicator.innerHTML = '<span><i class="fa fa-info-circle mr-2"></i>You are ordering a SAMPLE of this product (Quantity: 1)</span>';
                                        
                                        // For grouped products, we need to add the indicator within the card body for associated products
                                        var isGroupedProduct = document.querySelector('.product-grouped') !== null;
                                        var formContainer, targetContainer;

                                        if (isGroupedProduct) {
                                            // Find the form first
                                            formContainer = document.querySelector('#product-details-form-@Model.Id');
                                            if (formContainer) {
                                                // Find the card body containing this product's details within the form
                                                targetContainer = formContainer.querySelector('.card-body');
                                                
                                                // Create a more noticeable indicator for grouped products
                                                sampleIndicator.className = 'sample-indicator badge badge-warning mt-2 mb-2 p-2';
                                                sampleIndicator.style.cssText = 'display:none; font-size:1rem; width:100%; text-align:center; background-color:#ff9800; color:white;';
                                                
                                                // Insert at beginning of card body, right after the header
                                                if (targetContainer) {
                                                    var firstElement = targetContainer.querySelector('h5') || targetContainer.firstChild;
                                                    if (firstElement && firstElement.nextSibling) {
                                                        targetContainer.insertBefore(sampleIndicator, firstElement.nextSibling);
                                                    } else {
                                                        targetContainer.appendChild(sampleIndicator);
                                                    }
                                                }
                                            }
                                        } else {
                                            // Normal product - original behavior
                                            formContainer = document.querySelector('#product-details-form-@Model.Id');
                                            if (formContainer) {
                                                // Create a more noticeable indicator
                                                sampleIndicator.className = 'sample-indicator badge badge-warning mt-2 mb-2 p-2';
                                                sampleIndicator.style.cssText = 'display:none; font-size:1rem; width:100%; text-align:center; background-color:#ff9800; color:white;';
                                                
                                                // Insert at the top of the form for better visibility
                                                if (formContainer.firstChild) {
                                                    formContainer.insertBefore(sampleIndicator, formContainer.firstChild);
                                                } else {
                                                    formContainer.appendChild(sampleIndicator);
                                                }
                                            }
                                        }
                                    }
                                    
                                    // Add change event listener to update indicator visibility
                                    quantitySelect.addEventListener('change', function() {
                                        // Check if quantity 1 is a sample (look for "(Sample)" in the option text)
                                        var isSample = false;
                                        for (var i = 0; i < quantitySelect.options.length; i++) {
                                            if (quantitySelect.options[i].value === '1' && 
                                                quantitySelect.options[i].text.includes('(Sample)')) {
                                                isSample = true;
                                                break;
                                            }
                                        }
                                        
                                        if (this.value === '1' && isSample) {
                                            // Use visibility rather than display for more reliable showing
                                            sampleIndicator.style.display = 'block';
                                            sampleIndicator.style.visibility = 'visible';
                                            sampleIndicator.style.opacity = '1';
                                            
                                            // Removed debug logging
                                        } else {
                                            sampleIndicator.style.display = 'none';
                                            sampleIndicator.style.visibility = 'hidden';
                                            sampleIndicator.style.opacity = '0';
                                            
                                            // Auto-change from 1 if sample is not available
                                            if (this.value === '1' && !isSample && quantitySelect.options.length > 1) {
                                                // Find the next available quantity (the smallest non-1 value)
                                                var nextQuantity = null;
                                                for (var i = 0; i < quantitySelect.options.length; i++) {
                                                    var val = parseInt(quantitySelect.options[i].value);
                                                    if (val !== 1 && (nextQuantity === null || val < nextQuantity)) {
                                                        nextQuantity = val;
                                                    }
                                                }
                                                
                                                if (nextQuantity !== null) {
                                                    // Change to the next quantity automatically
                                                    this.value = nextQuantity.toString();
                                                }
                                            }
                                        }
                                    });
                                    
                                    // Set initial state based on quantity dropdown value
                                    // First check if quantity 1 is a sample (look for "(Sample)" in the option text)
                                    var initialIsSample = false;
                                    for (var i = 0; i < quantitySelect.options.length; i++) {
                                        if (quantitySelect.options[i].value === '1' && 
                                            quantitySelect.options[i].text.includes('(Sample)')) {
                                            initialIsSample = true;
                                            break;
                                        }
                                    }
                                    
                                    if (quantitySelect.value === '1' && initialIsSample) {
                                        sampleIndicator.style.display = 'block';
                                        sampleIndicator.style.visibility = 'visible';
                                        sampleIndicator.style.opacity = '1';
                                    } else if (quantitySelect.value === '1' && !initialIsSample && quantitySelect.options.length > 1) {
                                        // Auto-change from 1 if sample is not available at init
                                        var nextQuantity = null;
                                        for (var i = 0; i < quantitySelect.options.length; i++) {
                                            var val = parseInt(quantitySelect.options[i].value);
                                            if (val !== 1 && (nextQuantity === null || val < nextQuantity)) {
                                                nextQuantity = val;
                                            }
                                        }
                                        
                                        if (nextQuantity !== null) {
                                            // Change to the next quantity automatically
                                            quantitySelect.value = nextQuantity.toString();
                                        }
                                    }
                                    
                                    // Mark that we've attached the listener
                                    quantitySelect.setAttribute('data-sample-listener', 'true');
                                }
                            } else {
                                sampleNotification.style.display = 'none';
                                
                                // Hide the sample indicator if it exists
                                var sampleIndicator = document.querySelector('#sample-indicator-@Model.Id');
                                if (sampleIndicator) {
                                    sampleIndicator.style.display = 'none';
                                }
                            }
                        }
                        
                        // Update case calculations if case size is available
                        console.log('Case size from response:', response.data.caseSize, 'Type:', typeof response.data.caseSize);
                        if (response.data.caseSize && typeof response.data.caseSize === 'number' && response.data.caseSize > 0) {
                            // Store case size globally for this product
                            window['caseSize_@Model.Id'] = response.data.caseSize;
                            
                            // Populate case dropdowns and sync with quantity
                            updateCaseDropdowns_@(Model.Id)();
                            
                            // Show case info and total elements
                            var caseInfoElements = document.querySelectorAll('#case-info-@Model.Id, #case-info-input-@Model.Id, #total-info-@Model.Id, #total-info-input-@Model.Id');
                            caseInfoElements.forEach(function(element) {
                                element.style.display = 'block';
                            });
                        } else {
                            // Hide case info and total if no case size, show interactive Units dropdown/input
                            console.log('Hiding case info - case size not valid');
                            var caseInfoElements = document.querySelectorAll('#case-info-@Model.Id, #case-info-input-@Model.Id, #total-info-@Model.Id, #total-info-input-@Model.Id');
                            caseInfoElements.forEach(function(element) {
                                console.log('Hiding element:', element);
                                element.style.display = 'none';
                            });
                            
                            // Show interactive Units dropdown/input and hide Units display
                            var qtyInput = document.getElementById('EnteredQuantity_@Model.Id');
                            var qtyDropdown = document.querySelector('select[name="EnteredQuantity"][id="EnteredQuantity_@Model.Id"]');
                            var unitsDisplay = document.getElementById('EnteredUnits_@Model.Id') || document.getElementById('EnteredUnits_input_@Model.Id');
                            
                            if (unitsDisplay) {
                                unitsDisplay.style.display = 'none';
                            }
                            if (qtyDropdown) {
                                qtyDropdown.style.display = 'block';
                            }
                            if (qtyInput) {
                                qtyInput.style.display = 'block';
                            }
                        }
                    });
                },
            },
            created() {
                this.ProductAttributes = @Json.Serialize(Model.ProductAttributes);
            }
        });

        // Use a simple flag variable to prevent multiple initializations
        var productInitialized_@(Model.Id) = false;
        document.addEventListener("DOMContentLoaded", function () {
            if (!productInitialized_@(Model.Id)) {
                productInitialized_@(Model.Id) = true;
                
                // Add a very short delay to ensure all components are loaded
                setTimeout(function() {
                    // Only initialize once
                    if (standardProductAttributes_@(Model.Id).ProductAttributes) {
                        standardProductAttributes_@(Model.Id).attrchange();
                    }
                }, 50);
            }
        });
        
        // Helper functions for case dropdown functionality
        function updateCaseDropdowns_@(Model.Id)() {
            var caseSize = window['caseSize_@Model.Id'];
            if (!caseSize || caseSize <= 0) return;
            
            var qtyInput = document.getElementById('EnteredQuantity_@Model.Id');
            var qtyDropdown = document.querySelector('select[name="EnteredQuantity"][id="EnteredQuantity_@Model.Id"]');
            var caseDropdown = document.getElementById('EnteredCases_@Model.Id') || document.getElementById('EnteredCases_input_@Model.Id');
            
            if (!caseDropdown) return;
            
            // Show Units display and hide the interactive quantity dropdown/input
            var unitsDisplay = document.getElementById('EnteredUnits_@Model.Id') || document.getElementById('EnteredUnits_input_@Model.Id');
            if (unitsDisplay) {
                unitsDisplay.textContent = caseSize.toString();
                unitsDisplay.style.display = 'block';
            }
            
            // Hide the interactive quantity controls
            if (qtyDropdown) {
                qtyDropdown.style.display = 'none';
            }
            if (qtyInput) {
                qtyInput.style.display = 'none';
            }
            
            // Get available quantities from the quantity dropdown/input
            var availableQuantities = [];
            if (qtyDropdown) {
                for (var i = 0; i < qtyDropdown.options.length; i++) {
                    availableQuantities.push(parseFloat(qtyDropdown.options[i].value));
                }
            } else if (qtyInput) {
                // For input, create reasonable case options based on case size
                var currentQty = parseFloat(qtyInput.value) || caseSize;
                for (var mult = 1; mult <= 10; mult++) {
                    availableQuantities.push(caseSize * mult);
                }
            }
            
            // Clear and populate case dropdown
            caseDropdown.innerHTML = '';
            availableQuantities.forEach(function(qty) {
                if (qty % caseSize === 0) { // Only show quantities that are exact multiples of case size
                    var cases = qty / caseSize;
                    var option = document.createElement('option');
                    option.value = cases;
                    option.textContent = cases.toString();
                    caseDropdown.appendChild(option);
                }
            });
            
            // Set current case value
            var currentQty = 1;
            if (qtyInput) {
                currentQty = parseFloat(qtyInput.value) || 1;
            } else if (qtyDropdown) {
                currentQty = parseFloat(qtyDropdown.value) || 1;
            }
            
            var currentCases = Math.round(currentQty / caseSize * 100) / 100;
            caseDropdown.value = currentCases;
            
            // Update total field and units display
            updateTotalField_@(Model.Id)(currentCases, currentQty);
        }
        
        function updateQuantityFromCases_@(Model.Id)(cases) {
            var caseSize = window['caseSize_@Model.Id'];
            if (!caseSize || caseSize <= 0) return;
            
            var newQuantity = parseFloat(cases) * caseSize;
            var qtyInput = document.getElementById('EnteredQuantity_@Model.Id');
            var qtyDropdown = document.querySelector('select[name="EnteredQuantity"][id="EnteredQuantity_@Model.Id"]');
            
            if (qtyInput) {
                qtyInput.value = newQuantity;
            } else if (qtyDropdown) {
                // Find the closest available quantity
                var bestMatch = null;
                var bestDiff = Infinity;
                for (var i = 0; i < qtyDropdown.options.length; i++) {
                    var optionValue = parseFloat(qtyDropdown.options[i].value);
                    var diff = Math.abs(optionValue - newQuantity);
                    if (diff < bestDiff) {
                        bestDiff = diff;
                        bestMatch = qtyDropdown.options[i].value;
                    }
                }
                if (bestMatch !== null) {
                    qtyDropdown.value = bestMatch;
                }
            }
            
            // Update total field
            var cases = parseFloat(newQuantity / caseSize).toFixed(2);
            updateTotalField_@(Model.Id)(cases, newQuantity);
            
            // Trigger attribute change to update prices, etc.
            if (typeof standardProductAttributes_@(Model.Id) !== 'undefined') {
                standardProductAttributes_@(Model.Id).attrchange();
            }
        }
        
        function updateTotalField_@(Model.Id)(cases, quantity) {
            var caseSize = window['caseSize_@Model.Id'];
            if (!caseSize || caseSize <= 0) return;
            
            // Update Units display (show units per case)
            var unitsDisplay = document.getElementById('EnteredUnits_@Model.Id') || document.getElementById('EnteredUnits_input_@Model.Id');
            if (unitsDisplay) {
                unitsDisplay.textContent = caseSize.toString();
            }
            
            // Update Total dropdown/input
            var totalDropdown = document.getElementById('EnteredTotal_@Model.Id') || document.getElementById('EnteredTotal_input_@Model.Id');
            
            if (totalDropdown) {
                // Total should be Cases × Units (caseSize)  
                // For example: 3 cases × 12 units per case = 36 total
                var correctTotal = parseFloat(cases) * caseSize;
                
                if (totalDropdown.tagName === 'SELECT') {
                    // For select element - populate with multiple total options
                    totalDropdown.innerHTML = '';
                    
                    // Get available cases from the cases dropdown
                    var casesDropdown = document.getElementById('EnteredCases_@Model.Id') || document.getElementById('EnteredCases_input_@Model.Id');
                    if (casesDropdown) {
                        for (var i = 0; i < casesDropdown.options.length; i++) {
                            var caseValue = parseFloat(casesDropdown.options[i].value);
                            var totalValue = caseValue * caseSize; // Cases × Units per case = Total
                            
                            var option = document.createElement('option');
                            option.value = totalValue;
                            option.textContent = totalValue.toString();
                            if (Math.abs(totalValue - correctTotal) < 0.01) { // Use small epsilon for floating point comparison
                                option.selected = true;
                            }
                            totalDropdown.appendChild(option);
                        }
                    }
                } else {
                    // For input element  
                    totalDropdown.value = correctTotal;
                }
            }
        }
        
        function updateQuantityFromTotal_@(Model.Id)(totalValue) {
            var caseSize = window['caseSize_@Model.Id'];
            if (!caseSize || caseSize <= 0) return;
            
            // Calculate cases from total: Total ÷ Units per case = Cases
            // For example: 36 total ÷ 12 units per case = 3 cases
            var cases = parseFloat(totalValue) / caseSize;
            
            // The main quantity field should represent the total quantity
            // This is what gets sent to the shopping cart
            var finalQuantity = parseFloat(totalValue);
            
            // Update Cases dropdown
            var casesDropdown = document.getElementById('EnteredCases_@Model.Id') || document.getElementById('EnteredCases_input_@Model.Id');
            if (casesDropdown) {
                casesDropdown.value = cases;
            }
            
            // Update Units dropdown/input - this should show the total quantity
            var qtyInput = document.getElementById('EnteredQuantity_@Model.Id');
            var qtyDropdown = document.querySelector('select[name="EnteredQuantity"][id="EnteredQuantity_@Model.Id"]');
            
            if (qtyInput) {
                qtyInput.value = finalQuantity;
            } else if (qtyDropdown) {
                // Find the closest available quantity
                var bestMatch = null;
                var bestDiff = Infinity;
                for (var i = 0; i < qtyDropdown.options.length; i++) {
                    var optionValue = parseFloat(qtyDropdown.options[i].value);
                    var diff = Math.abs(optionValue - finalQuantity);
                    if (diff < bestDiff) {
                        bestDiff = diff;
                        bestMatch = qtyDropdown.options[i].value;
                    }
                }
                if (bestMatch !== null) {
                    qtyDropdown.value = bestMatch;
                }
            }
            
            // Trigger attribute change to update prices, etc.
            if (typeof standardProductAttributes_@(Model.Id) !== 'undefined') {
                standardProductAttributes_@(Model.Id).attrchange();
            }
        }
