@using System.Text.Encodings.Web
@using Grand.Business.Core.Interfaces.Checkout.Orders
@using Grand.Business.Core.Interfaces.Customers
@using Grand.Domain.Payments
@using Grand.Domain.Tax
@using Constants = Grand.SharedUIResources.Constants
@model OrderModel
@inject IOrderTagService orderTagService
@inject ISalesEmployeeService _salesEmployeeService


<link rel="stylesheet" type="text/css" asp-src="@(Constants.WwwRoot)/administration/tagEditor/jquery.tag-editor.css"/>
<script asp-location="Footer" asp-src="@(Constants.WwwRoot)/administration/tagEditor/jquery.tag-editor.min.js"></script>
<script asp-location="Footer" asp-src="@(Constants.WwwRoot)/administration/tagEditor/jquery.caret.min.js"></script>

@{
    //tags
    var orderTags = await orderTagService.GetAllOrderTags();
    var orderTagsSB = new StringBuilder();
    orderTagsSB.Append("var initialOrderTags = [");
    for (var i = 0; i < orderTags.Count; i++)
    {
        var tag = orderTags[i];
        orderTagsSB.Append("'");
        orderTagsSB.Append(JavaScriptEncoder.Default.Encode(tag.Name));
        orderTagsSB.Append("'");
        if (i != orderTags.Count - 1)
        {
            orderTagsSB.Append(",");
        }
    }

    orderTagsSB.Append("]");
}

<script>
        $(document).ready(function() {
            toggleChangeOrderStatus(false);
            toggleOrderTotals(false);

            //tags
            @Html.Raw(orderTagsSB.ToString())
            $("#@Html.IdFor(model => model.OrderTags)").tagEditor({
                autocomplete: {
                    delay: 0,
                    position: { collision: 'flip' },
                    source: initialOrderTags
                },
                delimiter: ',',
                placeholder: 'Enter tags...'
            });
        });

        function toggleChangeOrderStatus(editmode) {
            if (editmode) {
                $('#pnlChangeOrderStatus').show();
                $('#btnChangeOrderStatus').hide();
            } else {
                $('#pnlChangeOrderStatus').hide();
                $('#btnChangeOrderStatus').show();
            }
        }

        function toggleOrderTotals(editmode) {
            if (editmode) {
                $('#trEditOrderTotals').show();
                $('#btnEditOrderTotals').hide();
                $('#btnSaveOrderTotals').show();
                $('#btnCancelOrderTotals').show();
            } else {
                $('#trEditOrderTotals').hide();
                $('#btnEditOrderTotals').show();
                $('#btnSaveOrderTotals').hide();
                $('#btnCancelOrderTotals').hide();
            }
        }

    </script>

<!-- Modern 3-column layout matching target design -->
<div class="stash-page-content">
    <vc:admin-widget widget-zone="order_details_info_top" additional-data="Model"/>
    
    <!-- 3-column info grid -->
    <div class="tw-grid tw-grid-cols-12 tw-gap-4 tw-mb-6">
        
        <!-- Seller Section -->
        <section class="tw-bg-white tw-rounded tw-p-4 tw-shadow tw-col-span-12 md:tw-col-span-6 lg:tw-col-span-3">
            <h2 class="tw-mb-3 tw-font-semibold tw-text-lg">Seller</h2>
            <div class="tw-flex-1">
                
                <div class="tw-mb-3">
                    <div class="heading-3 tw-mb-2">@Model.StoreName</div>
                </div>
                
                <!-- Customer Default Rep -->
                <div class="tw-mb-4">
                    <span class="tw-font-medium tw-text-gray-700">Customer Default Rep:</span><br/>
                    @Html.AntiForgeryToken()
                    <div class="tw-mt-2">
                        @{
                            var salesEmployees = await _salesEmployeeService.GetAll();
                            if (salesEmployees.Any())
                            {
                                <select name="salesEmployeeId" class="form-control tw-text-sm" id="salesEmployeeIdSelect">
                                    <option value="">@Loc["Admin.Common.Select"]</option>
                                    @foreach (var salesEmployee in salesEmployees)
                                    {
                                        if (Model.SalesEmployeeId == salesEmployee.Id)
                                        {
                                            <option value="@salesEmployee.Id" selected="selected">@salesEmployee.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@salesEmployee.Id">@salesEmployee.Name</option>
                                        }
                                    }
                                </select>
                                <div class="tw-mt-1">
                                    <button type="button" class="btn btn-sm btn-success" id="submitSalesEmployee">@Loc["Admin.Common.Save"]</button>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning tw-text-xs">
                                    No sales employees found.
                                </div>
                            }
                        }
                    </div>
                </div>
                
                <!-- Impersonation Info -->
                @if (!string.IsNullOrEmpty(Model.ImpersonatedByEmployeeId))
                {
                    <div class="tw-mb-4">
                        <span class="tw-font-medium tw-text-gray-700">Impersonated By:</span><br/>
                        <div class="tw-bg-yellow-100 tw-p-2 tw-rounded tw-text-sm tw-mt-1">
                            @if (!string.IsNullOrEmpty(Model.ImpersonatedByEmployeeName))
                            {
                                <a href="@Url.Action("Edit", "Customer", new { id = Model.ImpersonatedByEmployeeId })" class="tw-text-blue-600">@Model.ImpersonatedByEmployeeName</a>
                            }
                            else
                            {
                                <span>@Model.ImpersonatedByEmployeeId</span>
                            }
                        </div>
                    </div>
                }
                
                <!-- Payment Method -->
                <div class="tw-mb-2">
                    <span class="tw-font-medium tw-text-gray-700">Payment Method:</span><br/>
                    <span>@Model.PaymentMethod</span>
                </div>
                
            </div>
        </section>
        
        <!-- Buyer & Address Section -->
        <section class="tw-bg-white tw-rounded tw-p-4 tw-shadow tw-col-span-12 md:tw-col-span-6 lg:tw-col-span-3">
            <h2 class="tw-mb-3 tw-font-semibold tw-text-lg">Buyer & Delivery</h2>
            <div class="tw-flex-1">
                
                <div class="tw-mb-3">
                    <div class="heading-3 tw-mb-2">
                        @Html.ActionLink(Model.CustomerInfo, "Edit", "Customer", new { id = Model.CustomerId }, new { @class = "tw-text-blue-600 hover:tw-underline" })
                    </div>
                </div>
                
                <!-- Customer Details -->
                <div class="tw-mb-4">
                    <span class="tw-font-medium tw-text-gray-700">Customer IP:</span><br/>
                    <span>@Model.CustomerIp</span>
                </div>
                
                @if (!string.IsNullOrEmpty(Model.VatNumber))
                {
                    <div class="tw-mb-2">
                        <span class="tw-font-medium tw-text-gray-700">VAT Number:</span><br/>
                        <span>@Model.VatNumber</span>
                    </div>
                }
                
                <!-- Shipping & Delivery Addresses -->
                @{
                    bool addressesAreSame = false;
                    if (Model.BillingAddress != null && Model.ShippingAddress != null)
                    {
                        addressesAreSame = Model.BillingAddress.Address1 == Model.ShippingAddress.Address1 && 
                                         Model.BillingAddress.City == Model.ShippingAddress.City &&
                                         Model.BillingAddress.ZipPostalCode == Model.ShippingAddress.ZipPostalCode;
                    }
                }

                @if (addressesAreSame)
                {
                    <div class="tw-mb-4">
                        <span class="tw-font-medium tw-text-gray-700">Billing & Shipping Address:</span>
                        <div class="tw-bg-gray-100 tw-p-3 tw-rounded tw-mt-1 tw-border tw-border-gray-200">
                            @if (Model.BillingAddress != null)
                            {
                                <div class="tw-text-sm tw-text-gray-800">
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.FirstName) || !string.IsNullOrEmpty(Model.BillingAddress.LastName))
                                    {
                                        <div class="tw-font-semibold tw-text-gray-900">@Model.BillingAddress.FirstName @Model.BillingAddress.LastName</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.Company))
                                    {
                                        <div>@Model.BillingAddress.Company</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.Address1))
                                    {
                                        <div>@Model.BillingAddress.Address1</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.City))
                                    {
                                        <div>@Model.BillingAddress.City, @Model.BillingAddress.ZipPostalCode</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    @if (Model.ShippingAddress != null)
                    {
                        <div class="tw-mb-4">
                            <span class="tw-font-medium tw-text-gray-700">Shipping Address:</span>
                            <div class="tw-bg-blue-50 tw-p-3 tw-rounded tw-mt-1 tw-border tw-border-blue-100">
                                <div class="tw-text-sm tw-text-blue-900">
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.FirstName) || !string.IsNullOrEmpty(Model.ShippingAddress.LastName))
                                    {
                                        <div class="tw-font-semibold tw-text-gray-900">@Model.ShippingAddress.FirstName @Model.ShippingAddress.LastName</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.Company))
                                    {
                                        <div>@Model.ShippingAddress.Company</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.Address1))
                                    {
                                        <div>@Model.ShippingAddress.Address1</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.City))
                                    {
                                        <div>@Model.ShippingAddress.City, @Model.ShippingAddress.ZipPostalCode</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    
                    @if (Model.BillingAddress != null)
                    {
                        <div class="tw-mb-4">
                            <span class="tw-font-medium tw-text-gray-700">Billing Address:</span>
                            <div class="tw-bg-green-50 tw-p-3 tw-rounded tw-mt-1 tw-border tw-border-green-100">
                                <div class="tw-text-sm tw-text-green-900">
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.FirstName) || !string.IsNullOrEmpty(Model.BillingAddress.LastName))
                                    {
                                        <div class="tw-font-semibold tw-text-gray-900">@Model.BillingAddress.FirstName @Model.BillingAddress.LastName</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.Company))
                                    {
                                        <div>@Model.BillingAddress.Company</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.Address1))
                                    {
                                        <div>@Model.BillingAddress.Address1</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.City))
                                    {
                                        <div>@Model.BillingAddress.City, @Model.BillingAddress.ZipPostalCode</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }

                @if (Model.PickupAddress != null)
                {
                    <div class="tw-mb-4">
                        <span class="tw-font-medium tw-text-gray-700">Pickup Address:</span>
                        <div class="tw-bg-orange-50 tw-p-3 tw-rounded tw-mt-1 tw-border tw-border-orange-100">
                            <div class="tw-text-sm tw-text-orange-900">
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.FirstName) || !string.IsNullOrEmpty(Model.PickupAddress.LastName))
                                {
                                    <div class="tw-font-semibold tw-text-gray-900">@Model.PickupAddress.FirstName @Model.PickupAddress.LastName</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.Company))
                                {
                                    <div>@Model.PickupAddress.Company</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.Address1))
                                {
                                    <div>@Model.PickupAddress.Address1</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.City))
                                {
                                    <div>@Model.PickupAddress.City, @Model.PickupAddress.ZipPostalCode</div>
                                }
                            </div>
                        </div>
                    </div>
                }
                
            </div>
        </section>
        
        <!-- Order Information Section (spans 2 columns) -->
        <section class="tw-bg-white tw-rounded tw-p-4 tw-shadow tw-col-span-12 lg:tw-col-span-6">
            <div class="tw-mb-4">
                <h2 class="tw-font-semibold tw-text-lg tw-mb-0">Order Information</h2>
            </div>
            
            <div class="tw-grid tw-gap-3 tw-grid-cols-12">
                
                <!-- Order Details Column -->
                <div class="tw-col-span-6">
                    <div class="tw-mb-3 tw-font-medium">Order Details</div>
                    
                    <div class="tw-mb-2 tw-text-sm">
                        <span class="tw-font-medium tw-text-gray-700">Order number:</span> @Model.OrderNumber
                    </div>
                    
                    <div class="tw-mb-2 tw-text-sm">
                        <span class="tw-font-medium tw-text-gray-700">Order status:</span>
                        <div class="alert tw-inline-block tw-text-xs tw-px-2 tw-py-1 tw-ml-1 @Model.OrderStatus.ToLower()">@Model.OrderStatus</div>
                    </div>
                    
                    <div class="tw-mb-2 tw-text-sm">
                        <span class="tw-font-medium tw-text-gray-700">Order created:</span> @Html.DisplayFor(model => model.CreatedOn)
                    </div>
                    
                    <div class="tw-mb-2 tw-text-sm">
                        <span class="tw-font-medium tw-text-gray-700">Currency:</span> @Model.CurrencyCode
                        @if (Model.CurrencyRate != 1)
                        {
                            <text> (@Model.CurrencyRate)</text>
                        }
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.Code))
                    {
                        <div class="tw-mb-2 tw-text-sm">
                            <span class="tw-font-medium tw-text-gray-700">Code:</span> @Model.Code
                        </div>
                    }
                    
                </div>
                
                <!-- Payment Details Column -->
                <div class="tw-col-span-6">
                    <div class="tw-mb-3 tw-font-medium">Payment Details</div>
                    
                    <div class="tw-mb-2 tw-text-sm">
                        <span class="tw-font-medium tw-text-gray-700">Payment Status:</span>
                        @{
                            var labelStatus = "";
                            switch (Model.PaymentStatusEnum)
                            {
                                case PaymentStatus.Paid:
                                    labelStatus = "success";
                                    break;
                                case PaymentStatus.PartiallyPaid:
                                    labelStatus = "info";
                                    break;
                                case PaymentStatus.Pending:
                                    labelStatus = "default";
                                    break;
                                case PaymentStatus.Authorized:
                                    labelStatus = "info";
                                    break;
                                case PaymentStatus.PartiallyRefunded:
                                    labelStatus = "info";
                                    break;
                                case PaymentStatus.Refunded:
                                    labelStatus = "warning";
                                    break;
                                case PaymentStatus.Voided:
                                    labelStatus = "danger";
                                    break;
                            }
                        }
                        <div class="tw-mt-1">
                            <a class="btn btn-@labelStatus btn-sm" href="@Url.Action("Edit", "PaymentTransaction", new { id = Model.PaymentTransactionId, area = "Admin" })">
                                @Model.PaymentStatus
                            </a>
                        </div>
                    </div>
                    
                    <div class="tw-mb-2 tw-text-sm">
                        <span class="tw-font-medium tw-text-gray-700">Shipping Status:</span> @Model.ShippingStatus
                    </div>
                    
                    <div class="tw-mb-2 tw-text-sm">
                        <span class="tw-font-medium tw-text-gray-700">Order Total:</span> 
                        <span class="tw-font-bold">@Model.OrderTotal</span>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.RefundedAmount))
                    {
                        <div class="tw-mb-2 tw-text-sm">
                            <span class="tw-font-medium tw-text-gray-700">Refunded:</span> @Model.RefundedAmount
                        </div>
                    }
                    
                    <div class="tw-mb-2 tw-text-sm">
                        <span class="tw-font-medium tw-text-gray-700">Profit:</span> @Model.Profit
                    </div>
                    
                </div>
                
            </div>
        </section>
        
    </div>
<div class="form-group">
    <admin-label asp-for="OrderNumber" asp-display-hint="false" class="control-label col-3 col-md-3 col-sm-3"></admin-label>
    <div class="col-9 col-md-9 col-sm-9">
        <label class="control-label">@Model.OrderNumber</label>
    </div>
</div>

<div class="form-group order-status-block @Model.OrderStatus">
    <admin-label asp-for="OrderStatus" asp-display-hint="false" class="control-label col-12 col-md-3 col-sm-3 pt-2"></admin-label>
    <div class="col-12 col-md-9 col-sm-9 orderEditBtn">
        <div class="d-inline-flex w-100 align-items-center mb-3">
            <div class="alert mb-0">
                @Model.OrderStatus
            </div>&nbsp;&nbsp;&nbsp;&nbsp;
            @if (Model.CanCancelOrder)
            {
                <input type="submit" name="cancelorder" asp-action="CancelOrder" value="@Loc["Admin.Orders.Fields.OrderStatus.Cancel"]" id="cancelorder" class="btn red" onclick="return confirm('@Loc["Admin.Common.AreYouSure"]');"/>
            }
            <input type="submit" name="btnChangeOrderStatus" value="@Loc["Admin.Orders.Fields.OrderStatus.Change"]" onclick="toggleChangeOrderStatus(true);return false;" id="btnChangeOrderStatus" class="btn green"/>
        </div>
        <div id="pnlChangeOrderStatus">
            <div class="note note-info">@Loc["Admin.Orders.Fields.OrderStatus.Change.ForAdvancedUsers"]</div>
            <admin-select asp-for="OrderStatusId" asp-items="Model.OrderStatuses"/>
            <div class="form-actions btn-group btn-group-devided mt-3">
                <input type="submit" name="btnSaveOrderStatus" asp-action="ChangeOrderStatus" value="@Loc["Admin.Common.Save"]" id="btnSaveOrderStatus" class="k-button" onclick="return confirm('@Loc["Admin.Common.AreYouSure"]');"/>
                <input type="submit" name="btnCancelOrderStatus" value="@Loc["Admin.Common.Cancel"]" onclick="toggleChangeOrderStatus(false);return false;" id="btnCancelOrderStatus" class="k-button"/>
            </div>
        </div>
    </div>
</div>

<div class="form-group">
    <admin-label asp-for="ShippingStatus" asp-display-hint="false" class="control-label col-12 col-md-3 col-sm-3"></admin-label>
    <div class="col-12 col-md-9 col-sm-9">
        <label class="control-label">
            @Model.ShippingStatus
        </label>
    </div>
</div>


<div class="form-group" id="trEditOrderTags">
    <admin-label asp-for="OrderTags"/>
    <div class="col-md-9 col-sm-9">
        <span asp-validation-for="OrderTags"></span>
        <div class="input-group flex-nowrap w-100">
            <admin-input asp-for="OrderTags"/>
            <input type="submit" name="btnSaveOrderTags" asp-action="SaveOrderTags" value="@Loc["Admin.Orders.Fields.SaveOrderTags"]" id="btnSaveOrderTags" class="k-button" onclick=" return confirm('@Loc["Admin.Common.AreYouSure"]'); "/>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Code))
{
    <div class="form-group">
        <admin-label asp-for="Code" asp-display-hint="false" class="control-label col-3 col-md-3 col-sm-3"></admin-label>
        <div class="col-9 col-md-9 col-sm-9">
            <label class="control-label">@Model.Code</label>
        </div>
    </div>
}
<div class="form-group">
    <admin-label asp-for="CurrencyCode" asp-display-hint="false" class="control-label col-3 col-md-3 col-sm-3"></admin-label>
    <div class="col-9 col-md-9 col-sm-9">
        <label class="control-label">
            @Model.CurrencyCode
            @if (Model.CurrencyRate != 1)
            {
                <text>(@Model.CurrencyRate)</text>
            }
        </label>
    </div>
</div>

<div class="form-group">
    <admin-label asp-for="OrderGuid" asp-display-hint="false" class="control-label col-3 col-md-3 col-sm-3"></admin-label>
    <div class="col-9 col-md-9 col-sm-9">
        <label class="control-label">@Model.OrderGuid</label>
    </div>
</div>

<div class="form-group">
    <admin-label asp-for="StoreName" asp-display-hint="false" class="control-label col-3 col-md-3 col-sm-3"></admin-label>
    <div class="col-9 col-md-9 col-sm-9">
        <label class="control-label">@Model.StoreName</label>
    </div>
</div>

<div class="form-group">
    <admin-label asp-for="CustomerId" asp-display-hint="false" class="control-label col-3 col-md-3 col-sm-3"></admin-label>
    <div class="col-9 col-md-9 col-sm-9">
        <label class="control-label">
            @Html.ActionLink(Model.CustomerInfo, "Edit", "Customer", new { id = Model.CustomerId }, new { })
        </label>
    </div>
</div>
<div class="form-group">
    <admin-label asp-for="CustomerIp" asp-display-hint="false" class="control-label col-3 col-md-3 col-sm-3"></admin-label>
    <div class="col-9 col-md-9 col-sm-9">
        <label class="control-label">@Model.CustomerIp</label>
    </div>
</div>
<!-- Impersonation section - both for viewing and editing -->
<div class="form-group">
    <admin-label asp-for="ImpersonatedByEmployeeId" asp-display-hint="false" class="control-label col-3 col-md-3 col-sm-3"></admin-label>
    <div class="col-9 col-md-9 col-sm-9">
        @if (!string.IsNullOrEmpty(Model.ImpersonatedByEmployeeId))
        {
            <div class="d-flex align-items-center">
                <label class="control-label bg-warning text-dark p-1 rounded mr-2">
                    @if (!string.IsNullOrEmpty(Model.ImpersonatedByEmployeeName))
                    {
                        <a href="@Url.Action("Edit", "Customer", new { id = Model.ImpersonatedByEmployeeId })">@Model.ImpersonatedByEmployeeName</a>
                    }
                    else
                    {
                        <span>@Model.ImpersonatedByEmployeeId</span>
                    }
                </label>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnChangeImpersonation">
                    <i class="fa fa-pencil"></i> Change
                </button>
            </div>
        }
        else
        {
            <button type="button" class="btn btn-sm btn-outline-primary" id="btnChangeImpersonation">
                <i class="fa fa-user-plus"></i> Assign Impersonated Employee
            </button>
        }
        
        <div id="impersonationSelector" style="display: none; margin-top: 10px;">
            <div class="form-horizontal">
                <div class="form-body">
                    <div class="form-group">
                        <div class="col-md-12">
                            <div class="input-group">
                                <input type="text" id="impersonatedEmployeeIdSearch" class="form-control" placeholder="Search employee/customer..." />
                                <div class="input-group-append">
                                    <button type="button" id="searchImpersonatedEmployee" class="btn btn-info">
                                        <i class="fa fa-search"></i> Search
                                    </button>
                                </div>
                            </div>
                            <select name="impersonatedEmployeeId" class="form-control mt-2" id="impersonatedEmployeeIdSelect">
                                <option value="">@Loc["Admin.Common.Select"]</option>
                                @if (!string.IsNullOrEmpty(Model.ImpersonatedByEmployeeId) && !string.IsNullOrEmpty(Model.ImpersonatedByEmployeeName))
                                {
                                    <option value="@Model.ImpersonatedByEmployeeId" selected="selected">@Model.ImpersonatedByEmployeeName</option>
                                }
                            </select>
                            <div class="mt-2">
                                <button type="button" class="btn btn-sm btn-success" id="submitImpersonatedEmployee">@Loc["Admin.Common.Save"]</button>
                                <button type="button" class="btn btn-sm btn-secondary" id="cancelImpersonatedEmployee">@Loc["Admin.Common.Cancel"]</button>
                                @if (!string.IsNullOrEmpty(Model.ImpersonatedByEmployeeId))
                                {
                                    <button type="button" class="btn btn-sm btn-danger" id="removeImpersonatedEmployee">@Loc["Admin.Common.Remove"]</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <script>
            $(document).ready(function() {
                // Toggle the impersonation selector
                $("#btnChangeImpersonation").click(function() {
                    $("#impersonationSelector").toggle();
                });
                
                // Cancel button hides the selector
                $("#cancelImpersonatedEmployee").click(function() {
                    $("#impersonationSelector").hide();
                });
                
                // Customer search functionality
                $("#searchImpersonatedEmployee").click(function() {
                    var searchTerm = $("#impersonatedEmployeeIdSearch").val();
                    if (!searchTerm || searchTerm.trim() === '') {
                        alert("Please enter a search term");
                        return;
                    }
                    
                    // Show loading indicator
                    $(this).html('<i class="fa fa-spinner fa-spin"></i> Searching...');
                    $(this).prop('disabled', true);
                    
                    // Make AJAX call to search customers
                    $.ajax({
                        url: '@Url.Action("CustomerSearchAutoComplete", "Customer", new { area = "Admin" })',
                        type: 'GET',
                        data: {
                            term: searchTerm
                        },
                        success: function(data) {
                            // Reset search button
                            $("#searchImpersonatedEmployee").html('<i class="fa fa-search"></i> Search');
                            $("#searchImpersonatedEmployee").prop('disabled', false);
                            
                            // Clear previous options except for the default one and the currently selected one
                            var $select = $("#impersonatedEmployeeIdSelect");
                            var selectedValue = $select.val();
                            $select.find('option').not(':first').not('[value="' + selectedValue + '"]').remove();
                            
                            // Add new options from search results
                            if (data && data.length > 0) {
                                $.each(data, function(index, item) {
                                    // Skip if this item is already the selected one
                                    if (item.id !== selectedValue) {
                                        $select.append(new Option(item.label, item.id));
                                    }
                                });
                            } else {
                                alert("No customers found matching your search criteria");
                            }
                        },
                        error: function() {
                            // Reset search button
                            $("#searchImpersonatedEmployee").html('<i class="fa fa-search"></i> Search');
                            $("#searchImpersonatedEmployee").prop('disabled', false);
                            alert("Error searching for customers. Please try again.");
                        }
                    });
                });
                
                // Allow searching by pressing Enter key
                $("#impersonatedEmployeeIdSearch").keypress(function(e) {
                    if (e.which === 13) { // Enter key
                        e.preventDefault();
                        $("#searchImpersonatedEmployee").click();
                    }
                });
                
                // Handle save button click
                $("#submitImpersonatedEmployee").click(function() {
                    var orderId = '@Model.Id';
                    var impersonatedEmployeeId = $("#impersonatedEmployeeIdSelect").val();
                    
                    $.ajax({
                        url: '@Url.Action("SaveImpersonatedEmployee", "Order", new { area = "Admin" })',
                        type: 'POST',
                        data: {
                            id: orderId,
                            impersonatedEmployeeId: impersonatedEmployeeId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(result) {
                            if (result.success) {
                                // Reload the page to show updated information
                                location.reload();
                            } else {
                                alert(result.message || "Error saving impersonated employee");
                            }
                        },
                        error: function() {
                            alert("Error saving impersonated employee. Please try again.");
                        }
                    });
                });
                
                // Handle remove button click
                $("#removeImpersonatedEmployee").click(function() {
                    if (confirm("Are you sure you want to remove the impersonated employee?")) {
                        var orderId = '@Model.Id';
                        
                        $.ajax({
                            url: '@Url.Action("SaveImpersonatedEmployee", "Order", new { area = "Admin" })',
                            type: 'POST',
                            data: {
                                id: orderId,
                                impersonatedEmployeeId: "", // Empty string to remove
                                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function(result) {
                                if (result.success) {
                                    // Reload the page to show updated information
                                    location.reload();
                                } else {
                                    alert(result.message || "Error removing impersonated employee");
                                }
                            },
                            error: function() {
                                alert("Error removing impersonated employee. Please try again.");
                            }
                        });
                    }
                });
            });
                
                @if (!string.IsNullOrEmpty(Model.AffiliateId))
                {
                    <div class="tw-mb-2">
                        <span class="tw-font-medium tw-text-gray-700">Affiliate:</span><br/>
                        <a href="@Url.Action("Edit", "Affiliate", new { id = Model.AffiliateId, area = "Admin" })" class="tw-text-blue-600 hover:tw-underline">
