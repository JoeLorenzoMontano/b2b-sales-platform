@model ProductDetailsModel

@if (Model.ProductWarehouses.Any())
{
    <div id="product-warehouses" class="attributes">
        <table class="table">
            <tr>
                <td id="warehouse_label">
                    <span class="attribute-name">@Loc["Products.Warehouse"]</span><span class="required">*</span>
                </td>
                <td id="warehouse_input" style="width: 100%">
                    <select class="form-control custom-select w-100" name="WarehouseId" id="WarehouseId">
                        @foreach (var warehouse in Model.ProductWarehouses)
                        {
                            <option selected="@(warehouse.Selected)" value="@warehouse.WarehouseId">@(warehouse.Name)</option>
                        }
                    </select>
                </td>
            </tr>
        </table>
    </div>
    <script asp-location="Footer" asp-order="300">
        // Universal warehouse change handler that works with both attribute and non-attribute products
        function warehouse_change_handler() {
            // Always use the form-based approach to ensure all attributes are included if present
            var form = document.getElementById('@($"product-details-form-{Model.Id}")');
            var data = new FormData(form);
            
            // Ensure warehouse ID is included
            var warehouseId = document.getElementById('WarehouseId').value;
            if (data.has('WarehouseId')) {
                data.delete('WarehouseId');
            }
            data.append('WarehouseId', warehouseId);
            
            // Send the attribute change request which handles both attributes and warehouse changes
            axios({
                url: '@Html.Raw(Url.Action("productdetails_attributechange", "product", new { productId = Model.Id, loadPicture = true }))',
                data: data,
                method: 'post',
                params: { product: '@Model.Id' },
                }).then(function (response) {
                    // Update stock availability from the response
                    if (response.data.stockAvailability) {
                        if (document.getElementById('stock-availability-value-@Model.Id')) {
                            document.getElementById('stock-availability-value-@Model.Id').innerText = response.data.stockAvailability;
                        }
                    }
                    
                    // Also update other fields that might depend on warehouse + attributes
                    if (response.data.price) {
                        if (document.querySelector('.price-value-@Model.Id .actual-price'))
                            document.querySelector('.price-value-@Model.Id .actual-price').innerText = response.data.price;
                        else
                            document.querySelector('.price-value-@Model.Id').innerText = response.data.price;
                    }
                    
                    // Handle out of stock subscription
                    if (response.data.outOfStockSubscription) {
                        var element = document.querySelector('#out-of-stock-subscribe-@Model.Id');
                        if (element)
                            element.style.display = "block";
                    }
                    if (response.data.outOfStockSubscription == false) {
                        var element = document.querySelector('#out-of-stock-subscribe-@Model.Id');
                        if (element) {
                            element.style.display = "none";
                        }
                    }
                });
            }
        }
        
        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById('WarehouseId').addEventListener('change', function () {
                warehouse_change_handler();
            });
            
            // Initial load - wait a moment to ensure all attributes are initialized
            setTimeout(function() {
                warehouse_change_handler();
            }, 100);
        });
    </script>
}