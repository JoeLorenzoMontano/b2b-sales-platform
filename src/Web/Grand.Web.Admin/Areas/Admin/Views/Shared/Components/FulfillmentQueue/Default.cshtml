@inject AdminAreaSettings adminAreaSettings

<div id="fulfillment-queue-grid"></div>

<script>
    $(document).ready(function () {
        $("#fulfillment-queue-grid").kendoGrid({
                dataSource: {
                    transport: {
                        read: {
                            url: "@Html.Raw(Url.Action("OrderList", "Order", new { area = Constants.AreaAdmin }))",
                            type: "POST",
                            dataType: "json",
                            data: additionalData
                        }
                    },
                    schema: {
                        data: "Data",
                        total: "Total",
                        errors: "Errors"
                    },
                    error: function(e) {
                        display_kendoui_grid_error(e);
                        // Cancel the changes
                        this.cancelChanges();
                    },
                    pageSize: 5,
                    serverPaging: true,
                    serverFiltering: true,
                    serverSorting: true
                },
                pageable: {
                    refresh: true,
                    pageSizes: [5,10,15]
                },
                editable: {
                    confirmation: false,
                    mode: "inline"
                },
                scrollable: false,
                columns: [
                    {
                        field: "OrderNumber",
                        title: "@Loc["Admin.Orders.Fields.Id"]",
                        width: 50,
                        template: '<a class="k-link" href="Admin/Order/Edit/#=Id#">#=OrderNumber#</a>',
                    },
                    {
                        field: "CustomerEmail",
                        title: "@Loc["Admin.Orders.Fields.Customer"]",
                        width: 200,
                        template: '<a class="k-link" href="@Url.Action("Edit", "Customer", new { area = Constants.AreaAdmin })/#=CustomerId#">#=CustomerFullName# (#=CustomerEmail#)</a>'                        
                    },
                    @if (!adminAreaSettings.HideStoreColumn)
                    {
                        <text>
                        {
                            field: "StoreName",
                            title: "@Loc["Admin.Orders.Fields.Store"]",
                            width: 120,
                            headerAttributes: { style: "text-align:center" },
                            attributes: { style: "text-align:center" },
                        },
                        </text>
                    }
                    {
                        field: "ShippingStatus",
                        title: "@Loc["Admin.Orders.Fields.ShippingStatus"]",
                        width: 120,
                        headerAttributes: { style: "text-align:center" },
                        attributes: { style: "text-align:center" },
                    },
                    {
                        field: "TargetDeliveryDate",
                        title: "@Loc["Admin.Orders.Fulfillment.TargetDeliveryDate"]",
                        width: 150,
                        type: "date",
                        format: "{0:G}",
                        headerAttributes: { style: "text-align:center" },
                        attributes: { style: "text-align:center" },
                    },
                    {
                        field: "CreatedOn",
                        title: "@Loc["Admin.Orders.Fields.CreatedOn"]",
                        width: 120,
                        type: "date",
                        format: "{0:G}",
                        headerAttributes: { style: "text-align:center" },
                        attributes: { style: "text-align:center" },
                    }
                ]
            });


        function additionalData() {
            var data = {
                startdate: $('#dashboard-report-range').data('daterangepicker').startDate.format('YYYY-MM-DD'),
                endDate: $('#dashboard-report-range').data('daterangepicker').endDate.format('YYYY-MM-DD'),
                ShippingStatusId: 10, // Filter for orders with pending shipments (shipping status = 10)
                OrderStatusId: 20 // Filter for processing orders
            };
            addAntiForgeryToken(data);
            return data;
        }
        
        // Add a link to Order List with filter for pending fulfillment
        var titleBar = $(".x_title").last();
        titleBar.append('<div class="pull-right"><a href="@Url.Action("List", "Order", new { ShippingStatusId = 10, OrderStatusId = 20, area = Constants.AreaAdmin })" class="btn btn-info">@Loc["Admin.Orders.BtnAllFulfillmentQueue"]</a></div>');
    });
</script>