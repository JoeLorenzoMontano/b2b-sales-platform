@model CatalogProductsModel
@inject IPageHeadBuilder pagebuilder
@{
    Layout = "_TwoColumns";
    
    //title
    pagebuilder.AddTitleParts(Loc["Catalog.BatchOrder"]);
}

<div class="page batch-order-page">
    <h1 class="h2 generalTitle">@Loc["Catalog.BatchOrder"]</h1>
    
    @await Component.InvokeAsync("Widget", new { widgetZone = "batch_order_top" })

    <div id="catalog-products">
        @await Component.InvokeAsync("Widget", new { widgetZone = "batchorder_before_filters" })
        <partial name="Partials/Selectors"/>
        <template v-if="catalog.Model.Products.length > 0">
            <div class="catalog-selectors mb-3">
                <p class="batch-order-info">@Loc["Catalog.BatchOrderInfo"]</p>
            </div>
            <div class="batch-order-products row">
                <div class="col-lg-4 col-sm-6 col-6 product-container mb-2" v-for="product in catalog.Model.Products" :key="product.Id">
                    <div class="card h-100 product-box">
                        <div class="picture-container">
                            <a class="img-container" :href="'/' + product.SeName" :title="product.Name">
                                <img class="img-fluid main-product-img" :src="product.DefaultPictureModel.ImageUrl" :alt="product.DefaultPictureModel.AlternateText" :title="product.DefaultPictureModel.Title" />
                            </a>
                        </div>
                        <div class="card-body">
                            <div class="card-title h3 mb-0">
                                <a :href="'/' + product.SeName">
                                    {{product.Name}}
                                </a>
                            </div>
                            <div class="sku mb-1" v-if="product.ShowSku && product.Sku">
                                <span class="label">@Loc["Products.Sku"]:</span>
                                <span class="value">{{product.Sku}}</span>
                            </div>
                            <div class="prices mb-2">
                                <template v-if="product.ProductPrice.Price">
                                    <div class="product-price">
                                        <template v-if="product.ProductPrice.OldPrice != null">
                                            <span class="price old-price text-muted text-decoration-line-through">{{product.ProductPrice.OldPrice}}</span>
                                        </template>
                                        <span class="price actual-price">{{product.ProductPrice.Price}}</span>
                                    </div>
                                </template>
                            </div>
                            <div class="batch-order-controls">
                                <div class="row">
                                    <div class="col-6">
                                        <div class="quantity-input">
                                            <input type="number" :id="'qty-' + product.Id" min="1" class="form-control qty-input text-center" value="1">
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div v-if="product.ProductAttributeMappings && product.ProductAttributeMappings.length > 0" class="product-attributes-badge">
                                            <span class="badge badge-info">@Loc["Products.Attributes"]</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="btn-group d-flex">
                                <template v-if="product.ProductAttributeMappings && product.ProductAttributeMappings.length > 0">
                                    <a :href="'/' + product.SeName" class="btn btn-info view-details w-100">
                                        <span>@Loc["Products.SelectAttributes"]</span>
                                    </a>
                                </template>
                                <template v-else>
                                    <button type="button" class="btn btn-info view-details add-to-cart-button w-100" 
                                        :onclick="'AxiosCart.addproducttocart_catalog(\\'' + '@Url.RouteUrl("AddProductCatalog")/' + product.Id + '/1\\', true, \\'' + product.Id + '\\');return false;'">
                                        <span>@Loc["ShoppingCart.AddToCart"]</span>
                                    </button>
                                </template>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <partial name="Partials/Pagination"/>
        </template>
        <template v-else>
            <div class="alert alert-info my-3">
                @Loc["Catalog.Products.NoData"]
            </div>
        </template>
        @await Component.InvokeAsync("Widget", new { widgetZone = "batchorder_after_filters" })
    </div>
    
    @await Component.InvokeAsync("Widget", new { widgetZone = "batch_order_bottom" })
</div>

@section filters
{
    @*Rendering filtering section*@
    @if (Model.PagingFilteringContext.SpecificationFilter.Enabled)
    {
        <partial name="Partials/Filtering"/>
    }
}

<partial name="Partials/ModelScript" model="@Json.Serialize(Model)"/>