@model double?
<input asp-for="@Model" value="@(Model.HasValue ? Model.Value.ToString("0.00") : "")" />
<script>
    $(document).ready(function () {
        $("#@Html.IdForModel()").kendoNumericTextBox({
           culture: "@CultureInfo.CurrentCulture.Name",
           format: 'n2',
           decimals: 2,
           nullable: true
        });
    });
</script>