@using System.Text.Encodings.Web
@using Grand.Business.Core.Interfaces.Checkout.Orders
@using Grand.Business.Core.Interfaces.Customers
@using Grand.Domain.Payments
@using Grand.Domain.Tax
@using Constants = Grand.SharedUIResources.Constants
@model OrderModel
@inject IOrderTagService orderTagService
@inject ISalesEmployeeService _salesEmployeeService

@{
    var salesEmployees = await _salesEmployeeService.GetAll();
}

<link rel="stylesheet" type="text/css" asp-src="@(Constants.WwwRoot)/administration/tagEditor/jquery.tag-editor.css"/>
<script asp-location="Footer" asp-src="@(Constants.WwwRoot)/administration/tagEditor/jquery.tag-editor.min.js"></script>
<script asp-location="Footer" asp-src="@(Constants.WwwRoot)/administration/tagEditor/jquery.caret.min.js"></script>

@{
    var orderTagsSB = new System.Text.StringBuilder();
    if (Model.OrderTags?.Any() == true)
    {
        orderTagsSB.AppendLine("var initialOrderTags = [");
        foreach (var tag in Model.OrderTags)
        {
            var safeTag = tag.ToString().Replace("'", "\\'");
            orderTagsSB.AppendLine($"'{safeTag}',");
        }
        orderTagsSB.AppendLine("];");
    }
    else
    {
        orderTagsSB.AppendLine("var initialOrderTags = [];");
    }
}

<!-- Clean 3-Column Bootstrap Layout -->
<div class="container-fluid">
    <div class="row">
        <!-- Seller Section -->
        <div class="col-lg-4 col-md-6 col-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Seller</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6>@Model.StoreName</h6>
                    </div>
                    
                    <!-- Sales Employee -->
                    <div class="mb-3">
                        <label class="form-label"><strong>Customer Default Rep:</strong></label>
                        <select name="salesEmployeeId" class="form-control" id="salesEmployeeIdSelect">
                            <option value="">Select</option>
                            @foreach (var salesEmployee in salesEmployees)
                            {
                                if (salesEmployee.Id == Model.SalesEmployeeId)
                                {
                                    <option value="@salesEmployee.Id" selected="selected">@salesEmployee.Name</option>
                                }
                                else
                                {
                                    <option value="@salesEmployee.Id">@salesEmployee.Name</option>
                                }
                            }
                        </select>
                        <button type="button" class="btn btn-sm btn-success mt-2" id="submitSalesEmployee">Save</button>
                    </div>
                    
                    <!-- Impersonation -->
                    @if (!string.IsNullOrEmpty(Model.ImpersonatedByEmployeeId))
                    {
                        <div class="mb-3">
                            <label class="form-label"><strong>Impersonated By:</strong></label>
                            <div>
                                @if (!string.IsNullOrEmpty(Model.ImpersonatedByEmployeeName))
                                {
                                    <a href="@Url.Action("Edit", "Customer", new { id = Model.ImpersonatedByEmployeeId })" class="text-primary">@Model.ImpersonatedByEmployeeName</a>
                                }
                                else
                                {
                                    <span>@Model.ImpersonatedByEmployeeId</span>
                                }
                            </div>
                        </div>
                    }
                    
                    <!-- Payment Method -->
                    <div class="mb-2">
                        <label class="form-label"><strong>Payment Method:</strong></label>
                        <div>@Model.PaymentMethod</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Buyer & Delivery Section -->
        <div class="col-lg-4 col-md-6 col-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Buyer & Delivery</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        @Html.ActionLink(Model.CustomerInfo, "Edit", "Customer", new { id = Model.CustomerId }, new { @class = "text-primary" })
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label"><strong>Customer IP:</strong></label>
                        <div>@Model.CustomerIp</div>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.VatNumber))
                    {
                        <div class="mb-3">
                            <label class="form-label"><strong>VAT Number:</strong></label>
                            <div>@Model.VatNumber</div>
                        </div>
                    }
                    
                    <!-- Address Information -->
                    @{
                        var addressesAreSame = Model.BillingAddress != null && Model.ShippingAddress != null &&
                                               Model.BillingAddress.FirstName == Model.ShippingAddress.FirstName &&
                                               Model.BillingAddress.LastName == Model.ShippingAddress.LastName &&
                                               Model.BillingAddress.Address1 == Model.ShippingAddress.Address1 &&
                                               Model.BillingAddress.City == Model.ShippingAddress.City;
                    }
                    
                    @if (addressesAreSame && Model.BillingAddress != null)
                    {
                        <div class="mb-3">
                            <label class="form-label"><strong>Billing & Shipping Address:</strong></label>
                            <div class="border p-2 bg-light">
                                @if (!string.IsNullOrEmpty(Model.BillingAddress.FirstName) || !string.IsNullOrEmpty(Model.BillingAddress.LastName))
                                {
                                    <div><strong>@Model.BillingAddress.FirstName @Model.BillingAddress.LastName</strong></div>
                                }
                                @if (!string.IsNullOrEmpty(Model.BillingAddress.Company))
                                {
                                    <div>@Model.BillingAddress.Company</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.BillingAddress.Address1))
                                {
                                    <div>@Model.BillingAddress.Address1</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.BillingAddress.City))
                                {
                                    <div>@Model.BillingAddress.City, @Model.BillingAddress.ZipPostalCode</div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (Model.ShippingAddress != null)
                        {
                            <div class="mb-3">
                                <label class="form-label"><strong>Shipping Address:</strong></label>
                                <div class="border p-2" style="background-color: #e3f2fd;">
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.FirstName) || !string.IsNullOrEmpty(Model.ShippingAddress.LastName))
                                    {
                                        <div><strong>@Model.ShippingAddress.FirstName @Model.ShippingAddress.LastName</strong></div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.Company))
                                    {
                                        <div>@Model.ShippingAddress.Company</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.Address1))
                                    {
                                        <div>@Model.ShippingAddress.Address1</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.City))
                                    {
                                        <div>@Model.ShippingAddress.City, @Model.ShippingAddress.ZipPostalCode</div>
                                    }
                                </div>
                            </div>
                        }
                        
                        @if (Model.BillingAddress != null)
                        {
                            <div class="mb-3">
                                <label class="form-label"><strong>Billing Address:</strong></label>
                                <div class="border p-2" style="background-color: #e8f5e8;">
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.FirstName) || !string.IsNullOrEmpty(Model.BillingAddress.LastName))
                                    {
                                        <div><strong>@Model.BillingAddress.FirstName @Model.BillingAddress.LastName</strong></div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.Company))
                                    {
                                        <div>@Model.BillingAddress.Company</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.Address1))
                                    {
                                        <div>@Model.BillingAddress.Address1</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.City))
                                    {
                                        <div>@Model.BillingAddress.City, @Model.BillingAddress.ZipPostalCode</div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    
                    @if (Model.PickupAddress != null)
                    {
                        <div class="mb-3">
                            <label class="form-label"><strong>Pickup Address:</strong></label>
                            <div class="border p-2" style="background-color: #fff3cd;">
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.FirstName) || !string.IsNullOrEmpty(Model.PickupAddress.LastName))
                                {
                                    <div><strong>@Model.PickupAddress.FirstName @Model.PickupAddress.LastName</strong></div>
                                }
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.Company))
                                {
                                    <div>@Model.PickupAddress.Company</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.Address1))
                                {
                                    <div>@Model.PickupAddress.Address1</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.City))
                                {
                                    <div>@Model.PickupAddress.City, @Model.PickupAddress.ZipPostalCode</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <!-- Order Information Section -->
        <div class="col-lg-4 col-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Order Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Order number:</strong></label>
                            <div>@Model.OrderNumber</div>
                        </div>
                        
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Order status:</strong></label>
                            <div><span class="badge badge-warning">@Model.OrderStatus</span></div>
                        </div>
                        
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Order created:</strong></label>
                            <div>@Html.DisplayFor(model => model.CreatedOn)</div>
                        </div>
                        
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Currency:</strong></label>
                            <div>@Model.CurrencyCode @if (Model.CurrencyRate != 1) { <text>(@Model.CurrencyRate)</text> }</div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(Model.Code))
                        {
                            <div class="col-12 mb-3">
                                <label class="form-label"><strong>Code:</strong></label>
                                <div>@Model.Code</div>
                            </div>
                        }
                        
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Payment Status:</strong></label>
                            <div>
                                @{
                                    string labelStatus = "secondary";
                                    switch (Model.PaymentStatus.ToLower())
                                    {
                                        case "paid":
                                            labelStatus = "success";
                                            break;
                                        case "pending":
                                            labelStatus = "warning";
                                            break;
                                        case "cancelled":
                                        case "refunded":
                                            labelStatus = "danger";
                                            break;
                                    }
                                }
                                <a class="btn btn-@labelStatus btn-sm" href="@Url.Action("Edit", "PaymentTransaction", new { id = Model.PaymentTransactionId })">
                                    @Model.PaymentStatus
                                </a>
                            </div>
                        </div>
                        
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Shipping Status:</strong></label>
                            <div>@Model.ShippingStatus</div>
                        </div>
                        
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Order Total:</strong></label>
                            <div><strong>@Model.OrderTotal</strong></div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(Model.RefundedAmount))
                        {
                            <div class="col-12 mb-3">
                                <label class="form-label"><strong>Refunded:</strong></label>
                                <div>@Model.RefundedAmount</div>
                            </div>
                        }
                        
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Profit:</strong></label>
                            <div>@Model.Profit</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Products Section -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Order Products (@Model.Items.Count items)</h5>
                    <button class="btn btn-sm btn-outline-primary" type="button" data-toggle="collapse" data-target="#productsCollapse">
                        <i class="fa fa-chevron-down"></i> Toggle
                    </button>
                </div>
                <div class="collapse show" id="productsCollapse">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Product</th>
                                        <th>SKU</th>
                                        <th class="text-center">Quantity</th>
                                        <th class="text-right">Price</th>
                                        <th class="text-right">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < Model.Items.Count; i++)
                                    {
                                        var item = Model.Items[i];
                                        <tr>
                                            <td>@(i + 1)</td>
                                            <td>
                                                <a href="@Url.Action("Edit", "Product", new { id = item.ProductId })" class="text-primary">
                                                    @item.ProductName
                                                </a>
                                                @if (!string.IsNullOrEmpty(item.WarehouseName))
                                                {
                                                    <br><small class="text-muted">Warehouse: @item.WarehouseName</small>
                                                }
                                            </td>
                                            <td>@item.Sku</td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-right">@item.UnitPriceExclTax</td>
                                            <td class="text-right">
                                                @switch (Model.TaxDisplayType)
                                                {
                                                    case TaxDisplayType.ExcludingTax:
                                                        @item.SubTotalExclTax
                                                        break;
                                                    case TaxDisplayType.IncludingTax:
                                                        @item.SubTotalInclTax
                                                        break;
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-info">
                                        <th colspan="3">Total</th>
                                        <th class="text-center">@Model.Items.Sum(x => x.Quantity)</th>
                                        <th></th>
                                        <th class="text-right">@Model.OrderTotal</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        
                        <!-- Order Summary -->
                        <div class="row mt-4">
                            <div class="col-lg-6 offset-lg-6">
                                <div class="card">
                                    <div class="card-body">
                                        @if (Model.TaxDisplayType == TaxDisplayType.IncludingTax)
                                        {
                                            <div class="d-flex justify-content-between">
                                                <span>Subtotal:</span>
                                                <span>@Model.OrderSubtotalInclTax</span>
                                            </div>
                                        }
                                        @if (Model.TaxDisplayType == TaxDisplayType.ExcludingTax)
                                        {
                                            <div class="d-flex justify-content-between">
                                                <span>Subtotal:</span>
                                                <span>@Model.OrderSubtotalExclTax</span>
                                            </div>
                                        }
                                        @if (Model.TaxDisplayType == TaxDisplayType.IncludingTax)
                                        {
                                            <div class="d-flex justify-content-between">
                                                <span>Shipping:</span>
                                                <span>@Model.OrderShippingInclTax</span>
                                            </div>
                                        }
                                        @if (Model.TaxDisplayType == TaxDisplayType.ExcludingTax)
                                        {
                                            <div class="d-flex justify-content-between">
                                                <span>Shipping:</span>
                                                <span>@Model.OrderShippingExclTax</span>
                                            </div>
                                        }
                                        @if (Model.DisplayTax)
                                        {
                                            <div class="d-flex justify-content-between">
                                                <span>Tax:</span>
                                                <span>@Model.Tax</span>
                                            </div>
                                        }
                                        <hr>
                                        <div class="d-flex justify-content-between font-weight-bold">
                                            <span>Total:</span>
                                            <span>@Model.OrderTotal</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    // Initialize order tags
    @Html.Raw(orderTagsSB.ToString())
    $("#OrderTags").tagEditor({
        autocomplete: {
            delay: 0,
            position: { collision: 'flip' },
            source: initialOrderTags
        },
        delimiter: ',',
        placeholder: 'Enter tags...'
    });

    // Sales employee functionality
    $("#salesEmployeeIdSelect").change(function() {
        $("#submitSalesEmployee").removeClass("btn-success").addClass("btn-primary");
    });
    
    $("#submitSalesEmployee").click(function(e) {
        e.preventDefault();
        
        var orderId = '@Model.Id';
        var salesEmployeeId = $("#salesEmployeeIdSelect").val();
        
        $.ajax({
            url: '@Url.Action("SaveSalesEmployee", "Order", new { area = "Admin" })',
            type: 'POST',
            data: {
                id: orderId,
                salesEmployeeId: salesEmployeeId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(result) {
                if (result.success) {
                    $("#submitSalesEmployee").removeClass("btn-primary").addClass("btn-success");
                    showSuccessMessage("Sales representative updated successfully");
                } else {
                    showErrorMessage(result.message || "Error saving sales employee");
                }
            },
            error: function() {
                showErrorMessage("Error saving sales employee. Please try again.");
            }
        });
    });
    
    // Toggle products collapse
    $('#productsCollapse').on('show.bs.collapse', function () {
        $(this).prev().find('i').removeClass('fa-chevron-down').addClass('fa-chevron-up');
    });
    
    $('#productsCollapse').on('hide.bs.collapse', function () {
        $(this).prev().find('i').removeClass('fa-chevron-up').addClass('fa-chevron-down');
    });
});

function showSuccessMessage(message) {
    var alert = $('<div class="alert alert-success alert-dismissible fade show mt-2" role="alert">' + 
                  message + 
                  '<button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>' +
                  '</div>');
    $("#salesEmployeeIdSelect").after(alert);
    setTimeout(function() {
        alert.fadeOut();
    }, 3000);
}

function showErrorMessage(message) {
    var alert = $('<div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">' + 
                  message + 
                  '<button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>' +
                  '</div>');
    $("#salesEmployeeIdSelect").after(alert);
    setTimeout(function() {
        alert.fadeOut();
    }, 5000);
}

function toggleChangeOrderStatus(editmode) {
    if (editmode) {
        $('#pnlChangeOrderStatus').show();
        $('#btnChangeOrderStatus').hide();
    } else {
        $('#pnlChangeOrderStatus').hide();
        $('#btnChangeOrderStatus').show();
    }
}

function toggleOrderTotals(editmode) {
    if (editmode) {
        $('#trEditOrderTotals').show();
        $('#btnEditOrderTotals').hide();
        $('#btnSaveOrderTotals').show();
        $('#btnCancelOrderTotals').show();
    } else {
        $('#trEditOrderTotals').hide();
        $('#btnEditOrderTotals').show();
        $('#btnSaveOrderTotals').hide();
        $('#btnCancelOrderTotals').hide();
    }
}
</script>