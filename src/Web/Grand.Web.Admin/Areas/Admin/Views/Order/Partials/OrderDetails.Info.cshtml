@using System.Text.Encodings.Web
@using Grand.Business.Core.Interfaces.Checkout.Orders
@using Grand.Business.Core.Interfaces.Customers
@using Grand.Domain.Payments
@using Grand.Domain.Tax
@using Constants = Grand.SharedUIResources.Constants
@model OrderModel
@inject IOrderTagService orderTagService
@inject ISalesEmployeeService _salesEmployeeService

@{
    var salesEmployees = await _salesEmployeeService.GetAll();
}

<link rel="stylesheet" type="text/css" asp-src="@(Constants.WwwRoot)/administration/tagEditor/jquery.tag-editor.css"/>
<script asp-location="Footer" asp-src="@(Constants.WwwRoot)/administration/tagEditor/jquery.tag-editor.min.js"></script>
<script asp-location="Footer" asp-src="@(Constants.WwwRoot)/administration/tagEditor/jquery.caret.min.js"></script>

@{
    var orderTagsSB = new System.Text.StringBuilder();
    if (Model.OrderTags?.Any() == true)
    {
        orderTagsSB.AppendLine("var initialOrderTags = [");
        foreach (var tag in Model.OrderTags)
        {
            var safeTag = tag.ToString().Replace("'", "\\'");
            orderTagsSB.AppendLine($"'{safeTag}',");
        }
        orderTagsSB.AppendLine("];");
    }
    else
    {
        orderTagsSB.AppendLine("var initialOrderTags = [];");
    }
}

<!-- Clean 3-Column Bootstrap Layout -->
<div class="container-fluid">
    <div class="row">
        <!-- Seller Section -->
        <div class="col-lg-4 col-md-6 col-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Seller</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6>@Model.StoreName</h6>
                    </div>
                    
                    <!-- Sales Employee -->
                    <div class="mb-3">
                        <label class="form-label"><strong>Customer Default Rep:</strong></label>
                        <select name="salesEmployeeId" class="form-control" id="salesEmployeeIdSelect">
                            <option value="">Select</option>
                            @foreach (var salesEmployee in salesEmployees)
                            {
                                if (salesEmployee.Id == Model.SalesEmployeeId)
                                {
                                    <option value="@salesEmployee.Id" selected="selected">@salesEmployee.Name</option>
                                }
                                else
                                {
                                    <option value="@salesEmployee.Id">@salesEmployee.Name</option>
                                }
                            }
                        </select>
                        <button type="button" class="btn btn-sm btn-success mt-2" id="submitSalesEmployee">Save</button>
                    </div>
                    
                    <!-- Impersonation -->
                    @if (!string.IsNullOrEmpty(Model.ImpersonatedByEmployeeId))
                    {
                        <div class="mb-3">
                            <label class="form-label"><strong>Impersonated By:</strong></label>
                            <div>
                                @if (!string.IsNullOrEmpty(Model.ImpersonatedByEmployeeName))
                                {
                                    <a href="@Url.Action("Edit", "Customer", new { id = Model.ImpersonatedByEmployeeId })" class="text-primary">@Model.ImpersonatedByEmployeeName</a>
                                }
                                else
                                {
                                    <span>@Model.ImpersonatedByEmployeeId</span>
                                }
                            </div>
                        </div>
                    }
                    
                    <!-- Payment Method -->
                    <div class="mb-2">
                        <label class="form-label"><strong>Payment Method:</strong></label>
                        <div>@Model.PaymentMethod</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Buyer & Delivery Section -->
        <div class="col-lg-4 col-md-6 col-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Buyer & Delivery</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        @Html.ActionLink(Model.CustomerInfo, "Edit", "Customer", new { id = Model.CustomerId }, new { @class = "text-primary" })
                    </div>
                    
                    
                    @if (!string.IsNullOrEmpty(Model.VatNumber))
                    {
                        <div class="mb-3">
                            <label class="form-label"><strong>VAT Number:</strong></label>
                            <div>@Model.VatNumber</div>
                        </div>
                    }
                    
                    <!-- Moved from Order Information column -->
                    <div class="mb-3">
                        <label class="form-label"><strong>Payment Status:</strong></label>
                        <div>
                            @{
                                string labelStatus = "secondary";
                                switch (Model.PaymentStatus.ToLower())
                                {
                                    case "paid":
                                        labelStatus = "success";
                                        break;
                                    case "pending":
                                        labelStatus = "warning";
                                        break;
                                    case "cancelled":
                                    case "refunded":
                                        labelStatus = "danger";
                                        break;
                                }
                            }
                            @if (string.IsNullOrEmpty(Model.PaymentTransactionId))
                            {
                                <a class="btn btn-primary btn-sm" href="@Url.Action("CreatePaymentTransaction", "Order", new { id = Model.Id })">
                                    <i class="fa fa-plus"></i> Create Payment
                                </a>
                            }
                            else
                            {
                                <a class="btn btn-@labelStatus btn-sm" href="@Url.Action("Edit", "PaymentTransaction", new { id = Model.PaymentTransactionId })">
                                    @Model.PaymentStatus
                                </a>
                            }
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label"><strong>Shipping Status:</strong></label>
                        <div>
                            @{
                                string shippingLabelStatus = "secondary";
                                switch (Model.ShippingStatus.ToLower())
                                {
                                    case "shipped":
                                    case "delivered":
                                        shippingLabelStatus = "success";
                                        break;
                                    case "not yet shipped":
                                    case "processing":
                                        shippingLabelStatus = "warning";
                                        break;
                                    case "returned":
                                        shippingLabelStatus = "danger";
                                        break;
                                }

                                // Determine shipment tab index (Info=0, Addresses=1, Shipments=2 if shippable, otherwise Products=2)
                                var shipmentTabIndex = Model.IsShippable ? 2 : -1;
                            }
                            @if (Model.IsShippable && Model.CanAddNewShipments)
                            {
                                <a class="btn btn-primary btn-sm" href="@Url.Action("AddShipment", "Shipment", new { orderId = Model.Id })">
                                    <i class="fa fa-plus"></i> Create Shipment
                                </a>
                            }
                            else if (Model.IsShippable)
                            {
                                <a class="btn btn-@shippingLabelStatus btn-sm" href="#" onclick="$('a[href=\'#tab-@shipmentTabIndex\']').click(); return false;">
                                    @Model.ShippingStatus
                                </a>
                            }
                            else
                            {
                                <span class="badge badge-@shippingLabelStatus">@Model.ShippingStatus</span>
                            }
                        </div>
                    </div>

                    <!-- Customer Requested Shipment Date (always visible for shippable orders) -->
                    @if (Model.IsShippable)
                    {
                        <div class="mb-3">
                            <label class="form-label"><strong>Customer Requested Shipment Date:</strong></label>
                            <input type="datetime-local" class="form-control order-edit-field"
                                   data-field-type="requestedshipmentdate"
                                   value=""
                                   data-original-value=""
                                   placeholder="Customer requested shipment date"
                                   id="customer-requested-shipment-date"/>
                        </div>
                    }

                    <!-- Shipment Details Section -->
                    @if (Model.IsShippable)
                    {
                        <div class="mb-3" id="shipment-details-section">
                            <!-- This section will be populated by JavaScript when shipments exist -->
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label"><strong>Order Total:</strong></label>
                        <div><strong>@Model.OrderTotal</strong></div>
                    </div>
                    
                    <!-- Address Information -->
                    @{
                        var addressesAreSame = Model.BillingAddress != null && Model.ShippingAddress != null &&
                                               Model.BillingAddress.FirstName == Model.ShippingAddress.FirstName &&
                                               Model.BillingAddress.LastName == Model.ShippingAddress.LastName &&
                                               Model.BillingAddress.Address1 == Model.ShippingAddress.Address1 &&
                                               Model.BillingAddress.City == Model.ShippingAddress.City;
                    }
                    
                    @if (addressesAreSame && Model.BillingAddress != null)
                    {
                        <div class="mb-3">
                            <label class="form-label"><strong>Billing & Shipping Address:</strong></label>
                            <div class="border p-2 bg-light">
                                @if (!string.IsNullOrEmpty(Model.BillingAddress.FirstName) || !string.IsNullOrEmpty(Model.BillingAddress.LastName))
                                {
                                    <div><strong>@Model.BillingAddress.FirstName @Model.BillingAddress.LastName</strong></div>
                                }
                                @if (!string.IsNullOrEmpty(Model.BillingAddress.Company))
                                {
                                    <div>@Model.BillingAddress.Company</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.BillingAddress.Address1))
                                {
                                    <div>@Model.BillingAddress.Address1</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.BillingAddress.City))
                                {
                                    <div>@Model.BillingAddress.City, @Model.BillingAddress.ZipPostalCode</div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (Model.ShippingAddress != null)
                        {
                            <div class="mb-3">
                                <label class="form-label"><strong>Shipping Address:</strong></label>
                                <div class="border p-2" style="background-color: #e3f2fd;">
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.FirstName) || !string.IsNullOrEmpty(Model.ShippingAddress.LastName))
                                    {
                                        <div><strong>@Model.ShippingAddress.FirstName @Model.ShippingAddress.LastName</strong></div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.Company))
                                    {
                                        <div>@Model.ShippingAddress.Company</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.Address1))
                                    {
                                        <div>@Model.ShippingAddress.Address1</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.City))
                                    {
                                        <div>@Model.ShippingAddress.City, @Model.ShippingAddress.ZipPostalCode</div>
                                    }
                                </div>
                            </div>
                        }
                        
                        @if (Model.BillingAddress != null)
                        {
                            <div class="mb-3">
                                <label class="form-label"><strong>Billing Address:</strong></label>
                                <div class="border p-2" style="background-color: #e8f5e8;">
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.FirstName) || !string.IsNullOrEmpty(Model.BillingAddress.LastName))
                                    {
                                        <div><strong>@Model.BillingAddress.FirstName @Model.BillingAddress.LastName</strong></div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.Company))
                                    {
                                        <div>@Model.BillingAddress.Company</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.Address1))
                                    {
                                        <div>@Model.BillingAddress.Address1</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.City))
                                    {
                                        <div>@Model.BillingAddress.City, @Model.BillingAddress.ZipPostalCode</div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    
                    @if (Model.PickupAddress != null)
                    {
                        <div class="mb-3">
                            <label class="form-label"><strong>Pickup Address:</strong></label>
                            <div class="border p-2" style="background-color: #fff3cd;">
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.FirstName) || !string.IsNullOrEmpty(Model.PickupAddress.LastName))
                                {
                                    <div><strong>@Model.PickupAddress.FirstName @Model.PickupAddress.LastName</strong></div>
                                }
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.Company))
                                {
                                    <div>@Model.PickupAddress.Company</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.Address1))
                                {
                                    <div>@Model.PickupAddress.Address1</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.City))
                                {
                                    <div>@Model.PickupAddress.City, @Model.PickupAddress.ZipPostalCode</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <!-- Order Information Section -->
        <div class="col-lg-4 col-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Order Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Order number:</strong></label>
                            <div>@Model.OrderNumber</div>
                        </div>
                        
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Order status:</strong></label>
                            <div><span class="badge badge-warning">@Model.OrderStatus</span></div>
                        </div>
                        
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Order created:</strong></label>
                            <div>@Html.DisplayFor(model => model.CreatedOn)</div>
                        </div>
                        
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Currency:</strong></label>
                            <div>@Model.CurrencyCode @if (Model.CurrencyRate != 1) { <text>(@Model.CurrencyRate)</text> }</div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(Model.Code))
                        {
                            <div class="col-12 mb-3">
                                <label class="form-label"><strong>Code:</strong></label>
                                <div>@Model.Code</div>
                            </div>
                        }
                        
                        
                        @if (!string.IsNullOrEmpty(Model.RefundedAmount))
                        {
                            <div class="col-12 mb-3">
                                <label class="form-label"><strong>Refunded:</strong></label>
                                <div>@Model.RefundedAmount</div>
                            </div>
                        }
                        
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Profit:</strong></label>
                            <div>@Model.Profit</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Section - Using Reusable Component -->
    @await Component.InvokeAsync("OrderProductsTable", new { model = Model, showAddProducts = true, showSummary = true, collapsible = true })
</div>

<style>
/* ProductSearchAdd component integration with Order Info tab - Transparent styling */
.add-products-section {
    background: transparent;
    width: 100%;
    box-sizing: border-box;
}

.add-products-section .x_panel {
    margin-bottom: 0;
    border: none;
    box-shadow: none;
    background: transparent;
}

.add-products-section .x_title {
    background: transparent;
    padding: 10px 15px;
    margin-bottom: 0;
}

.add-products-section .x_title .caption {
    color: white;
    font-weight: 600;
    font-size: 1em;
}

.add-products-section .x_content {
    padding: 10px;
    background: transparent;
    width: 100%;
    box-sizing: border-box;
}

/* Ensure Bootstrap grid stays within bounds */
.add-products-section .row {
    margin-left: 0;
    margin-right: 0;
    width: 100%;
}

.add-products-section [class*="col-"] {
    padding-left: 8px;
    padding-right: 8px;
}

/* Ensure form controls don't overflow */
.add-products-section .form-control,
.add-products-section .form-group {
    max-width: 100%;
    box-sizing: border-box;
}

/* Unit/Case quantity selector styling */
.quantity-unit-case-wrapper {
    display: inline-block;
}

.quantity-unit-case-wrapper .d-flex {
    gap: 4px;
}

.quantity-unit-case-wrapper .quantity-display-input {
    text-align: center;
}

.quantity-unit-case-wrapper .unit-case-selector {
    font-size: 13px;
    padding: 4px 8px;
}

.quantity-unit-case-wrapper small {
    font-size: 11px;
    text-align: center;
}

/* Product savings indicator styling */
.savings-indicator {
    text-align: left;
    white-space: nowrap;
}

.savings-indicator small {
    font-size: 0.75rem;
    padding: 2px 6px;
    background-color: rgba(40, 167, 69, 0.1);
    border: 1px solid rgba(40, 167, 69, 0.3);
    border-radius: 3px;
    color: #28a745;
}

/* Dark mode adjustments for savings indicator */
@@media (prefers-color-scheme: dark) {
    .savings-indicator small {
        background-color: rgba(40, 167, 69, 0.2);
        border-color: rgba(40, 167, 69, 0.4);
        color: #48d96e;
    }
}

[data-theme="dark"] .savings-indicator small {
    background-color: rgba(40, 167, 69, 0.2);
    border-color: rgba(40, 167, 69, 0.4);
    color: #48d96e;
}
</style>

<script>
$(document).ready(function() {
    // Initialize order tags
    @Html.Raw(orderTagsSB.ToString())
    $("#OrderTags").tagEditor({
        autocomplete: {
            delay: 0,
            position: { collision: 'flip' },
            source: initialOrderTags
        },
        delimiter: ',',
        placeholder: 'Enter tags...'
    });

    // Sales employee functionality
    $("#salesEmployeeIdSelect").change(function() {
        $("#submitSalesEmployee").removeClass("btn-success").addClass("btn-primary");
    });
    
    $("#submitSalesEmployee").click(function(e) {
        e.preventDefault();
        
        var orderId = '@Model.Id';
        var salesEmployeeId = $("#salesEmployeeIdSelect").val();
        
        $.ajax({
            url: '@Url.Action("SaveSalesEmployee", "Order", new { area = "Admin" })',
            type: 'POST',
            data: {
                id: orderId,
                salesEmployeeId: salesEmployeeId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(result) {
                if (result.success) {
                    $("#submitSalesEmployee").removeClass("btn-primary").addClass("btn-success");
                    showSuccessMessage("Sales representative updated successfully");
                } else {
                    showErrorMessage(result.message || "Error saving sales employee");
                }
            },
            error: function() {
                showErrorMessage("Error saving sales employee. Please try again.");
            }
        });
    });
    
    // Toggle products collapse
    $('#productsCollapse').on('show.bs.collapse', function () {
        $(this).prev().find('i').removeClass('fa-chevron-down').addClass('fa-chevron-up');
    });
    
    $('#productsCollapse').on('hide.bs.collapse', function () {
        $(this).prev().find('i').removeClass('fa-chevron-up').addClass('fa-chevron-down');
    });

    // Check shipments on page load for ProductSearchAdd component
    checkShipmentsForInfoTab();

    // Load shipment details for inline editing
    loadShipmentDetailsForInfoTab();

    // Always load customer requested shipment date for shippable orders
    if (@Json.Serialize(Model.IsShippable)) {
        loadOrderRequestedShipmentDate();
    }

    // Initialize unit/case quantity handlers
    initializeUnitCaseQuantityHandlers();

    // Initialize auto-save original values
    initializeAutoSaveValues();

    // Load product savings indicators
    loadProductSavings();
});

function showSuccessMessage(message) {
    var alert = $('<div class="alert alert-success alert-dismissible fade show mt-2" role="alert">' + 
                  message + 
                  '<button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>' +
                  '</div>');
    $("#salesEmployeeIdSelect").after(alert);
    setTimeout(function() {
        alert.fadeOut();
    }, 3000);
}

function showErrorMessage(message) {
    var alert = $('<div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">' + 
                  message + 
                  '<button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>' +
                  '</div>');
    $("#salesEmployeeIdSelect").after(alert);
    setTimeout(function() {
        alert.fadeOut();
    }, 5000);
}

function toggleChangeOrderStatus(editmode) {
    if (editmode) {
        $('#pnlChangeOrderStatus').show();
        $('#btnChangeOrderStatus').hide();
    } else {
        $('#pnlChangeOrderStatus').hide();
        $('#btnChangeOrderStatus').show();
    }
}

function toggleOrderTotals(editmode) {
    if (editmode) {
        $('#trEditOrderTotals').show();
        $('#btnEditOrderTotals').hide();
        $('#btnSaveOrderTotals').show();
        $('#btnCancelOrderTotals').show();
    } else {
        $('#trEditOrderTotals').hide();
        $('#btnEditOrderTotals').show();
        $('#btnSaveOrderTotals').hide();
        $('#btnCancelOrderTotals').hide();
    }
}

// Function expected by the ProductSearchAdd component in Info tab
function refreshCurrentProductsGrid() {
    // Info tab is index 0 in the order edit tabstrip
    var infoTabIndex = 0;

    // Set URL hash to preserve Info tab state after reload
    if (window.location.hash !== '#tab-' + infoTabIndex) {
        window.location.hash = '#tab-' + infoTabIndex;
    }

    // Reload page with hash preserved - admin-tabstrip will restore the active tab
    window.location.reload();
}

// Check for existing shipments and hide ProductSearchAdd if shipments exist or order is in fulfillment
var isCheckingShipmentsForInfoTab = false; // Flag to prevent multiple simultaneous calls

function checkShipmentsForInfoTab() {
    // Prevent multiple simultaneous executions
    if (isCheckingShipmentsForInfoTab) {
        return;
    }
    isCheckingShipmentsForInfoTab = true;

    var isVerifiedOrder = @Json.Serialize(Model.IsVerifiedOrder);

    if (isVerifiedOrder) {
        // Remove any existing warnings first, then hide ProductSearchAdd section for verified orders (in fulfillment queue)
        $('.shipment-warning').remove();
        $('.add-products-section').hide();
        $('.add-products-section').after(
            '<div class="shipment-warning alert alert-warning mt-3">' +
            '<i class="fa fa-warning"></i> ' +
            'Cannot add products to orders in fulfillment queue. ' +
            '<button type="button" class="btn btn-primary btn-sm ml-2" onclick="sendToReverificationFromInfoTab(\'@Model.Id\')">' +
            '<i class="fa fa-undo"></i> Send to Reverification' +
            '</button>' +
            '</div>'
        );
        isCheckingShipmentsForInfoTab = false; // Reset flag
        return;
    }

    $.ajax({
        url: "@Html.Raw(Url.Action("ShipmentsByOrder", "Shipment", new { orderId = Model.Id, area = Grand.Web.Admin.Extensions.Constants.AreaAdmin }))",
        type: "POST",
        data: { __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
        dataType: "json",
        success: function(data) {
            if (data && data.Total > 0) {
                // Remove any existing warnings first, then hide ProductSearchAdd section and show warning
                $('.shipment-warning').remove();
                $('.add-products-section').hide();
                $('.add-products-section').after(
                    '<div class="shipment-warning alert alert-warning mt-3">' +
                    '<i class="fa fa-warning"></i> ' +
                    'Cannot add products when shipments exist. Please delete existing shipments first to add new products.' +
                    '</div>'
                );
            } else {
                // Show ProductSearchAdd section if no shipments and not verified
                $('.add-products-section').show();
                $('.shipment-warning').remove();
            }
            isCheckingShipmentsForInfoTab = false; // Reset flag on success
        },
        error: function() {
            // On error, show ProductSearchAdd (fail safe) only if not verified
            if (!isVerifiedOrder) {
                $('.add-products-section').show();
            }
            isCheckingShipmentsForInfoTab = false; // Reset flag on error
        }
    });
}

function sendToReverificationFromInfoTab(orderId) {
    if (!confirm('Are you sure you want to send this order back to reverification? This will delete any existing shipments.')) {
        return;
    }

    $.ajax({
          url: "@Html.Raw(Url.Action("SendToReverification", "Order", new { area = Grand.Web.Admin.Extensions.Constants.AreaAdmin }))",
        type: "POST",
        data: addAntiForgeryToken({ orderId: orderId }),
        dataType: "json",
        success: function(result) {
            if (result.success) {
                // Refresh the page to update the UI state
                window.location.reload();
            } else {
                alert('Error: ' + (result.message || 'Failed to send order to reverification'));
            }
        },
        error: function() {
            alert('Error occurred while sending order to reverification.');
        }
    });
}

function initializeUnitCaseQuantityHandlers() {
    // Handle unit/case selector change
    $(document).on('change', '.unit-case-selector', function() {
        const $selector = $(this);
        const $wrapper = $selector.closest('.quantity-unit-case-wrapper');
        const $displayInput = $wrapper.find('.quantity-display-input');
        const $hiddenInput = $wrapper.find('.actual-quantity-input');
        const caseSize = parseFloat($wrapper.data('case-size'));
        const currentActualQty = parseFloat($hiddenInput.val());
        const selectedUnit = $selector.val();

        if (selectedUnit === 'case') {
            // Convert units to cases for display
            const cases = currentActualQty / caseSize;
            // Round to 2 decimal places for display
            $displayInput.val(Math.round(cases * 100) / 100 || 1);
            $displayInput.attr('step', '0.01');
        } else {
            // Show actual units
            $displayInput.val(currentActualQty);
            $displayInput.attr('step', '1');
        }

        // Store the current display value as original to prevent auto-save on unit switch
        $displayInput.data('display-original-value', $displayInput.val());
    });

    // Handle display input change - update hidden field with unit quantity
    $(document).on('blur', '.quantity-display-input', function() {
        const $displayInput = $(this);
        const $wrapper = $displayInput.closest('.quantity-unit-case-wrapper');
        const $selector = $wrapper.find('.unit-case-selector');
        const $hiddenInput = $wrapper.find('.actual-quantity-input');
        const caseSize = parseFloat($wrapper.data('case-size'));
        const displayValue = parseFloat($displayInput.val());
        const selectedUnit = $selector.val();

        // Convert to unit quantity
        let unitQuantity;
        if (selectedUnit === 'case') {
            // Convert cases to units
            unitQuantity = displayValue * caseSize;
        } else {
            // Direct unit value
            unitQuantity = displayValue;
        }

        // Update hidden input value
        $hiddenInput.val(unitQuantity);

        // Trigger blur on hidden input to fire the existing auto-save logic
        $hiddenInput.trigger('blur');
    });

    // Initialize display values based on current quantities
    $('.quantity-unit-case-wrapper').each(function() {
        const $wrapper = $(this);
        const $displayInput = $wrapper.find('.quantity-display-input');
        const $hiddenInput = $wrapper.find('.actual-quantity-input');
        const $selector = $wrapper.find('.unit-case-selector');
        const caseSize = parseFloat($wrapper.data('case-size'));
        const actualQty = parseFloat($hiddenInput.val());

        // Default to units view
        $selector.val('unit');
        $displayInput.val(actualQty);
    });
}

// Initialize auto-save original values for inline edit fields
function initializeAutoSaveValues() {
    $('.inline-edit-field').each(function() {
        var $field = $(this);
        var currentValue = $field.val();
        $field.data('original-value', currentValue);
    });
}

// Load and display shipment details for inline editing
function loadShipmentDetailsForInfoTab() {
    if (!@Json.Serialize(Model.IsShippable)) {
        return;
    }

    $.ajax({
        url: "@Html.Raw(Url.Action("ShipmentsByOrder", "Shipment", new { orderId = Model.Id, area = Grand.Web.Admin.Extensions.Constants.AreaAdmin }))",
        type: "POST",
        data: { __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
        dataType: "json",
        success: function(data) {
            if (data && data.Data && data.Data.length > 0) {
                displayShipmentDetails(data.Data);
            }
        },
        error: function() {
            console.log('Error loading shipment details');
        }
    });
}

// Display shipment details with inline editing
function displayShipmentDetails(shipments) {
    var $section = $('#shipment-details-section');
    var html = '';

    if (shipments.length > 0) {
        html += '<div class="card mt-3">';
        html += '<div class="card-header d-flex justify-content-between align-items-center">';
        html += '<h6 class="mb-0">Shipment Details</h6>';
        html += '<button class="btn btn-sm btn-outline-primary" type="button" data-toggle="collapse" data-target="#shipmentDetailsCollapse">';
        html += '<i class="fa fa-chevron-down"></i>';
        html += '</button>';
        html += '</div>';
        html += '<div class="collapse" id="shipmentDetailsCollapse">';
        html += '<div class="card-body">';


        shipments.forEach(function(shipment, index) {
            html += '<div class="shipment-item" data-shipment-id="' + shipment.Id + '">';
            html += '<h6>Shipment #' + (shipment.ShipmentNumber || (index + 1)) + '</h6>';

            // Tracking Number
            html += '<div class="mb-2">';
            html += '<label class="form-label"><strong>Tracking Number:</strong></label>';
            html += '<input type="text" class="form-control shipment-edit-field" ';
            html += 'data-field-type="trackingnumber" ';
            html += 'value="' + (shipment.TrackingNumber || '') + '" ';
            html += 'data-original-value="' + (shipment.TrackingNumber || '') + '" ';
            html += 'placeholder="Enter tracking number"/>';
            html += '</div>';

            // Shipped Date
            html += '<div class="mb-2">';
            html += '<label class="form-label"><strong>Shipped Date:</strong></label>';
            html += '<input type="datetime-local" class="form-control shipment-edit-field" ';
            html += 'data-field-type="shippeddate" ';
            var shippedDate = shipment.ShippedDateUtc ? new Date(shipment.ShippedDateUtc) : null;
            if (shippedDate) {
                // Convert to local datetime-local format (YYYY-MM-DDTHH:mm)
                var localDate = new Date(shippedDate.getTime() - shippedDate.getTimezoneOffset() * 60000);
                html += 'value="' + localDate.toISOString().slice(0, 16) + '" ';
                html += 'data-original-value="' + localDate.toISOString().slice(0, 16) + '" ';
            } else {
                html += 'value="" data-original-value="" ';
            }
            html += '/>';
            html += '</div>';

            // Delivery Date
            html += '<div class="mb-2">';
            html += '<label class="form-label"><strong>Delivery Date:</strong></label>';
            html += '<input type="datetime-local" class="form-control shipment-edit-field" ';
            html += 'data-field-type="deliverydate" ';
            var deliveryDate = shipment.DeliveryDateUtc ? new Date(shipment.DeliveryDateUtc) : null;
            if (deliveryDate) {
                var localDate = new Date(deliveryDate.getTime() - deliveryDate.getTimezoneOffset() * 60000);
                html += 'value="' + localDate.toISOString().slice(0, 16) + '" ';
                html += 'data-original-value="' + localDate.toISOString().slice(0, 16) + '" ';
            } else {
                html += 'value="" data-original-value="" ';
            }
            html += '/>';
            html += '</div>';

            // Admin Comment
            html += '<div class="mb-2">';
            html += '<label class="form-label"><strong>Admin Comment:</strong></label>';
            html += '<textarea class="form-control shipment-edit-field" rows="2" ';
            html += 'data-field-type="admincomment" ';
            html += 'data-original-value="' + (shipment.AdminComment || '') + '" ';
            html += 'placeholder="Enter admin comment">' + (shipment.AdminComment || '') + '</textarea>';
            html += '</div>';

            if (index < shipments.length - 1) {
                html += '<hr>';
            }
            html += '</div>';
        });

        html += '</div>';
        html += '</div>';
        html += '</div>';
    }

    $section.html(html);

    // Initialize auto-save for shipment fields
    initializeShipmentFieldAutoSave();

    // Initialize collapse toggle functionality
    $('#shipmentDetailsCollapse').on('show.bs.collapse', function () {
        $(this).prev().find('i').removeClass('fa-chevron-down').addClass('fa-chevron-up');
    });

    $('#shipmentDetailsCollapse').on('hide.bs.collapse', function () {
        $(this).prev().find('i').removeClass('fa-chevron-up').addClass('fa-chevron-down');
    });
}

// Initialize auto-save functionality for shipment fields
function initializeShipmentFieldAutoSave() {
    $(document).off('blur change', '.shipment-edit-field, .order-edit-field');

    // Handle shipment-level fields
    $(document).on('blur change', '.shipment-edit-field', function() {
        var $field = $(this);
        var currentValue = $field.val();
        var originalValue = $field.data('original-value') || '';

        // Only save if value has changed
        if (currentValue !== originalValue) {
            saveShipmentField($field);
        }
    });

    // Handle order-level fields (like requested shipment date)
    $(document).on('blur change', '.order-edit-field', function() {
        var $field = $(this);
        var currentValue = $field.val();
        var originalValue = $field.data('original-value') || '';
        var fieldType = $field.data('field-type');

        // Only save if value has changed
        if (currentValue !== originalValue) {
            if (fieldType === 'requestedshipmentdate') {
                saveOrderRequestedShipmentDate($field);
            }
        }
    });
}

// Save individual shipment field
function saveShipmentField($field) {
    var $shipmentItem = $field.closest('.shipment-item');
    var shipmentId = $shipmentItem.data('shipment-id');
    var fieldType = $field.data('field-type');
    var value = $field.val();
    var orderId = '@Model.Id';

    // Show saving indicator
    var $indicator = $('<small class="text-muted ml-2"><i class="fa fa-spinner fa-spin"></i> Saving...</small>');
    $field.after($indicator);
    $field.prop('disabled', true);

    $.ajax({
        url: '@Url.Action("UpdateShipmentField", "Order", new { area = Grand.Web.Admin.Extensions.Constants.AreaAdmin })',
        type: 'POST',
        data: {
            orderId: orderId,
            shipmentId: shipmentId,
            fieldType: fieldType,
            value: value,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(result) {
            $indicator.remove();
            $field.prop('disabled', false);

            if (result.success) {
                // Update original value to prevent re-saving
                $field.data('original-value', value);

                // Show success indicator briefly
                var $success = $('<small class="text-success ml-2"><i class="fa fa-check"></i> Saved</small>');
                $field.after($success);
                setTimeout(function() {
                    $success.fadeOut(function() {
                        $success.remove();
                    });
                }, 2000);
            } else {
                // Show error and revert value
                var originalValue = $field.data('original-value') || '';
                $field.val(originalValue);

                var $error = $('<small class="text-danger ml-2"><i class="fa fa-times"></i> ' + (result.message || 'Save failed') + '</small>');
                $field.after($error);
                setTimeout(function() {
                    $error.fadeOut(function() {
                        $error.remove();
                    });
                }, 3000);
            }
        },
        error: function() {
            $indicator.remove();
            $field.prop('disabled', false);

            // Revert value on error
            var originalValue = $field.data('original-value') || '';
            $field.val(originalValue);

            var $error = $('<small class="text-danger ml-2"><i class="fa fa-times"></i> Network error</small>');
            $field.after($error);
            setTimeout(function() {
                $error.fadeOut(function() {
                    $error.remove();
                });
            }, 3000);
        }
    });
}

// Load and populate the customer requested shipment date
function loadOrderRequestedShipmentDate() {
    $.ajax({
        url: '@Url.Action("GetRequestedShipmentDate", "Order", new { area = Grand.Web.Admin.Extensions.Constants.AreaAdmin })',
        type: 'GET',
        data: {
            orderId: '@Model.Id'
        },
        success: function(result) {
            if (result.success && result.value) {
                var $field = $('#customer-requested-shipment-date');
                if ($field.length > 0) {
                    // Convert date to datetime-local format (YYYY-MM-DDTHH:mm)
                    var date = new Date(result.value + 'T00:00:00');
                    var localDate = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
                    var formattedValue = localDate.toISOString().slice(0, 16);

                    $field.val(formattedValue);
                    $field.data('original-value', formattedValue);
                }
            }
        },
        error: function() {
            console.log('Error loading requested shipment date');
        }
    });
}

// Save order-level requested shipment date
function saveOrderRequestedShipmentDate($field) {
    var value = $field.val();
    var orderId = '@Model.Id';

    // Show saving indicator
    var $indicator = $('<small class="text-muted ml-2"><i class="fa fa-spinner fa-spin"></i> Saving...</small>');
    $field.after($indicator);
    $field.prop('disabled', true);

    // Convert datetime-local to date format for the API (YYYY-MM-DD)
    var dateValue = value ? value.split('T')[0] : '';

    $.ajax({
        url: '@Url.Action("SaveRequestedShipmentDate", "Order", new { area = Grand.Web.Admin.Extensions.Constants.AreaAdmin })',
        type: 'POST',
        data: {
            orderId: orderId,
            date: dateValue,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(result) {
            $indicator.remove();
            $field.prop('disabled', false);

            if (result.success) {
                // Update original value to prevent re-saving
                $field.data('original-value', value);
                // Also update the field's stored value attribute to ensure consistency
                $field.attr('data-original-value', value);

                // Show success indicator briefly
                var $success = $('<small class="text-success ml-2"><i class="fa fa-check"></i> Saved</small>');
                $field.after($success);
                setTimeout(function() {
                    $success.fadeOut(function() {
                        $success.remove();
                    });
                }, 2000);
            } else {
                // Show error and revert value
                var originalValue = $field.data('original-value') || '';
                $field.val(originalValue);

                var $error = $('<small class="text-danger ml-2"><i class="fa fa-times"></i> Save failed</small>');
                $field.after($error);
                setTimeout(function() {
                    $error.fadeOut(function() {
                        $error.remove();
                    });
                }, 3000);
            }
        },
        error: function() {
            $indicator.remove();
            $field.prop('disabled', false);

            // Revert value on error
            var originalValue = $field.data('original-value') || '';
            $field.val(originalValue);

            var $error = $('<small class="text-danger ml-2"><i class="fa fa-times"></i> Network error</small>');
            $field.after($error);
            setTimeout(function() {
                $error.fadeOut(function() {
                    $error.remove();
                });
            }, 3000);
        }
    });
}

// Load and display product savings indicators
function loadProductSavings() {
    // Find all price input fields with product IDs (not weight dropdowns)
    $('input.inline-edit-field[data-product-id]').each(function() {
        var $priceInput = $(this);
        var productId = $priceInput.data('product-id');
        var currentPrice = parseFloat($priceInput.val()) || 0;
        var orderItemId = $priceInput.attr('name').match(/Items\[(\d+)\]/)?.[1];

        if (productId && currentPrice > 0 && orderItemId !== undefined) {
            checkProductSavings(productId, currentPrice, orderItemId);
        }
    });
}

// Check individual product for savings
function checkProductSavings(productId, currentPrice, orderItemId) {
    var orderId = '@Model.Id';
    var orderItems = @Html.Raw(Json.Serialize(Model.Items.Select((item, index) => new { Index = index, Id = item.Id, CaseSize = item.CaseSize, WarehouseId = item.WarehouseId, SelectedWeightCombinationId = item.SelectedWeightCombinationId })));
    var orderItem = orderItems.find(item => item.Index == orderItemId);

    $.ajax({
        url: '@Url.Action("GetProductSavings", "Order", new { area = Grand.Web.Admin.Extensions.Constants.AreaAdmin })',
        type: 'POST',
        data: {
            productId: productId,
            currentPrice: currentPrice,
            warehouseId: orderItem ? orderItem.WarehouseId : null,
            attributeValueId: orderItem ? orderItem.SelectedWeightCombinationId : null,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(result) {
            if (orderItem) {
                // Display savings if available
                if (result.hasSavings) {
                    displaySavingsIndicator(orderItem.Id, result.savings);
                }

                // Display inventory information
                if (result.stockQuantity !== undefined && result.warehouseName) {
                    displayInventoryInfo(orderItem.Id, result.stockQuantity, orderItem.CaseSize, result.warehouseName);
                }
            }
        },
        error: function() {
            console.log('Error checking product savings for product: ' + productId);
        }
    });
}

// Display savings indicator for a specific order item
function displaySavingsIndicator(orderItemId, savings) {
    var $indicator = $('#savings-' + orderItemId);
    var $small = $indicator.find('small');

    // Format savings amount (assuming currency formatting)
    var formattedSavings = '$' + savings.toFixed(2);

    $small.text('Save ' + formattedSavings);
    $indicator.show();
}

// Display inventory information for a specific order item
function displayInventoryInfo(orderItemId, stockQuantity, caseSize, warehouseName) {
    var $indicator = $('#inventory-' + orderItemId);

    if (stockQuantity > 0 && caseSize > 0) {
        var casesAvailable = Math.floor(stockQuantity / caseSize);
        var inventoryText = ' • ' + stockQuantity + ' Available (' + casesAvailable + ' cases)';

        // Add warehouse information on separate line if available
        if (warehouseName && warehouseName.trim()) {
            // Escape HTML to prevent XSS
            var escapedWarehouseName = $('<div>').text(warehouseName).html();
            inventoryText += '<br>Warehouse: ' + escapedWarehouseName;
        }

        $indicator.html(inventoryText);
        $indicator.show();
    }
}

// Add real-time price change detection
$(document).on('input change', 'input.inline-edit-field[data-product-id]', function() {
    var $priceInput = $(this);
    var productId = $priceInput.data('product-id');
    var currentPrice = parseFloat($priceInput.val()) || 0;
    var orderItemId = $priceInput.attr('name').match(/Items\[(\d+)\]/)?.[1];

    if (productId && currentPrice > 0 && orderItemId !== undefined) {
        // Hide existing indicators first
        var orderId = '@Model.Id';
        var orderItems = @Html.Raw(Json.Serialize(Model.Items.Select((item, index) => new { Index = index, Id = item.Id, CaseSize = item.CaseSize, WarehouseId = item.WarehouseId })));
        var orderItem = orderItems.find(item => item.Index == orderItemId);

        if (orderItem) {
            $('#savings-' + orderItem.Id).hide();
            $('#inventory-' + orderItem.Id).hide();
        }

        // Recalculate savings and inventory with new price
        checkProductSavings(productId, currentPrice, orderItemId);
    } else {
        // If price is 0 or invalid, hide indicators
        if (orderItemId !== undefined) {
            var orderId = '@Model.Id';
            var orderItems = @Html.Raw(Json.Serialize(Model.Items.Select((item, index) => new { Index = index, Id = item.Id, CaseSize = item.CaseSize, WarehouseId = item.WarehouseId })));
            var orderItem = orderItems.find(item => item.Index == orderItemId);

            if (orderItem) {
                $('#savings-' + orderItem.Id).hide();
                $('#inventory-' + orderItem.Id).hide();
            }
        }
    }
});

// Save order item quantity changes
function saveOrderItemQuantity($field, newQuantity) {
    // Get order item ID from the field's name attribute (e.g., Items[0].Quantity)
    var fieldName = $field.attr('name') || '';
    var orderItemIndexMatch = fieldName.match(/Items\[(\d+)\]/);

    if (!orderItemIndexMatch) {
        console.log('Could not determine order item from field name: ' + fieldName);
        return;
    }

    var orderItemIndex = parseInt(orderItemIndexMatch[1]);
    var orderId = '@Model.Id';
    var orderItems = @Html.Raw(Json.Serialize(Model.Items.Select((item, index) => new { Index = index, Id = item.Id })));
    var orderItem = orderItems.find(item => item.Index === orderItemIndex);

    if (!orderItem) {
        console.log('Could not find order item for index: ' + orderItemIndex);
        return;
    }

    // Show saving indicator
    var $saveStatus = $('#save-status-' + orderItem.Id);
    if ($saveStatus.length === 0) {
        // Create save status indicator if it doesn't exist
        $saveStatus = $('<div class="auto-save-status" id="save-status-' + orderItem.Id + '" style="margin-top: 4px;"><small class="text-muted"><i class="fa fa-spinner fa-spin"></i> Saving...</small></div>');
        $field.closest('td').append($saveStatus);
    }
    $saveStatus.show();
    $field.prop('disabled', true);

    $.ajax({
        url: '@Url.Action("UpdateOrderItemField", "Order", new { area = Grand.Web.Admin.Extensions.Constants.AreaAdmin })',
        type: 'POST',
        data: {
            orderId: orderId,
            orderItemId: orderItem.Id,
            fieldType: 'quantity',
            value: newQuantity,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function(result) {
            $field.prop('disabled', false);

            if (result.success) {
                // Update original value to prevent re-saving
                $field.data('original-value', newQuantity);
                $field.attr('value', newQuantity);

                // Show success indicator briefly
                $saveStatus.html('<small class="text-success"><i class="fa fa-check"></i> Saved</small>');
                setTimeout(function() {
                    $saveStatus.fadeOut();
                }, 2000);
            } else {
                // Show error and revert value
                var originalValue = $field.data('original-value') || $field.attr('value') || '';
                $field.val(originalValue);

                $saveStatus.html('<small class="text-danger"><i class="fa fa-exclamation-triangle"></i> Error: ' + (result.message || 'Save failed') + '</small>');
                setTimeout(function() {
                    $saveStatus.fadeOut();
                }, 5000);
            }
        },
        error: function() {
            $field.prop('disabled', false);

            // Show error and revert value
            var originalValue = $field.data('original-value') || $field.attr('value') || '';
            $field.val(originalValue);

            $saveStatus.html('<small class="text-danger"><i class="fa fa-exclamation-triangle"></i> Network error</small>');
            setTimeout(function() {
                $saveStatus.fadeOut();
            }, 5000);
        }
    });
}

// General auto-save handler for inline-edit-field elements (excluding price fields which are handled separately)
$(document).on('blur change', '.inline-edit-field:not([data-product-id])', function() {
    var $field = $(this);
    var currentValue = $field.val();
    var originalValue = $field.data('original-value') || $field.attr('value') || '';

    // Only save if value has changed
    if (currentValue !== originalValue && currentValue !== '') {
        // Determine field type and handle accordingly
        if ($field.hasClass('actual-quantity-input') || $field.attr('name')?.includes('Quantity')) {
            saveOrderItemQuantity($field, currentValue);
        }
        // Add other field types here as needed
    }
});
</script>

