@model CustomerModel
@inject AdminAreaSettings adminAreaSettings
@{
    <div class="panel panel-default">
        <vc:admin-widget widget-zone="customer_details_orders_top" additional-data="Model"/>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-12">
                    <button type="button" class="btn btn-primary" onclick="startOrder('@Model.Id')">
                        <i class="fa fa-plus"></i> @Loc["Admin.Customers.Customers.Orders.StartOrder"]
                    </button>
                </div>
            </div>
            <br />
            <div id="order-grid"></div>
        </div>
        <vc:admin-widget widget-zone="customer_details_orders_bottom" additional-data="Model"/>
    </div>
    <script>
        $(document).ready(function () {
            $("#order-grid").kendoGrid({
                dataSource: {
                    transport: {
                        read: {
                            url: "@Html.Raw(Url.Action("OrderList", "Customer", new { customerId = Model.Id, area = Constants.AreaAdmin }))",
                            type: "POST",
                            dataType: "json",
                            data: addAntiForgeryToken
                        }
                    },
                    schema: {
                        data: "Data",
                        total: "Total",
                        errors: "Errors"
                    },
                    error: function(e) {
                        display_kendoui_grid_error(e);
                        // Cancel the changes
                        this.cancelChanges();
                    },
                    pageSize: @(adminAreaSettings.DefaultGridPageSize),
                    serverPaging: true,
                    serverFiltering: true,
                    serverSorting: true
                },
                autoBind: false,
                pageable: {
                    refresh: true,
                    pageSizes: [@(adminAreaSettings.GridPageSizes)]
                },
                editable: {
                    confirmation: false,
                    mode: "inline"
                },
                //details grid
                detailInit: detailInit,
                scrollable: false,
                columns: [{
                    field: "OrderNumber",
                    title: "@Loc["Admin.Customers.Customers.Orders.ID"]",
                    width: 90,
                    template: '<a class="k-link" href="@Url.Action("Edit", "Order", new { area = Constants.AreaAdmin })/#=Id#">#=OrderNumber#</a>'
                }, {
                    field: "OrderTotal",
                    title: "@Loc["Admin.Customers.Customers.Orders.OrderTotal"]",
                    width: 120,
                    template: '<a class="k-link" href="@Url.Action("Edit", "Order", new { area = Constants.AreaAdmin })/#=Id#">#=OrderTotal#</a>'
                }, {
                    field: "OrderStatus",
                    title: "@Loc["Admin.Customers.Customers.Orders.OrderStatus"]",
                    width: 160,
                    template: '<h4><span class="label label-' +
                            '# if(OrderStatusId == 10) {#warning #} #' +
                            '# if(OrderStatusId == 20) {#info #} #' +
                            '# if(OrderStatusId == 25) {#info #} #' +
                            '# if(OrderStatusId == 30) {#success #} #' +
                            '# if(OrderStatusId == 40) {#danger #} #' +
                            '">#=OrderStatus#</span></h4>'
                }, {
                    field: "PaymentStatus",
                    title: "@Loc["Admin.Customers.Customers.Orders.PaymentStatus"]",
                    width: 180
                }, {
                    field: "ShippingStatus",
                    title: "@Loc["Admin.Customers.Customers.Orders.ShippingStatus"]",
                    width: 180
                },
                @if (!adminAreaSettings.HideStoreColumn)
                {
                    <text>
                    {
                        field: "StoreName",
                        title: "@Loc["Admin.Customers.Customers.Orders.Store"]",
                        width: 200
                    },
                    </text>
                }
                {
                    field: "CreatedOn",
                    title: "@Loc["Admin.Customers.Customers.Orders.CreatedOn"]",
                    width: 220,
                    type: "date",
                    format: "{0:G}"
                }]
            });
        });
        //details grid
        function detailInit(e) {
            $("<div/>").appendTo(e.detailCell).kendoGrid({
                dataSource: {
                    transport: {
                        read: {
                            url: "@Html.Raw(Url.Action("OrderDetails", "Customer", new { area = Constants.AreaAdmin }))?orderId="+e.data.Id,
                            type: "POST",
                            dataType: "json",
                            data: addAntiForgeryToken
                        }
                    },
                    schema: {
                        data: "Data",
                        total: "Total",
                        errors: "Errors"
                    },
                    error: function(e) {
                        display_kendoui_grid_error(e);
                        // Cancel the changes
                        this.cancelChanges();
                    },
                    serverPaging: true,
                    serverFiltering: true,
                    serverSorting: true
                },
                scrollable: false,
                sortable: false,
                pageable: {
                    refresh: true,
                    numeric: false,
                    previousNext: false,
                    info: false
                },
                columns: [
                    {
                        field: "ProductName",
                        title: "@Loc["Admin.Orders.Products.ProductName"]",
                        width: 400,
                        template: '<a class="k-link" href="@Url.Action("Edit", "Product", new { area = Constants.AreaAdmin })/#=ProductId#">#=ProductName#</a>'
                    },
                    {
                        field: "Quantity",
                        title: "@Loc["Admin.Orders.Products.Quantity"]",
                        width: 100
                    },
                    {
                        field: "UnitPriceInclTax",
                        title: "@Loc["Admin.Orders.Products.Price"]",
                        width: 200
                    },
                    {
                        field: "SubTotalInclTax",
                        title: "@Loc["Admin.Orders.Products.Total"]",
                        width: 200
                    }
                ]
            });
        }

        function startOrder(customerId) {
            // First fetch customer addresses
            $.ajax({
                url: "@Html.Raw(Url.Action("GetCustomerAddresses", "Customer", new { area = Constants.AreaAdmin }))",
                type: "POST",
                data: addAntiForgeryToken({
                    customerId: customerId
                }),
                dataType: "json",
                success: function(addressData) {
                    if (addressData.success && addressData.addresses && addressData.addresses.length > 0) {
                        showAddressSelectionModal(customerId, addressData.addresses);
                    } else {
                        displayGrandeNotification("Customer must have saved addresses before creating an order", "error", 5000);
                    }
                },
                error: function(xhr, status, error) {
                    displayGrandeNotification("Error loading customer addresses", "error", 5000);
                }
            });
        }

        function showAddressSelectionModal(customerId, addresses) {
            var modalHtml = `
                <div class="modal fade" id="addressSelectionModal" tabindex="-1" role="dialog">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h4 class="modal-title">@Loc["Admin.Customers.Customers.Orders.StartOrder.SelectAddresses"]</h4>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <div class="form-group">
                                    <label for="billingAddressSelect">@Loc["Admin.Customers.Customers.Orders.StartOrder.BillingAddress"]</label>
                                    <select id="billingAddressSelect" class="form-control">
                                        <option value="">@Loc["Admin.Customers.Customers.Orders.StartOrder.SelectAddress"]</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="shippingAddressSelect">@Loc["Admin.Customers.Customers.Orders.StartOrder.ShippingAddress"]</label>
                                    <select id="shippingAddressSelect" class="form-control">
                                        <option value="">@Loc["Admin.Customers.Customers.Orders.StartOrder.SelectAddress"]</option>
                                    </select>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-default" data-dismiss="modal">@Loc["Admin.Common.Cancel"]</button>
                                <button type="button" class="btn btn-primary" onclick="createOrderWithAddresses('${customerId}')">@Loc["Admin.Customers.Customers.Orders.StartOrder.Create"]</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            // Remove existing modal if any
            $('#addressSelectionModal').remove();
            
            // Add modal to page
            $('body').append(modalHtml);
            
            // Populate address dropdowns
            addresses.forEach(function(address) {
                var addressText = address.firstName + ' ' + address.lastName;
                if (address.company) {
                    addressText += ' (' + address.company + ')';
                }
                if (address.address1) {
                    addressText += ', ' + address.address1;
                }
                if (address.city) {
                    addressText += ', ' + address.city;
                }
                
                var option = '<option value="' + address.id + '">' + addressText + '</option>';
                $('#billingAddressSelect').append(option);
                $('#shippingAddressSelect').append(option);
            });
            
            // Show modal
            $('#addressSelectionModal').modal('show');
        }

        function createOrderWithAddresses(customerId) {
            var billingAddressId = $('#billingAddressSelect').val();
            var shippingAddressId = $('#shippingAddressSelect').val();
            
            if (!billingAddressId || !shippingAddressId) {
                displayGrandeNotification("Please select both billing and shipping addresses", "error", 5000);
                return;
            }
            
            $('#addressSelectionModal').modal('hide');
            
            $.ajax({
                url: "@Html.Raw(Url.Action("StartOrder", "Customer", new { area = Constants.AreaAdmin }))",
                type: "POST",
                data: addAntiForgeryToken({
                    customerId: customerId,
                    billingAddressId: billingAddressId,
                    shippingAddressId: shippingAddressId
                }),
                dataType: "json",
                success: function(data) {
                    if (data.success) {
                        $("#order-grid").data("kendoGrid").dataSource.read();
                        displayGrandeNotification("Order created successfully", "success", 5000);
                        if (data.orderId) {
                            window.open("@Url.Action("Edit", "Order", new { area = Constants.AreaAdmin })/" + data.orderId, '_blank');
                        }
                    } else {
                        displayGrandeNotification(data.message || "Error creating order", "error", 5000);
                    }
                },
                error: function(xhr, status, error) {
                    displayGrandeNotification("Error creating order", "error", 5000);
                }
            });
        }
</script>}