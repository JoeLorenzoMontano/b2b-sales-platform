@using Grand.Business.Core.Interfaces.Common.Security
@using Grand.Domain.Permissions
@model OrderModel
@inject IPermissionService permissionService
@{
    //page title
    ViewBag.Title = Loc["Admin.Orders.EditOrderDetails"];
    //has "Manage Documents" permission?
    var canManageDocuments = await permissionService.Authorize(StandardPermission.ManageDocuments);
    var canManageMessageQueue = await permissionService.Authorize(StandardPermission.ManageMessageQueue);
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Order" asp-action="Edit" method="post" id="order-form">
    <input type="hidden" asp-for="Id"/>
    <div asp-validation-summary="All"></div>
    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="icon-basket"></i>
                        @Loc["Admin.Orders.EditOrderDetails"] - @Model.OrderNumber
                        <small>
                            <i class="fa fa-arrow-circle-left"></i>@Html.ActionLink(Loc["Admin.Orders.BackToList"], "List")
                        </small>
                    </div>
                    <div class="actions">
                        <div class="btn-group btn-group-devided util-btn-margin-bottom-5">
                            <a href="@Url.Action("PdfInvoice", new { orderId = Model.Id, area = Constants.AreaAdmin })" class="btn purple" target="_blank">
                                <i class="fa fa-file-pdf-o"></i> @Loc["Admin.Orders.PdfInvoice"]
                            </a>
                            <span id="order-delete" class="btn red">
                                <i class="fa fa-trash-o"></i> @Loc["Admin.Common.Delete"]
                            </span>
                            <a asp-action="CancelOrder" asp-route-id="@Model.Id" class="btn border-red" onclick="return confirm('@Loc["Admin.Common.AreYouSure"]');">
                                <i class="red fa fa-times-circle-o"></i>
                                @Loc["Admin.Common.Cancel"]
                            </a>
                            <input type="submit" id="btnRefreshPage" style="display: none"/>
                            <script>
                                $(document).ready(function () {
                                    $('#btnRefreshPage').click(function () {
                                        //refresh page
                                        location.reload();
                                    });
                                });
                            </script>
                            <vc:admin-widget widget-zone="order_details_buttons" additional-data="Model"/>
                        </div>
                    </div>
                </div>
                <div class="x_content form">
                    <admin-tabstrip name="order-edit" SetTabPos="true" BindGrid="true">
                        <items>
                            <tabstrip-item text="@Loc["Admin.Orders.Info"]" tab-index="0">
                                <content>
                                    <div>
                                        <partial name="Partials/OrderDetails.Info" model="Model"/>
                                    </div>
                                </content>
                            </tabstrip-item>

                            <tabstrip-item text="@Loc["Admin.Orders.Addresses"]" tab-index="1">
                                <content>
                                    <div>
                                        <partial name="Partials/OrderDetails.Addresses" model="Model"/>
                                    </div>
                                </content>
                            </tabstrip-item>
                            @if (Model.IsShippable)
                            {
                                <tabstrip-item text="@Loc["Admin.Orders.Shipments"]" tab-index="2">
                                    <content>
                                        <div>
                                            <partial name="Partials/OrderDetails.Shipment" model="Model"/>
                                        </div>
                                    </content>
                                </tabstrip-item>
                            }
                            <tabstrip-item text="@Loc["Admin.Orders.Products"]" tab-index="3">
                                <content>
                                    <div>
                                        <partial name="Partials/OrderDetails.Products" model="Model"/>
                                    </div>
                                </content>
                            </tabstrip-item>
                            @if (Model.IsShippable)
                            {
                                <tabstrip-item text="@Loc["Admin.Orders.Fulfillment"]" tab-index="4">
                                    <content>
                                        <div>
                                            <partial name="Partials/OrderDetails.Fulfillment" model="Model"/>
                                        </div>
                                    </content>
                                </tabstrip-item>
                            }
                            <tabstrip-item text="@Loc["Admin.Orders.OrderNotes"]" tab-index="5">
                                <content>
                                    <div>
                                        <partial name="Partials/OrderDetails.Notes" model="Model"/>
                                    </div>
                                </content>
                            </tabstrip-item>
                            @if (canManageDocuments)
                            {
                                <tabstrip-item text="@Loc["Admin.Orders.Documents"]" tab-index="6">
                                    <content>
                                        <div>
                                            <partial name="Partials/OrderDetails.Documents" model="Model"/>
                                        </div>
                                    </content>
                                </tabstrip-item>
                            }
                            <tabstrip-item text="@Loc["Admin.Common.UserFields.Tab"]" tab-index="7">
                                <content>
                                    <div>
                                        <div class="form-actions">
                                            <input type="submit" value="@Loc["Admin.Common.Save"]" id="btnSaveUserFields" name="save-generic-attributes" asp-action="EditUserFields" class="k-button"/>
                                        </div>
                                        <div class="form-horizontal">
                                            <partial name="Partials/UserFields" model="Model"/>
                                        </div>
                                    </div>
                                </content>
                            </tabstrip-item>
                            @if (canManageMessageQueue)
                            {
                                <tabstrip-item text="@Loc["Admin.Orders.Notifications"]" tab-index="8">
                                    <content>
                                        <div>
                                            <partial name="Partials/OrderDetails.Notifications" model="Model"/>
                                        </div>
                                    </content>
                                </tabstrip-item>
                            }
                            <vc:admin-widget widget-zone="order_details_tabs" additional-data="Model"/>
                        </items>
                    </admin-tabstrip>
                </div>
            </div>
        </div>
    </div>
</form>
<admin-delete-confirmation button-id="order-delete"/>

@* Inline edit styles *@
<style>
/* Order Item Inline Edit Styles */
.inline-edit-field {
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
    transition: all 0.2s ease;
    background-color: #fff;
    width: 100%;
    box-sizing: border-box;
}

.inline-edit-field:focus {
    border-color: #007bff;
    box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
    outline: none;
}

.inline-edit-field:hover:not(:disabled) {
    border-color: #aaa;
}

.inline-edit-field:disabled {
    background-color: #f8f9fa;
    opacity: 0.7;
    cursor: wait;
}

.inline-edit-field.save-success {
    border-color: #28a745;
    background-color: #f8fff9;
    animation: success-flash 1s ease;
}

@@keyframes success-flash {
    0% { background-color: #d4edda; }
    100% { background-color: #f8fff9; }
}

.inline-edit-field.is-invalid {
    border-color: #dc3545 !important;
    background-color: #fff5f5;
}

.inline-edit-field.border-danger {
    border-color: #dc3545 !important;
}

.invalid-feedback {
    width: 100%;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: #dc3545;
}

.auto-save-status {
    margin-top: 4px;
    text-align: center;
    min-height: 16px;
}

.auto-save-status .fa-spinner {
    animation: fa-spin 1s infinite linear;
}

.auto-save-status .text-success {
    color: #28a745 !important;
}

.auto-save-status .text-muted {
    color: #6c757d !important;
}
</style>

@* Inline edit JavaScript *@
<script>
$(document).ready(function() {
    initializeInlineEditing();
});

function initializeInlineEditing() {
    // Handle blur event for auto-save on price and quantity fields
    $(document).on('blur', 'input[name^="Items"][name$="UnitPriceExclTaxValue"], input[name^="Items"][name$="Quantity"]', function() {
        const $field = $(this);
        const $row = $field.closest('tr');
        // Extract index from field name (e.g., "Items[0].UnitPriceExclTaxValue" -> "0")
        const fieldName = $field.attr('name');
        const indexMatch = fieldName.match(/Items\[(\d+)\]/);
        
        let orderItemId = null;
        if (indexMatch) {
            const index = indexMatch[1];
            // The hidden input is placed before the <tr>, so search in the whole form
            const $idField = $(`input[name="Items[${index}].Id"]`);
            orderItemId = $idField.val();
            
            // Debug logging
            console.log('Field name:', fieldName, 'Index:', index);
            console.log('ID field found:', $idField.length, 'value:', orderItemId);
            console.log('ID field selector:', `input[name="Items[${index}].Id"]`);
        }
        
        const originalValue = $field.data('original-value') || $field.attr('data-original-value');
        const newValue = $field.val().trim();
        
        // Store original value if not already stored
        if (!originalValue) {
            $field.data('original-value', newValue);
            return;
        }
        
        // Validate we have an order item ID
        if (!orderItemId) {
            console.error('No order item ID found for field:', $field.attr('name'));
            showFieldError($field, 'Unable to identify order item');
            return;
        }
        
        // Only save if value changed and is valid
        if (newValue !== originalValue && isValidValue(newValue, getFieldType($field))) {
            autoSaveOrderItem(orderItemId, $field, newValue);
        } else if (newValue === originalValue) {
            clearFieldError($field);
        } else if (!isValidValue(newValue, getFieldType($field))) {
            showFieldError($field, getValidationMessage(getFieldType($field)));
        }
    });

    // Handle focus event - clear errors and store original value
    $(document).on('focus', 'input[name^="Items"][name$="UnitPriceExclTaxValue"], input[name^="Items"][name$="Quantity"]', function() {
        const $field = $(this);
        clearFieldError($field);
        
        // Store original value if not already stored
        if (!$field.data('original-value')) {
            $field.data('original-value', $field.val());
        }
    });

    // Prevent form submission when pressing Enter
    $(document).on('keypress', 'input[name^="Items"][name$="UnitPriceExclTaxValue"], input[name^="Items"][name$="Quantity"]', function(e) {
        if (e.which === 13) {
            $(this).blur();
            return false;
        }
    });
}

function getFieldType($field) {
    const name = $field.attr('name');
    if (name.includes('UnitPriceExclTaxValue')) return 'price';
    if (name.includes('Quantity')) return 'quantity';
    return 'unknown';
}

function isValidValue(value, fieldType) {
    if (!value || value === '') return false;
    
    if (fieldType === 'quantity') {
        const num = parseInt(value);
        return /^\d+$/.test(value) && num > 0;
    }
    
    if (fieldType === 'price') {
        const num = parseFloat(value);
        return /^\d+(\.\d{1,2})?$/.test(value) && num >= 0;
    }
    
    return false;
}

function getValidationMessage(fieldType) {
    if (fieldType === 'quantity') {
        return 'Quantity must be a positive whole number';
    }
    if (fieldType === 'price') {
        return 'Price must be a valid decimal number (e.g., 12.34)';
    }
    return 'Invalid value';
}

function autoSaveOrderItem(orderItemId, $field, newValue) {
    const $row = $field.closest('tr');
    const $statusDiv = $row.find('#save-status-' + orderItemId);
    const orderId = $('input[name="Id"]').val();
    const fieldType = getFieldType($field);
    
    // Show loading state
    $statusDiv.html('<small class="text-muted"><i class="fa fa-spinner fa-spin"></i> Saving...</small>').show();
    $field.prop('disabled', true);
    
    // Make AJAX call to update the field
    $.ajax({
        url: '@Url.Action("UpdateOrderItemField", "Order", new { area = Constants.AreaAdmin })',
        type: 'POST',
        data: addAntiForgeryToken({
            orderId: orderId,
            orderItemId: orderItemId,
            fieldType: fieldType,
            value: newValue
        }),
        success: function(response) {
            if (response.success) {
                // Update the original value data attribute
                $field.data('original-value', newValue);
                
                // Show success state
                $statusDiv.html('<small class="text-success"><i class="fa fa-check"></i> Saved</small>');
                
                // Update display values if provided
                if (response.newSubTotal) {
                    updateSubTotal(orderItemId, response.newSubTotal);
                }
                if (response.displayValue) {
                    updateDisplayValue(orderItemId, fieldType, response.displayValue);
                }
                
                // Clear any existing errors
                clearFieldError($field);
            } else {
                // Show error message
                showFieldError($field, response.message || 'Save failed');
                // Revert to original value
                $field.val($field.data('original-value'));
            }
        },
        error: function(xhr, status, error) {
            // Show generic error
            showFieldError($field, 'Network error - please try again');
            // Revert to original value
            $field.val($field.data('original-value'));
        },
        complete: function() {
            // Re-enable field
            $field.prop('disabled', false);
            
            // Hide success message after 2 seconds
            setTimeout(function() {
                $statusDiv.hide();
            }, 2000);
        }
    });
}

function showFieldError($field, message) {
    clearFieldError($field);
    $field.addClass('is-invalid border-danger');
    const errorHtml = '<div class="invalid-feedback d-block">' + message + '</div>';
    $field.after(errorHtml);
}

function clearFieldError($field) {
    $field.removeClass('is-invalid border-danger');
    $field.next('.invalid-feedback').remove();
}

function updateSubTotal(orderItemId, newSubTotal) {
    // Find and update the subtotal display for this item
    const $row = $('[data-order-item-id="' + orderItemId + '"]').closest('tr');
    $row.find('.subtotal-display').text(newSubTotal);
}

function updateDisplayValue(orderItemId, fieldType, displayValue) {
    // Update the display value shown below the input field
    const $field = $('[name^="Items"][name$="Id"][value="' + orderItemId + '"]').closest('tr');
    if (fieldType === 'price') {
        $field.find('.text-info span').text('Display: ' + displayValue);
    }
}
</script>