@using Grand.Business.Core.Interfaces.Catalog.Products
@using Grand.Business.Core.Interfaces.Common.Directory
@using Grand.Business.Core.Interfaces.Common.Localization
@using Grand.Domain.Catalog
@using System.Globalization
@model IList<Grand.Domain.Catalog.Product>
@inject IProductAttributeService _productAttributeService
@inject IContextAccessor _contextAccessor
@inject ITranslationService _translationService

@{
    var companyName = _contextAccessor.StoreContext.CurrentStore.CompanyName;
    var printDate = DateTime.UtcNow.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    // Order products by name for individual display
    var orderedProducts = Model.OrderBy(p => p.Name).ToList();
}

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>Product Catalog</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 9px;
            margin: 20px;
            color: #333;
        }

        .header {
            text-align: center;
            margin-bottom: 10px;
            border-bottom: 2px solid #333;
            padding-bottom: 5px;
        }

        .company-name {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .print-info {
            font-size: 8px;
            color: #666;
            margin-top: 10px;
        }

        .product-section {
            margin-bottom: 10px;
            page-break-inside: avoid;
            max-height: 80vh;
        }

        .product-header {
            background-color: #f0f0f0;
            font-weight: bold;
            font-size: 12px;
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .product-title {
            font-size: 14px;
            font-weight: bold;
            color: #333;
        }

        .product-sku {
            font-size: 10px;
            color: #666;
            margin-top: 2px;
        }

        .combination-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 5px;
            border: 1px solid #ddd;
            page-break-inside: auto;
        }

        .combination-table th {
            background-color: #e8e8e8;
            font-weight: bold;
            font-size: 10px;
            padding: 8px;
            border: 1px solid #ccc;
            text-align: left;
        }

        .combination-table td {
            border: 1px solid #ddd;
            padding: 6px 8px;
            vertical-align: top;
            font-size: 9px;
        }

        .simple-attributes-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 5px;
            border: 1px solid #ddd;
            page-break-inside: auto;
        }

        .simple-attributes-table th {
            background-color: #d4edda;
            font-weight: bold;
            font-size: 10px;
            padding: 8px;
            border: 1px solid #28a745;
            text-align: left;
        }

        .simple-attributes-table td {
            border: 1px solid #28a745;
            padding: 6px 8px;
            vertical-align: top;
            font-size: 9px;
        }

        .product-name {
            font-weight: bold;
            font-size: 9px;
        }

        .product-details {
            color: #666;
            font-size: 7px;
            line-height: 1.2;
        }

        .price-info {
            font-weight: bold;
            color: #000;
            text-align: right;
        }

        .strain-info {
            font-style: italic;
            color: #555;
        }

        .weight-conversion-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10px;
            border: 2px solid #1976d2;
            page-break-inside: auto;
        }

        .weight-conversion-table th {
            background-color: #e3f2fd;
            font-weight: bold;
            font-size: 10px;
            padding: 8px;
            border: 1px solid #1976d2;
            text-align: left;
            color: #1976d2;
        }

        .weight-conversion-table td {
            border: 1px solid #1976d2;
            padding: 6px 8px;
            vertical-align: top;
            font-size: 9px;
        }

        .footer {
            margin-top: 30px;
            border-top: 1px solid #ddd;
            padding-top: 10px;
            font-size: 7px;
            color: #666;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="company-name">@companyName</div>
        <div class="print-info">
            Product Catalog - Printed on: @printDate
        </div>
    </div>

    @foreach (var product in orderedProducts)
    {
        var combinations = product.ProductAttributeCombinations?.Where(c => !string.IsNullOrEmpty(c.Sku) || c.CaseSize > 0).ToList() ?? new List<ProductAttributeCombination>();
        var attributeMappings = product.ProductAttributeMappings?.ToList() ?? new List<ProductAttributeMapping>();

        // Limit combinations to prevent table overflow - split into chunks if too many
        const int maxCombinationsPerTable = 25;
        var combinationChunks = new List<List<ProductAttributeCombination>>();

        if (combinations.Count > maxCombinationsPerTable)
        {
            for (int i = 0; i < combinations.Count; i += maxCombinationsPerTable)
            {
                combinationChunks.Add(combinations.Skip(i).Take(maxCombinationsPerTable).ToList());
            }
        }
        else if (combinations.Any())
        {
            combinationChunks.Add(combinations);
        }

        <div class="product-section">
            <div class="product-header">
                <div class="product-title">@product.Name</div>
                @if (!string.IsNullOrEmpty(product.Sku))
                {
                    <div class="product-sku">SKU: @product.Sku</div>
                }
                @if (!string.IsNullOrEmpty(product.ShortDescription))
                {
                    <div style="font-size: 10px; color: #666; margin-top: 5px;">
                        @Html.Raw(product.ShortDescription.Length > 200 ? product.ShortDescription.Substring(0, 200) + "..." : product.ShortDescription)
                    </div>
                }
            </div>

            @* Display Product Attribute Combinations in chunks to prevent overflow *@
            @if (combinationChunks.Any())
            {
                @for (int chunkIndex = 0; chunkIndex < combinationChunks.Count; chunkIndex++)
                {
                    var chunk = combinationChunks[chunkIndex];

                    @if (chunkIndex > 0)
                    {
                        <div style="page-break-before: always;"></div>
                        <div class="product-header" style="margin-top: 0;">
                            <div class="product-title">@product.Name (continued)</div>
                            <div class="product-sku">Part @(chunkIndex + 1) of @combinationChunks.Count</div>
                        </div>
                    }

                    <table class="combination-table">
                        <thead>
                            <tr>
                                <th style="width: 40%;">Product Variant</th>
                                <th style="width: 20%;">SKU</th>
                                <th style="width: 40%;">Pricing Information</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var combination in chunk.OrderBy(c => c.Text))
                            {
                                <tr>
                                    <td>
                                        <div style="font-weight: bold;">@(!string.IsNullOrEmpty(combination.Text) ? combination.Text : "Standard Variant")</div>
                                        @if (!string.IsNullOrEmpty(combination.Sku))
                                        {
                                            <div style="font-size: 8px; color: #666;">@combination.Sku</div>
                                        }
                                    </td>
                                    <td style="text-align: center;">
                                        @combination.Sku
                                    </td>
                                    <td style="text-align: right;">
                                        @{
                                            var basePrice = combination.OverriddenPrice ?? product.Price;
                                            var caseSize = combination.CaseSize;
                                        }
                                        @if (caseSize > 0 && basePrice > 0)
                                        {
                                            var unitPrice = basePrice / caseSize;
                                            var totalCasePrice = basePrice;
                                            var unitCost = product.ProductCost > 0 ? product.ProductCost / caseSize : 0;
                                            var totalCaseCost = product.ProductCost;
                                            <div style="font-weight: bold; color: #2e7d32;">$@(totalCasePrice.ToString("F2")) /Case</div>
                                            <div style="font-size: 8px; color: #666; margin-bottom: 2px;">@(caseSize.ToString("F0")) units per case</div>
                                            <div style="font-size: 8px; color: #666;">Unit Price: $@(unitPrice.ToString("F2"))</div>
                                            @if (product.ProductCost > 0)
                                            {
                                                <div style="font-size: 8px; color: #b8860b; margin-top: 2px;">Cost: $@(totalCaseCost.ToString("F2")) /Case</div>
                                                <div style="font-size: 7px; color: #b8860b;">($@(unitCost.ToString("F2")) /Unit)</div>
                                            }
                                        }
                                        else if (basePrice > 0)
                                        {
                                            <div style="font-weight: bold;">$@(basePrice.ToString("F2")) /Unit</div>
                                            @if (product.ProductCost > 0)
                                            {
                                                <div style="font-size: 8px; color: #b8860b; margin-top: 2px;">Cost: $@(product.ProductCost.ToString("F2")) /Unit</div>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }

            @* Display Product Attributes (for products without combinations) *@
            @if (!combinations.Any() && attributeMappings.Any())
            {
                // Separate weight-based conversion attributes from regular attributes
                var weightBasedConversions = new List<dynamic>();
                var regularAttributeValueCells = new List<dynamic>();

                foreach (var mapping in attributeMappings.OrderBy(m => m.DisplayOrder))
                {
                    if (mapping.ProductAttributeValues?.Any() == true)
                    {
                        foreach (var value in mapping.ProductAttributeValues.OrderBy(v => v.DisplayOrder))
                        {
                            var cellData = new {
                                Mapping = mapping,
                                Value = value,
                                FinalPrice = value.OverriddenPrice ?? (product.Price + value.PriceAdjustment)
                            };

                            if (value.AttributeValueTypeId == AttributeValueType.WeightBasedConversion)
                            {
                                weightBasedConversions.Add(cellData);
                            }
                            else
                            {
                                regularAttributeValueCells.Add(cellData);
                            }
                        }
                    }
                }

                @* Display Weight-Based Conversion Attributes *@
                @if (weightBasedConversions.Any())
                {
                    <div style="font-weight: bold; font-size: 11px; color: #1976d2; margin-bottom: 5px; margin-top: 10px;">
                        Available Package Sizes
                    </div>
                    <table class="weight-conversion-table">
                        <thead>
                            <tr>
                                <th style="width: 25%;">Package Size</th>
                                <th style="width: 25%;">Conversion Ratio</th>
                                <th style="width: 25%;">Package Price</th>
                                <th style="width: 25%;">Per-Unit Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var conversion in weightBasedConversions)
                            {
                                @{
                                    var packagePrice = conversion.FinalPrice;
                                    var conversionRatio = conversion.Value.Quantity;
                                    var perUnitPrice = conversionRatio > 0 ? packagePrice / conversionRatio : 0;
                                    var packageCost = conversion.Value.Cost > 0 ? conversion.Value.Cost : 0;
                                    var perUnitCost = conversionRatio > 0 && packageCost > 0 ? packageCost / conversionRatio : 0;
                                }
                                <tr>
                                    <td>
                                        <div style="font-weight: bold; font-size: 10px; color: #1976d2;">@conversion.Value.Name</div>
                                        @if (conversion.Mapping.IsRequired)
                                        {
                                            <div style="font-size: 7px; color: #d32f2f;">*Required</div>
                                        }
                                    </td>
                                    <td style="text-align: center;">
                                        <div style="font-size: 9px; font-weight: bold;">@(conversionRatio.ToString("F0")) units</div>
                                        <div style="font-size: 7px; color: #666;">per package</div>
                                    </td>
                                    <td style="text-align: right;">
                                        @if (conversion.Value.AllowSample)
                                        {
                                            <div style="font-weight: bold; color: #2e7d32;">Sample - Free</div>
                                        }
                                        else if (packagePrice > 0)
                                        {
                                            <div style="font-weight: bold; color: #1976d2;">$@(packagePrice.ToString("F2"))</div>
                                            <div style="font-size: 7px; color: #666;">per @conversion.Value.Name.ToLower()</div>
                                            @if (packageCost > 0)
                                            {
                                                <div style="font-size: 7px; color: #f57c00;">Cost: $@(packageCost.ToString("F2"))</div>
                                            }
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        @if (!conversion.Value.AllowSample && perUnitPrice > 0)
                                        {
                                            <div style="font-weight: bold; font-size: 8px;">$@(perUnitPrice.ToString("F4"))</div>
                                            <div style="font-size: 7px; color: #666;">per unit</div>
                                            @if (perUnitCost > 0)
                                            {
                                                <div style="font-size: 7px; color: #f57c00;">$@(perUnitCost.ToString("F4"))</div>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @* Regular Attribute Values *@
                // Chunk the regular attribute values to prevent table overflow - max 20 per table
                const int maxAttributeValuesPerTable = 20;
                var attributeValueChunks = new List<List<dynamic>>();

                if (regularAttributeValueCells.Count > maxAttributeValuesPerTable)
                {
                    for (int i = 0; i < regularAttributeValueCells.Count; i += maxAttributeValuesPerTable)
                    {
                        attributeValueChunks.Add(regularAttributeValueCells.Skip(i).Take(maxAttributeValuesPerTable).ToList());
                    }
                }
                else if (regularAttributeValueCells.Any())
                {
                    attributeValueChunks.Add(regularAttributeValueCells);
                }

                @for (int chunkIndex = 0; chunkIndex < attributeValueChunks.Count; chunkIndex++)
                {
                    var chunk = attributeValueChunks[chunkIndex];

                    @if (chunkIndex > 0)
                    {
                        <div style="page-break-before: always;"></div>
                        <div class="product-header" style="margin-top: 0;">
                            <div class="product-title">@product.Name (continued)</div>
                            <div class="product-sku">Part @(chunkIndex + 1) of @attributeValueChunks.Count</div>
                        </div>
                    }

                    <table class="simple-attributes-table">
                        <thead>
                            <tr>
                                <th style="width: 50%;">Product Variant</th>
                                <th style="width: 25%;">Details</th>
                                <th style="width: 25%;">Price Information</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cell in chunk)
                            {
                                <tr>
                                    <td>
                                        <div style="font-weight: bold; font-size: 9px;">@cell.Value.Name</div>
                                        @* @if (cell.Mapping.IsRequired)
                                        {
                                            <div style="font-size: 7px; color: #d32f2f;">*Required</div>
                                        }
                                        @if (cell.Value.AllowSample)
                                        {
                                            <div style="font-size: 7px; color: #2e7d32;">Sample Available</div>
                                        } *@
                                    </td>
                                    <td>
                                        @if (cell.Value.PriceAdjustment != 0)
                                        {
                                            <div style="font-size: 8px;">
                                                Price Adj: @(cell.Value.PriceAdjustment > 0 ? "+" : "")@cell.Value.PriceAdjustment.ToString("F2")
                                            </div>
                                        }
                                        @if (cell.Value.WeightAdjustment != 0)
                                        {
                                            <div style="font-size: 8px;">
                                                Weight: @(cell.Value.WeightAdjustment > 0 ? "+" : "")@cell.Value.WeightAdjustment.ToString("F2")
                                            </div>
                                        }
                                        @if (cell.Value.Cost > 0)
                                        {
                                            <div style="font-size: 8px;">Cost: $@cell.Value.Cost.ToString("F2")</div>
                                        }
                                        @if (cell.Value.Quantity > 0)
                                        {
                                            <div style="font-size: 8px;">Qty: @cell.Value.Quantity.ToString("F0")</div>
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        @if (cell.Value.AllowSample)
                                        {
                                            <div style="font-weight: bold; color: #2e7d32;">Sample - Free</div>
                                        }
                                        else if (cell.FinalPrice > 0)
                                        {
                                            <div style="font-weight: bold;">$@(cell.FinalPrice.ToString("F2")) /Unit</div>
                                            @* @if (cell.Value.OverriddenPrice != null)
                                            {
                                                <div style="font-size: 7px; color: #666;">Override Price</div>
                                            } *@
                                            if (cell.Value.PriceAdjustment != 0)
                                            {
                                                <div style="font-size: 7px; color: #666;">
                                                    Base: $@product.Price.ToString("F2")
                                                </div>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }

            @* Fallback for products with no combinations and no attributes *@
            @if (!combinations.Any() && !attributeMappings.Any() && product.Price > 0)
            {
                // Check if product has any combinations with case sizes to determine pricing structure
                var allCombinations = product.ProductAttributeCombinations?.ToList() ?? new List<ProductAttributeCombination>();
                var hasCaseSizing = allCombinations.Any(c => c.CaseSize > 0);
                var avgCaseSize = hasCaseSizing ? allCombinations.Where(c => c.CaseSize > 0).Average(c => c.CaseSize) : 0;
                <table class="simple-attributes-table">
                    <tbody>
                        <tr>
                            <td style="width: 60%;">
                                <div style="font-weight: bold;">Standard Product</div>
                                @if (hasCaseSizing)
                                {
                                    <div style="font-size: 8px; color: #666;">Available in case quantities</div>
                                    <div style="font-size: 8px; color: #666;">Avg case size: @(avgCaseSize.ToString("F0")) units</div>
                                }
                                else
                                {
                                    <div style="font-size: 8px; color: #666;">Unit pricing only</div>
                                }
                            </td>
                            <td style="width: 40%; text-align: right;">
                                <div style="font-weight: bold;">$@(product.Price.ToString("F2")) /Unit</div>
                                @if (hasCaseSizing && avgCaseSize > 0)
                                {
                                    <div style="font-size: 8px; color: #666; margin-top: 2px;">
                                        Est. case price: $@((product.Price * avgCaseSize).ToString("F2"))
                                    </div>
                                }
                                @if (product.ProductCost > 0)
                                {
                                    <div style="font-size: 8px; color: #b8860b; margin-top: 2px;">
                                        Cost: $@(product.ProductCost.ToString("F2")) /Unit
                                    </div>
                                    @if (hasCaseSizing && avgCaseSize > 0)
                                    {
                                        <div style="font-size: 7px; color: #b8860b;">
                                            Est. case cost: $@((product.ProductCost * avgCaseSize).ToString("F2"))
                                        </div>
                                    }
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            }
        </div>
    }

    <div class="footer">
        Product details, pricing, and case information listed are valid as of the date above and may change.<br/>
        Prices shown are per unit or per case as indicated. Cost information is provided for reference only.<br/>
        This catalog is strictly intended for clients possessing the proper license to purchase these products.
    </div>
</body>
</html>