@model OrderModel

<vc:admin-widget widget-zone="order_details_fulfillment_top" additional-data="Model"/>
<div class="panel-body">
    <div class="card">
        <div class="card-header">
            <h5>@Loc["Admin.Orders.Fulfillment"]</h5>
        </div>
        <div class="card-body">
            <div class="form-horizontal">
                <div class="form-body">
                    <div class="note note-info">
                        @Loc["Admin.Orders.Fulfillment.Info"]
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>
                                        @Loc["Admin.Orders.Fulfillment.SelectAll"]
                                        <input type="checkbox" id="select-all-items" />
                                    </th>
                                    <th>
                                        @Loc["Admin.Orders.Products.Picture"]
                                    </th>
                                    <th>
                                        @Loc["Admin.Orders.Products.ProductName"]
                                    </th>
                                    <th>
                                        @Loc["Admin.Orders.Products.SKU"]
                                    </th>
                                    <th>
                                        @Loc["Admin.Orders.Products.Quantity"]
                                    </th>
                                    <th>
                                        @Loc["Admin.Orders.Fulfillment.Status"]
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            @if (item.OpenQty > 0)
                                            {
                                                <input type="checkbox" name="packed_items" value="@item.Id" class="packed-item-checkbox" data-orderitemid="@item.Id" />
                                            }
                                        </td>
                                        <td>
                                            <img src="@item.PictureThumbnailUrl" alt="" title="" />
                                        </td>
                                        <td>
                                            <div>
                                                <em>
                                                    <a href="@Url.Action("Edit", "Product", new { id = item.ProductId, area = Constants.AreaAdmin })">@item.ProductName</a>
                                                </em>
                                                @if (!string.IsNullOrEmpty(item.AttributeInfo))
                                                {
                                                    <p>
                                                        @Html.Raw(item.AttributeInfo)
                                                    </p>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            @item.Sku
                                        </td>
                                        <td>
                                            @item.OpenQty
                                        </td>
                                        <td class="fulfillment-status">
                                            @if (item.OpenQty == 0)
                                            {
                                                <span class="badge badge-success">@Loc["Admin.Orders.Fulfillment.Completed"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning">@Loc["Admin.Orders.Fulfillment.Pending"]</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="form-group row">
                <div class="col-md-4">
                    <label class="control-label">@Loc["Admin.Orders.Fulfillment.TargetDeliveryDate"]</label>
                    <input type="date" id="target-delivery-date" class="form-control" value="@(Model.GetUserFieldFromEntity<string>("TargetDeliveryDate"))" />
                </div>
                <div class="col-md-8 mt-4">
                    <button type="button" id="create-shipment" class="btn btn-success" disabled>@Loc["Admin.Orders.Fulfillment.CreateShipment"]</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    // Function to check if all items are selected and enable/disable the button
    function checkAllItemsSelected() {
        var totalItemsWithOpenQty = $(".packed-item-checkbox").length;
        var selectedItems = $(".packed-item-checkbox:checked").length;
        
        // Only enable the button if there are items to ship and all of them are selected
        if (totalItemsWithOpenQty > 0 && selectedItems === totalItemsWithOpenQty) {
            $("#create-shipment").prop("disabled", false);
        } else {
            $("#create-shipment").prop("disabled", true);
        }
        
        // If there are no items with open quantity at all, enable the button but add a note
        if (totalItemsWithOpenQty === 0) {
            $("#create-shipment").prop("disabled", false);
        }
    }
    
    // Run check when page loads
    checkAllItemsSelected();
    
    // Select all checkbox logic
    $("#select-all-items").change(function() {
        $(".packed-item-checkbox").prop("checked", $(this).prop("checked"));
        checkAllItemsSelected();
    });
    
    // Individual checkbox change
    $(".packed-item-checkbox").change(function() {
        checkAllItemsSelected();
    });
    
    // Create shipment button
    $("#create-shipment").click(function() {
        var selectedItems = [];
        $(".packed-item-checkbox:checked").each(function() {
            selectedItems.push($(this).data("orderitemid"));
        });
        
        if (selectedItems.length === 0) {
            alert('@Loc["Admin.Orders.Fulfillment.NoItemsSelected"]');
            return;
        }
        
        var targetDeliveryDate = $("#target-delivery-date").val();
        
        $.ajax({
            cache: false,
            type: "POST",
            url: "@Html.Raw(Url.Action("CreateFulfillmentShipment", "Order", new { orderId = Model.Id, area = Constants.AreaAdmin }))",
            data: addAntiForgeryToken({ 
                orderItemIds: selectedItems.join(","),
                targetDeliveryDate: targetDeliveryDate
            }),
            success: function(data) {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.error);
                }
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert('Error occurred. Please try again.');
            }
        });
    });
});
</script>

<vc:admin-widget widget-zone="order_details_fulfillment_bottom" additional-data="Model"/>