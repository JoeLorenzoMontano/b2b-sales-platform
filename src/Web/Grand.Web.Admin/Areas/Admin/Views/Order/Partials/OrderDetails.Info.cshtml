@using System.Text.Encodings.Web
@using Grand.Business.Core.Interfaces.Checkout.Orders
@using Grand.Business.Core.Interfaces.Customers
@using Grand.Domain.Payments
@using Grand.Domain.Tax
@using Constants = Grand.SharedUIResources.Constants
@model OrderModel
@inject IOrderTagService orderTagService
@inject ISalesEmployeeService _salesEmployeeService

@{
    var salesEmployees = await _salesEmployeeService.GetAll();
}

<link rel="stylesheet" type="text/css" asp-src="@(Constants.WwwRoot)/administration/tagEditor/jquery.tag-editor.css"/>
<script asp-location="Footer" asp-src="@(Constants.WwwRoot)/administration/tagEditor/jquery.tag-editor.min.js"></script>
<script asp-location="Footer" asp-src="@(Constants.WwwRoot)/administration/tagEditor/jquery.caret.min.js"></script>

@{
    var orderTagsSB = new System.Text.StringBuilder();
    if (Model.OrderTags?.Any() == true)
    {
        orderTagsSB.AppendLine("var initialOrderTags = [");
        foreach (var tag in Model.OrderTags)
        {
            var safeTag = tag.ToString().Replace("'", "\\'");
            orderTagsSB.AppendLine($"'{safeTag}',");
        }
        orderTagsSB.AppendLine("];");
    }
    else
    {
        orderTagsSB.AppendLine("var initialOrderTags = [];");
    }
}

<!-- Clean 3-Column Bootstrap Layout -->
<div class="container-fluid">
    <div class="row">
        <!-- Seller Section -->
        <div class="col-lg-4 col-md-6 col-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Seller</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6>@Model.StoreName</h6>
                    </div>
                    
                    <!-- Sales Employee -->
                    <div class="mb-3">
                        <label class="form-label"><strong>Customer Default Rep:</strong></label>
                        <select name="salesEmployeeId" class="form-control" id="salesEmployeeIdSelect">
                            <option value="">Select</option>
                            @foreach (var salesEmployee in salesEmployees)
                            {
                                if (salesEmployee.Id == Model.SalesEmployeeId)
                                {
                                    <option value="@salesEmployee.Id" selected="selected">@salesEmployee.Name</option>
                                }
                                else
                                {
                                    <option value="@salesEmployee.Id">@salesEmployee.Name</option>
                                }
                            }
                        </select>
                        <button type="button" class="btn btn-sm btn-success mt-2" id="submitSalesEmployee">Save</button>
                    </div>
                    
                    <!-- Impersonation -->
                    @if (!string.IsNullOrEmpty(Model.ImpersonatedByEmployeeId))
                    {
                        <div class="mb-3">
                            <label class="form-label"><strong>Impersonated By:</strong></label>
                            <div>
                                @if (!string.IsNullOrEmpty(Model.ImpersonatedByEmployeeName))
                                {
                                    <a href="@Url.Action("Edit", "Customer", new { id = Model.ImpersonatedByEmployeeId })" class="text-primary">@Model.ImpersonatedByEmployeeName</a>
                                }
                                else
                                {
                                    <span>@Model.ImpersonatedByEmployeeId</span>
                                }
                            </div>
                        </div>
                    }
                    
                    <!-- Payment Method -->
                    <div class="mb-2">
                        <label class="form-label"><strong>Payment Method:</strong></label>
                        <div>@Model.PaymentMethod</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Buyer & Delivery Section -->
        <div class="col-lg-4 col-md-6 col-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Buyer & Delivery</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        @Html.ActionLink(Model.CustomerInfo, "Edit", "Customer", new { id = Model.CustomerId }, new { @class = "text-primary" })
                    </div>
                    
                    
                    @if (!string.IsNullOrEmpty(Model.VatNumber))
                    {
                        <div class="mb-3">
                            <label class="form-label"><strong>VAT Number:</strong></label>
                            <div>@Model.VatNumber</div>
                        </div>
                    }
                    
                    <!-- Moved from Order Information column -->
                    <div class="mb-3">
                        <label class="form-label"><strong>Payment Status:</strong></label>
                        <div>
                            @{
                                string labelStatus = "secondary";
                                switch (Model.PaymentStatus.ToLower())
                                {
                                    case "paid":
                                        labelStatus = "success";
                                        break;
                                    case "pending":
                                        labelStatus = "warning";
                                        break;
                                    case "cancelled":
                                    case "refunded":
                                        labelStatus = "danger";
                                        break;
                                }
                            }
                            @if (string.IsNullOrEmpty(Model.PaymentTransactionId))
                            {
                                <a class="btn btn-primary btn-sm" href="@Url.Action("CreatePaymentTransaction", "Order", new { id = Model.Id })">
                                    <i class="fa fa-plus"></i> Create Payment
                                </a>
                            }
                            else
                            {
                                <a class="btn btn-@labelStatus btn-sm" href="@Url.Action("Edit", "PaymentTransaction", new { id = Model.PaymentTransactionId })">
                                    @Model.PaymentStatus
                                </a>
                            }
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label"><strong>Shipping Status:</strong></label>
                        <div>
                            @{
                                string shippingLabelStatus = "secondary";
                                switch (Model.ShippingStatus.ToLower())
                                {
                                    case "shipped":
                                    case "delivered":
                                        shippingLabelStatus = "success";
                                        break;
                                    case "not yet shipped":
                                    case "processing":
                                        shippingLabelStatus = "warning";
                                        break;
                                    case "returned":
                                        shippingLabelStatus = "danger";
                                        break;
                                }

                                // Determine shipment tab index (Info=0, Addresses=1, Shipments=2 if shippable, otherwise Products=2)
                                var shipmentTabIndex = Model.IsShippable ? 2 : -1;
                            }
                            @if (Model.IsShippable && Model.CanAddNewShipments)
                            {
                                <a class="btn btn-primary btn-sm" href="@Url.Action("AddShipment", "Shipment", new { orderId = Model.Id })">
                                    <i class="fa fa-plus"></i> Create Shipment
                                </a>
                            }
                            else if (Model.IsShippable)
                            {
                                <a class="btn btn-@shippingLabelStatus btn-sm" href="#" onclick="$('a[href=\'#tab-@shipmentTabIndex\']').click(); return false;">
                                    @Model.ShippingStatus
                                </a>
                            }
                            else
                            {
                                <span class="badge badge-@shippingLabelStatus">@Model.ShippingStatus</span>
                            }
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label"><strong>Order Total:</strong></label>
                        <div><strong>@Model.OrderTotal</strong></div>
                    </div>
                    
                    <!-- Address Information -->
                    @{
                        var addressesAreSame = Model.BillingAddress != null && Model.ShippingAddress != null &&
                                               Model.BillingAddress.FirstName == Model.ShippingAddress.FirstName &&
                                               Model.BillingAddress.LastName == Model.ShippingAddress.LastName &&
                                               Model.BillingAddress.Address1 == Model.ShippingAddress.Address1 &&
                                               Model.BillingAddress.City == Model.ShippingAddress.City;
                    }
                    
                    @if (addressesAreSame && Model.BillingAddress != null)
                    {
                        <div class="mb-3">
                            <label class="form-label"><strong>Billing & Shipping Address:</strong></label>
                            <div class="border p-2 bg-light">
                                @if (!string.IsNullOrEmpty(Model.BillingAddress.FirstName) || !string.IsNullOrEmpty(Model.BillingAddress.LastName))
                                {
                                    <div><strong>@Model.BillingAddress.FirstName @Model.BillingAddress.LastName</strong></div>
                                }
                                @if (!string.IsNullOrEmpty(Model.BillingAddress.Company))
                                {
                                    <div>@Model.BillingAddress.Company</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.BillingAddress.Address1))
                                {
                                    <div>@Model.BillingAddress.Address1</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.BillingAddress.City))
                                {
                                    <div>@Model.BillingAddress.City, @Model.BillingAddress.ZipPostalCode</div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (Model.ShippingAddress != null)
                        {
                            <div class="mb-3">
                                <label class="form-label"><strong>Shipping Address:</strong></label>
                                <div class="border p-2" style="background-color: #e3f2fd;">
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.FirstName) || !string.IsNullOrEmpty(Model.ShippingAddress.LastName))
                                    {
                                        <div><strong>@Model.ShippingAddress.FirstName @Model.ShippingAddress.LastName</strong></div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.Company))
                                    {
                                        <div>@Model.ShippingAddress.Company</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.Address1))
                                    {
                                        <div>@Model.ShippingAddress.Address1</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ShippingAddress.City))
                                    {
                                        <div>@Model.ShippingAddress.City, @Model.ShippingAddress.ZipPostalCode</div>
                                    }
                                </div>
                            </div>
                        }
                        
                        @if (Model.BillingAddress != null)
                        {
                            <div class="mb-3">
                                <label class="form-label"><strong>Billing Address:</strong></label>
                                <div class="border p-2" style="background-color: #e8f5e8;">
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.FirstName) || !string.IsNullOrEmpty(Model.BillingAddress.LastName))
                                    {
                                        <div><strong>@Model.BillingAddress.FirstName @Model.BillingAddress.LastName</strong></div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.Company))
                                    {
                                        <div>@Model.BillingAddress.Company</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.Address1))
                                    {
                                        <div>@Model.BillingAddress.Address1</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BillingAddress.City))
                                    {
                                        <div>@Model.BillingAddress.City, @Model.BillingAddress.ZipPostalCode</div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    
                    @if (Model.PickupAddress != null)
                    {
                        <div class="mb-3">
                            <label class="form-label"><strong>Pickup Address:</strong></label>
                            <div class="border p-2" style="background-color: #fff3cd;">
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.FirstName) || !string.IsNullOrEmpty(Model.PickupAddress.LastName))
                                {
                                    <div><strong>@Model.PickupAddress.FirstName @Model.PickupAddress.LastName</strong></div>
                                }
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.Company))
                                {
                                    <div>@Model.PickupAddress.Company</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.Address1))
                                {
                                    <div>@Model.PickupAddress.Address1</div>
                                }
                                @if (!string.IsNullOrEmpty(Model.PickupAddress.City))
                                {
                                    <div>@Model.PickupAddress.City, @Model.PickupAddress.ZipPostalCode</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <!-- Order Information Section -->
        <div class="col-lg-4 col-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Order Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Order number:</strong></label>
                            <div>@Model.OrderNumber</div>
                        </div>
                        
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Order status:</strong></label>
                            <div><span class="badge badge-warning">@Model.OrderStatus</span></div>
                        </div>
                        
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Order created:</strong></label>
                            <div>@Html.DisplayFor(model => model.CreatedOn)</div>
                        </div>
                        
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Currency:</strong></label>
                            <div>@Model.CurrencyCode @if (Model.CurrencyRate != 1) { <text>(@Model.CurrencyRate)</text> }</div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(Model.Code))
                        {
                            <div class="col-12 mb-3">
                                <label class="form-label"><strong>Code:</strong></label>
                                <div>@Model.Code</div>
                            </div>
                        }
                        
                        
                        @if (!string.IsNullOrEmpty(Model.RefundedAmount))
                        {
                            <div class="col-12 mb-3">
                                <label class="form-label"><strong>Refunded:</strong></label>
                                <div>@Model.RefundedAmount</div>
                            </div>
                        }
                        
                        <div class="col-12 mb-3">
                            <label class="form-label"><strong>Profit:</strong></label>
                            <div>@Model.Profit</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Products Section -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Order Products (@Model.Items.Count items)</h5>
                    <button class="btn btn-sm btn-outline-primary" type="button" data-toggle="collapse" data-target="#productsCollapse">
                        <i class="fa fa-chevron-down"></i> Toggle
                    </button>
                </div>
                <div class="collapse show" id="productsCollapse">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Product</th>
                                        <th class="text-center">Quantity</th>
                                        <th class="text-right">Price</th>
                                        <th class="text-right">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < Model.Items.Count; i++)
                                    {
                                        var item = Model.Items[i];
                                        <input asp-for="@Model.Items[i].Id" type="hidden"/>
                                        <tr>
                                            <td>@(i + 1)</td>
                                            <td>
                                                <a href="@Url.Action("Edit", "Product", new { id = item.ProductId })" class="text-primary">
                                                    @item.ProductName
                                                </a>
                                                @if (!string.IsNullOrEmpty(item.AttributeInfo))
                                                {
                                                    <br><small>@Html.Raw(item.AttributeInfo)</small>
                                                }
                                                @if (!string.IsNullOrEmpty(item.Sku))
                                                {
                                                    <br><small class="text-muted">SKU: @item.Sku</small>
                                                }
                                                @if (!string.IsNullOrEmpty(item.WarehouseName))
                                                {
                                                    <br><small class="text-muted">Warehouse: @item.WarehouseName</small>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (item.CaseSize > 0)
                                                {
                                                    <div class="quantity-unit-case-wrapper" data-case-size="@item.CaseSize">
                                                        <div class="d-flex align-items-center justify-content-center">
                                                            <input type="number"
                                                                   class="form-control inline-edit-field quantity-display-input"
                                                                   data-item-id="@item.Id"
                                                                   value="@item.Quantity"
                                                                   style="width:60px; margin-right: 5px;"
                                                                   min="1"/>
                                                            <select class="form-control unit-case-selector"
                                                                    data-item-id="@item.Id"
                                                                    style="width:70px;">
                                                                <option value="unit">Unit</option>
                                                                <option value="case">Case</option>
                                                            </select>
                                                        </div>
                                                        <input asp-for="@Model.Items[i].Quantity" type="hidden" class="actual-quantity-input"/>
                                                        <small class="text-muted d-block mt-1">@item.CaseSize per case</small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <input asp-for="@Model.Items[i].Quantity" type="number" class="form-control inline-edit-field" style="width:100%; max-width:80px; margin: 0 auto;" min="1"/>
                                                }
                                            </td>
                                            <td class="text-right">
                                                <input asp-for="@Model.Items[i].UnitPriceExclTaxValue" class="form-control inline-edit-field" style="width:100%; max-width:120px; margin-left: auto;"/>
                                            </td>
                                            <td class="text-right">
                                                <span class="subtotal-display" data-order-item-id="@item.Id">
                                                    @switch (Model.TaxDisplayType)
                                                    {
                                                        case TaxDisplayType.ExcludingTax:
                                                            @item.SubTotalExclTax
                                                            break;
                                                        case TaxDisplayType.IncludingTax:
                                                            @item.SubTotalInclTax
                                                            break;
                                                    }
                                                </span>
                                                <div class="auto-save-status" id="save-status-@item.Id" style="display:none; margin-top: 4px;">
                                                    <small class="text-muted">
                                                        <i class="fa fa-spinner fa-spin"></i> Saving...
                                                    </small>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-info">
                                        <th colspan="4" class="text-right">Total:</th>
                                        <th class="text-right"><span id="total-amount">@Model.OrderTotal</span></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- Add Products Section -->
                        <div class="add-products-section mt-3">
                            <div class="x_panel light form-fit">
                                <div class="x_title">
                                    <div class="caption">
                                        <i class="fa fa-plus"></i>
                                        Add Products to Order
                                    </div>
                                </div>
                                <div class="x_content form">
                                    @await Component.InvokeAsync("ProductSearchAdd", new { contextId = Model.Id, contextType = "order" })
                                </div>
                            </div>
                        </div>

                        <!-- Order Summary -->
                        <div class="row mt-4">
                            <div class="col-lg-6 offset-lg-6">
                                <div class="card">
                                    <div class="card-body">
                                        @if (Model.TaxDisplayType == TaxDisplayType.IncludingTax)
                                        {
                                            <div class="d-flex justify-content-between">
                                                <span>Subtotal:</span>
                                                <span id="summary-subtotal">@Model.OrderSubtotalInclTax</span>
                                            </div>
                                        }
                                        @if (Model.TaxDisplayType == TaxDisplayType.ExcludingTax)
                                        {
                                            <div class="d-flex justify-content-between">
                                                <span>Subtotal:</span>
                                                <span id="summary-subtotal">@Model.OrderSubtotalExclTax</span>
                                            </div>
                                        }
                                        @if (Model.TaxDisplayType == TaxDisplayType.IncludingTax)
                                        {
                                            <div class="d-flex justify-content-between">
                                                <span>Shipping:</span>
                                                <span id="summary-shipping">@Model.OrderShippingInclTax</span>
                                            </div>
                                        }
                                        @if (Model.TaxDisplayType == TaxDisplayType.ExcludingTax)
                                        {
                                            <div class="d-flex justify-content-between">
                                                <span>Shipping:</span>
                                                <span id="summary-shipping">@Model.OrderShippingExclTax</span>
                                            </div>
                                        }
                                        @if (Model.DisplayTax)
                                        {
                                            <div class="d-flex justify-content-between">
                                                <span>Tax:</span>
                                                <span id="summary-tax">@Model.Tax</span>
                                            </div>
                                        }
                                        <hr>
                                        <div class="d-flex justify-content-between font-weight-bold">
                                            <span>Total:</span>
                                            <span id="summary-total">@Model.OrderTotal</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* ProductSearchAdd component integration with Order Info tab - Transparent styling */
.add-products-section {
    background: transparent;
    width: 100%;
    box-sizing: border-box;
}

.add-products-section .x_panel {
    margin-bottom: 0;
    border: none;
    box-shadow: none;
    background: transparent;
}

.add-products-section .x_title {
    background: transparent;
    padding: 10px 15px;
    margin-bottom: 0;
}

.add-products-section .x_title .caption {
    color: white;
    font-weight: 600;
    font-size: 1em;
}

.add-products-section .x_content {
    padding: 10px;
    background: transparent;
    width: 100%;
    box-sizing: border-box;
}

/* Ensure Bootstrap grid stays within bounds */
.add-products-section .row {
    margin-left: 0;
    margin-right: 0;
    width: 100%;
}

.add-products-section [class*="col-"] {
    padding-left: 8px;
    padding-right: 8px;
}

/* Ensure form controls don't overflow */
.add-products-section .form-control,
.add-products-section .form-group {
    max-width: 100%;
    box-sizing: border-box;
}

/* Unit/Case quantity selector styling */
.quantity-unit-case-wrapper {
    display: inline-block;
}

.quantity-unit-case-wrapper .d-flex {
    gap: 4px;
}

.quantity-unit-case-wrapper .quantity-display-input {
    text-align: center;
}

.quantity-unit-case-wrapper .unit-case-selector {
    font-size: 13px;
    padding: 4px 8px;
}

.quantity-unit-case-wrapper small {
    font-size: 11px;
    text-align: center;
}
</style>

<script>
$(document).ready(function() {
    // Initialize order tags
    @Html.Raw(orderTagsSB.ToString())
    $("#OrderTags").tagEditor({
        autocomplete: {
            delay: 0,
            position: { collision: 'flip' },
            source: initialOrderTags
        },
        delimiter: ',',
        placeholder: 'Enter tags...'
    });

    // Sales employee functionality
    $("#salesEmployeeIdSelect").change(function() {
        $("#submitSalesEmployee").removeClass("btn-success").addClass("btn-primary");
    });
    
    $("#submitSalesEmployee").click(function(e) {
        e.preventDefault();
        
        var orderId = '@Model.Id';
        var salesEmployeeId = $("#salesEmployeeIdSelect").val();
        
        $.ajax({
            url: '@Url.Action("SaveSalesEmployee", "Order", new { area = "Admin" })',
            type: 'POST',
            data: {
                id: orderId,
                salesEmployeeId: salesEmployeeId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(result) {
                if (result.success) {
                    $("#submitSalesEmployee").removeClass("btn-primary").addClass("btn-success");
                    showSuccessMessage("Sales representative updated successfully");
                } else {
                    showErrorMessage(result.message || "Error saving sales employee");
                }
            },
            error: function() {
                showErrorMessage("Error saving sales employee. Please try again.");
            }
        });
    });
    
    // Toggle products collapse
    $('#productsCollapse').on('show.bs.collapse', function () {
        $(this).prev().find('i').removeClass('fa-chevron-down').addClass('fa-chevron-up');
    });
    
    $('#productsCollapse').on('hide.bs.collapse', function () {
        $(this).prev().find('i').removeClass('fa-chevron-up').addClass('fa-chevron-down');
    });

    // Check shipments on page load for ProductSearchAdd component
    checkShipmentsForInfoTab();

    // Initialize unit/case quantity handlers
    initializeUnitCaseQuantityHandlers();
});

function showSuccessMessage(message) {
    var alert = $('<div class="alert alert-success alert-dismissible fade show mt-2" role="alert">' + 
                  message + 
                  '<button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>' +
                  '</div>');
    $("#salesEmployeeIdSelect").after(alert);
    setTimeout(function() {
        alert.fadeOut();
    }, 3000);
}

function showErrorMessage(message) {
    var alert = $('<div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">' + 
                  message + 
                  '<button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>' +
                  '</div>');
    $("#salesEmployeeIdSelect").after(alert);
    setTimeout(function() {
        alert.fadeOut();
    }, 5000);
}

function toggleChangeOrderStatus(editmode) {
    if (editmode) {
        $('#pnlChangeOrderStatus').show();
        $('#btnChangeOrderStatus').hide();
    } else {
        $('#pnlChangeOrderStatus').hide();
        $('#btnChangeOrderStatus').show();
    }
}

function toggleOrderTotals(editmode) {
    if (editmode) {
        $('#trEditOrderTotals').show();
        $('#btnEditOrderTotals').hide();
        $('#btnSaveOrderTotals').show();
        $('#btnCancelOrderTotals').show();
    } else {
        $('#trEditOrderTotals').hide();
        $('#btnEditOrderTotals').show();
        $('#btnSaveOrderTotals').hide();
        $('#btnCancelOrderTotals').hide();
    }
}

// Function expected by the ProductSearchAdd component in Info tab
function refreshCurrentProductsGrid() {
    // Info tab is index 0 in the order edit tabstrip
    var infoTabIndex = 0;

    // Set URL hash to preserve Info tab state after reload
    if (window.location.hash !== '#tab-' + infoTabIndex) {
        window.location.hash = '#tab-' + infoTabIndex;
    }

    // Reload page with hash preserved - admin-tabstrip will restore the active tab
    window.location.reload();
}

// Check for existing shipments and hide ProductSearchAdd if shipments exist or order is in fulfillment
var isCheckingShipmentsForInfoTab = false; // Flag to prevent multiple simultaneous calls

function checkShipmentsForInfoTab() {
    // Prevent multiple simultaneous executions
    if (isCheckingShipmentsForInfoTab) {
        return;
    }
    isCheckingShipmentsForInfoTab = true;

    var isVerifiedOrder = @Json.Serialize(Model.IsVerifiedOrder);

    if (isVerifiedOrder) {
        // Remove any existing warnings first, then hide ProductSearchAdd section for verified orders (in fulfillment queue)
        $('.shipment-warning').remove();
        $('.add-products-section').hide();
        $('.add-products-section').after(
            '<div class="shipment-warning alert alert-warning mt-3">' +
            '<i class="fa fa-warning"></i> ' +
            'Cannot add products to orders in fulfillment queue. ' +
            '<button type="button" class="btn btn-primary btn-sm ml-2" onclick="sendToReverificationFromInfoTab(\'@Model.Id\')">' +
            '<i class="fa fa-undo"></i> Send to Reverification' +
            '</button>' +
            '</div>'
        );
        isCheckingShipmentsForInfoTab = false; // Reset flag
        return;
    }

    $.ajax({
        url: "@Html.Raw(Url.Action("ShipmentsByOrder", "Shipment", new { orderId = Model.Id, area = Grand.Web.Admin.Extensions.Constants.AreaAdmin }))",
        type: "POST",
        data: { __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
        dataType: "json",
        success: function(data) {
            if (data && data.Total > 0) {
                // Remove any existing warnings first, then hide ProductSearchAdd section and show warning
                $('.shipment-warning').remove();
                $('.add-products-section').hide();
                $('.add-products-section').after(
                    '<div class="shipment-warning alert alert-warning mt-3">' +
                    '<i class="fa fa-warning"></i> ' +
                    'Cannot add products when shipments exist. Please delete existing shipments first to add new products.' +
                    '</div>'
                );
            } else {
                // Show ProductSearchAdd section if no shipments and not verified
                $('.add-products-section').show();
                $('.shipment-warning').remove();
            }
            isCheckingShipmentsForInfoTab = false; // Reset flag on success
        },
        error: function() {
            // On error, show ProductSearchAdd (fail safe) only if not verified
            if (!isVerifiedOrder) {
                $('.add-products-section').show();
            }
            isCheckingShipmentsForInfoTab = false; // Reset flag on error
        }
    });
}

function sendToReverificationFromInfoTab(orderId) {
    if (!confirm('Are you sure you want to send this order back to reverification? This will delete any existing shipments.')) {
        return;
    }

    $.ajax({
          url: "@Html.Raw(Url.Action("SendToReverification", "Order", new { area = Grand.Web.Admin.Extensions.Constants.AreaAdmin }))",
        type: "POST",
        data: addAntiForgeryToken({ orderId: orderId }),
        dataType: "json",
        success: function(result) {
            if (result.success) {
                // Refresh the page to update the UI state
                window.location.reload();
            } else {
                alert('Error: ' + (result.message || 'Failed to send order to reverification'));
            }
        },
        error: function() {
            alert('Error occurred while sending order to reverification.');
        }
    });
}

function initializeUnitCaseQuantityHandlers() {
    // Handle unit/case selector change
    $(document).on('change', '.unit-case-selector', function() {
        const $selector = $(this);
        const $wrapper = $selector.closest('.quantity-unit-case-wrapper');
        const $displayInput = $wrapper.find('.quantity-display-input');
        const $hiddenInput = $wrapper.find('.actual-quantity-input');
        const caseSize = parseFloat($wrapper.data('case-size'));
        const currentActualQty = parseFloat($hiddenInput.val());
        const selectedUnit = $selector.val();

        if (selectedUnit === 'case') {
            // Convert units to cases for display
            const cases = currentActualQty / caseSize;
            // Round to 2 decimal places for display
            $displayInput.val(Math.round(cases * 100) / 100 || 1);
            $displayInput.attr('step', '0.01');
        } else {
            // Show actual units
            $displayInput.val(currentActualQty);
            $displayInput.attr('step', '1');
        }

        // Store the current display value as original to prevent auto-save on unit switch
        $displayInput.data('display-original-value', $displayInput.val());
    });

    // Handle display input change - update hidden field with unit quantity
    $(document).on('blur', '.quantity-display-input', function() {
        const $displayInput = $(this);
        const $wrapper = $displayInput.closest('.quantity-unit-case-wrapper');
        const $selector = $wrapper.find('.unit-case-selector');
        const $hiddenInput = $wrapper.find('.actual-quantity-input');
        const caseSize = parseFloat($wrapper.data('case-size'));
        const displayValue = parseFloat($displayInput.val());
        const selectedUnit = $selector.val();

        // Convert to unit quantity
        let unitQuantity;
        if (selectedUnit === 'case') {
            // Convert cases to units
            unitQuantity = displayValue * caseSize;
        } else {
            // Direct unit value
            unitQuantity = displayValue;
        }

        // Update hidden input value
        $hiddenInput.val(unitQuantity);

        // Trigger blur on hidden input to fire the existing auto-save logic
        $hiddenInput.trigger('blur');
    });

    // Initialize display values based on current quantities
    $('.quantity-unit-case-wrapper').each(function() {
        const $wrapper = $(this);
        const $displayInput = $wrapper.find('.quantity-display-input');
        const $hiddenInput = $wrapper.find('.actual-quantity-input');
        const $selector = $wrapper.find('.unit-case-selector');
        const caseSize = parseFloat($wrapper.data('case-size'));
        const actualQty = parseFloat($hiddenInput.val());

        // Default to units view
        $selector.val('unit');
        $displayInput.val(actualQty);
    });
}
</script>

