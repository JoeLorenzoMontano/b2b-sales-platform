<script>
$(document).ready(function() {
    // Initialize all functionality
    initializeOrderInfoTabs();
    initializeInlineEditing();
    initializeSalesEmployeeHandlers();
    initializeImpersonationHandlers();
    initializeOrderTags();
    checkShipments();
});

// Tab switching functionality for Order Summary and Order Tags
function initializeOrderInfoTabs() {
    // Handle tab clicks
    $('#tab-order-summary, #tab-order-tags').click(function() {
        var tabId = $(this).attr('id');
        var panelId = $(this).attr('aria-controls');
        
        // Remove active state from all tabs
        $('.stash-tab').removeClass('stash-tab--active tw-border-blue-500 tw-bg-white')
                       .addClass('tw-text-gray-700')
                       .find('span').removeClass('tw-text-blue-500');
        
        // Add active state to clicked tab
        $(this).addClass('stash-tab--active tw-border-blue-500 tw-bg-white')
               .removeClass('tw-text-gray-700')
               .find('span').addClass('tw-text-blue-500');
        
        // Hide all panels
        $('[role="tabpanel"]').hide();
        
        // Show selected panel
        $('#' + panelId).show();
        
        // Update ARIA attributes
        $('.stash-tab').attr('aria-selected', 'false');
        $(this).attr('aria-selected', 'true');
    });
}

// Inline editing functionality (from original Products tab)
function initializeInlineEditing() {
    // Handle blur event for auto-save on price and quantity fields
    $(document).on('blur', 'input[name^="Items"][name$="UnitPriceExclTaxValue"], input[name^="Items"][name$="Quantity"], .mobile-price-input, .mobile-qty-input', function() {
        const $field = $(this);
        const fieldName = $field.attr('name');
        const indexMatch = fieldName.match(/Items\[(\d+)\]/);
        
        let orderItemId = null;
        if (indexMatch) {
            const index = indexMatch[1];
            const $idField = $(`input[name="Items[${index}].Id"]`);
            orderItemId = $idField.val();
        }
        
        const originalValue = $field.data('original-value') || $field.attr('data-original-value');
        const newValue = $field.val().trim();
        
        // Store original value if not already stored
        if (!originalValue) {
            $field.data('original-value', newValue);
            return;
        }
        
        // Validate we have an order item ID
        if (!orderItemId) {
            console.error('No order item ID found for field:', $field.attr('name'));
            showFieldError($field, 'Unable to identify order item');
            return;
        }
        
        // Only save if value changed and is valid
        if (newValue !== originalValue && isValidValue(newValue, getFieldType($field))) {
            autoSaveOrderItem(orderItemId, $field, newValue);
        } else if (newValue === originalValue) {
            clearFieldError($field);
        } else if (!isValidValue(newValue, getFieldType($field))) {
            showFieldError($field, getValidationMessage(getFieldType($field)));
        }
    });

    // Handle focus event - clear errors and store original value
    $(document).on('focus', 'input[name^="Items"][name$="UnitPriceExclTaxValue"], input[name^="Items"][name$="Quantity"], .mobile-price-input, .mobile-qty-input', function() {
        const $field = $(this);
        clearFieldError($field);
        
        if (!$field.data('original-value')) {
            $field.data('original-value', $field.val());
        }
    });

    // Prevent form submission when pressing Enter
    $(document).on('keypress', 'input[name^="Items"][name$="UnitPriceExclTaxValue"], input[name^="Items"][name$="Quantity"], .mobile-price-input, .mobile-qty-input', function(e) {
        if (e.which === 13) {
            $(this).blur();
            return false;
        }
    });
}

// Sales employee functionality
function initializeSalesEmployeeHandlers() {
    $("#salesEmployeeIdSelect").change(function() {
        $("#submitSalesEmployee").addClass("btn-primary").removeClass("btn-success");
    });
    
    $("#submitSalesEmployee").click(function(e) {
        e.preventDefault();
        
        var orderId = '@Model.Id';
        var salesEmployeeId = $("#salesEmployeeIdSelect").val();
        
        $.ajax({
            url: '@Url.Action("SaveSalesEmployee", "Order", new { area = "Admin" })',
            type: 'POST',
            data: {
                id: orderId,
                salesEmployeeId: salesEmployeeId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(result) {
                if (result.success) {
                    $("#submitSalesEmployee").addClass("btn-success").removeClass("btn-primary");
                    displaySuccessMessage("Sales representative updated successfully");
                } else {
                    displayErrorMessage(result.message || "Error saving sales employee");
                }
            },
            error: function(xhr, status, error) {
                console.error("Error saving sales employee:", error);
                displayErrorMessage("Error saving sales employee. Please try again.");
            }
        });
    });
}

// Impersonation functionality
function initializeImpersonationHandlers() {
    $("#btnChangeImpersonation").click(function() {
        $("#impersonationSelector").toggle();
    });
    
    $("#cancelImpersonatedEmployee").click(function() {
        $("#impersonationSelector").hide();
    });
    
    // Customer search functionality
    $("#searchImpersonatedEmployee").click(function() {
        var searchTerm = $("#impersonatedEmployeeIdSearch").val();
        if (!searchTerm || searchTerm.trim() === '') {
            alert("Please enter a search term");
            return;
        }
        
        $(this).html('<i class="fa fa-spinner fa-spin"></i> Searching...');
        $(this).prop('disabled', true);
        
        $.ajax({
            url: '@Url.Action("CustomerSearchAutoComplete", "Customer", new { area = "Admin" })',
            type: 'GET',
            data: { term: searchTerm },
            success: function(data) {
                $("#searchImpersonatedEmployee").html('<i class="fa fa-search"></i> Search');
                $("#searchImpersonatedEmployee").prop('disabled', false);
                
                var $select = $("#impersonatedEmployeeIdSelect");
                var selectedValue = $select.val();
                $select.find('option').not(':first').not('[value="' + selectedValue + '"]').remove();
                
                if (data && data.length > 0) {
                    $.each(data, function(index, item) {
                        if (item.id !== selectedValue) {
                            $select.append(new Option(item.label, item.id));
                        }
                    });
                } else {
                    alert("No customers found matching your search criteria");
                }
            },
            error: function() {
                $("#searchImpersonatedEmployee").html('<i class="fa fa-search"></i> Search');
                $("#searchImpersonatedEmployee").prop('disabled', false);
                alert("Error searching for customers. Please try again.");
            }
        });
    });
    
    $("#impersonatedEmployeeIdSearch").keypress(function(e) {
        if (e.which === 13) {
            e.preventDefault();
            $("#searchImpersonatedEmployee").click();
        }
    });
    
    $("#submitImpersonatedEmployee").click(function() {
        var orderId = '@Model.Id';
        var impersonatedEmployeeId = $("#impersonatedEmployeeIdSelect").val();
        
        $.ajax({
            url: '@Url.Action("SaveImpersonatedEmployee", "Order", new { area = "Admin" })',
            type: 'POST',
            data: {
                id: orderId,
                impersonatedEmployeeId: impersonatedEmployeeId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(result) {
                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || "Error saving impersonated employee");
                }
            },
            error: function() {
                alert("Error saving impersonated employee. Please try again.");
            }
        });
    });
    
    $("#removeImpersonatedEmployee").click(function() {
        if (confirm("Are you sure you want to remove the impersonated employee?")) {
            var orderId = '@Model.Id';
            
            $.ajax({
                url: '@Url.Action("SaveImpersonatedEmployee", "Order", new { area = "Admin" })',
                type: 'POST',
                data: {
                    id: orderId,
                    impersonatedEmployeeId: "",
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(result) {
                    if (result.success) {
                        location.reload();
                    } else {
                        alert(result.message || "Error removing impersonated employee");
                    }
                },
                error: function() {
                    alert("Error removing impersonated employee. Please try again.");
                }
            });
        }
    });
}

// Order tags functionality
function initializeOrderTags() {
    // Initialize tag editor
    @Html.Raw(orderTagsSB.ToString())
    $("#@Html.IdFor(model => model.OrderTags)").tagEditor({
        autocomplete: {
            delay: 0,
            position: { collision: 'flip' },
            source: initialOrderTags
        },
        delimiter: ',',
        placeholder: 'Enter tags...'
    });
}

// Helper functions for field validation and saving
function getFieldType($field) {
    const name = $field.attr('name');
    if (name.includes('UnitPriceExclTaxValue')) return 'price';
    if (name.includes('Quantity')) return 'quantity';
    return 'unknown';
}

function isValidValue(value, fieldType) {
    if (!value || value === '') return false;
    
    if (fieldType === 'quantity') {
        const num = parseInt(value);
        return /^\d+$/.test(value) && num > 0;
    }
    
    if (fieldType === 'price') {
        const num = parseFloat(value);
        return /^\d+(\.\d{1,2})?$/.test(value) && num >= 0;
    }
    
    return false;
}

function getValidationMessage(fieldType) {
    if (fieldType === 'quantity') {
        return 'Quantity must be a positive whole number';
    }
    if (fieldType === 'price') {
        return 'Price must be a valid decimal number (e.g., 12.34)';
    }
    return 'Invalid value';
}

function autoSaveOrderItem(orderItemId, $field, newValue) {
    const $row = $field.closest('tr');
    const $mobileCard = $field.closest('.mobile-product-card');
    const $statusDiv = $row.length ? $row.find('#save-status-' + orderItemId) : $mobileCard.find('#save-status-' + orderItemId);
    const orderId = $('input[name="Id"]').val();
    const fieldType = getFieldType($field);
    
    $statusDiv.html('<small class="text-muted"><i class="fa fa-spinner fa-spin"></i> Saving...</small>').show();
    $field.prop('disabled', true);
    
    $.ajax({
        url: '@Url.Action("UpdateOrderItemField", "Order", new { area = "Admin" })',
        type: 'POST',
        data: addAntiForgeryToken({
            orderId: orderId,
            orderItemId: orderItemId,
            fieldType: fieldType,
            value: newValue
        }),
        success: function(response) {
            if (response.success) {
                $field.data('original-value', newValue);
                $statusDiv.html('<small class="text-success"><i class="fa fa-check"></i> Saved</small>');
                
                if (response.newSubTotal) {
                    updateSubTotal(orderItemId, response.newSubTotal);
                }
                if (response.displayValue) {
                    updateDisplayValue(orderItemId, fieldType, response.displayValue);
                }
                
                clearFieldError($field);
            } else {
                showFieldError($field, response.message || 'Save failed');
                $field.val($field.data('original-value'));
            }
        },
        error: function(xhr, status, error) {
            showFieldError($field, 'Network error - please try again');
            $field.val($field.data('original-value'));
        },
        complete: function() {
            $field.prop('disabled', false);
            setTimeout(function() {
                $statusDiv.hide();
            }, 2000);
        }
    });
}

function showFieldError($field, message) {
    clearFieldError($field);
    $field.addClass('is-invalid border-danger');
    const errorHtml = '<div class="invalid-feedback d-block">' + message + '</div>';
    $field.after(errorHtml);
}

function clearFieldError($field) {
    $field.removeClass('is-invalid border-danger');
    $field.next('.invalid-feedback').remove();
}

function updateSubTotal(orderItemId, newSubTotal) {
    const $subtotalElement = $('.subtotal-display[data-order-item-id="' + orderItemId + '"]');
    if ($subtotalElement.length > 0) {
        $subtotalElement.text(newSubTotal);
    }
}

function updateDisplayValue(orderItemId, fieldType, displayValue) {
    const $field = $('[name^="Items"][name$="Id"][value="' + orderItemId + '"]').closest('tr');
    if (fieldType === 'price') {
        $field.find('.text-info span').text('Display: ' + displayValue);
    }
}

function displaySuccessMessage(message) {
    var alert = $('<div class="alert alert-success fade show mt-2" role="alert">' + message + '</div>');
    $("#salesEmployeeIdSelect").after(alert);
    setTimeout(function() {
        alert.fadeOut('slow', function() {
            $(this).remove();
        });
    }, 3000);
}

function displayErrorMessage(message) {
    var alert = $('<div class="alert alert-danger fade show mt-2" role="alert">' + message + '</div>');
    $("#salesEmployeeIdSelect").after(alert);
    setTimeout(function() {
        alert.fadeOut('slow', function() {
            $(this).remove();
        });
    }, 5000);
}

// ProductSearchAdd integration
function refreshCurrentProductsGrid() {
    window.location.reload();
}

// Check for existing shipments and hide ProductSearchAdd if shipments exist
function checkShipments() {
    var isVerifiedOrder = @Json.Serialize(Model.IsVerifiedOrder);
    
    if (isVerifiedOrder) {
        $('.add-products-section').hide();
        $('.add-products-section').after(
            '<div class="shipment-warning alert alert-warning mt-3">' +
            '<i class="fa fa-warning"></i> ' +
            'Cannot add products to orders in fulfillment queue. ' +
            '<button type="button" class="btn btn-primary btn-sm ml-2" onclick="sendToReverificationFromProducts(\'' + '@Model.Id' + '\')">' +
            '<i class="fa fa-undo"></i> Send to Reverification' +
            '</button>' +
            '</div>'
        );
        return;
    }
    
    $.ajax({
        url: "@Html.Raw(Url.Action("ShipmentsByOrder", "Shipment", new { orderId = Model.Id, area = "Admin" }))",
        type: "POST",
        data: { __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
        dataType: "json",
        success: function(data) {
            if (data && data.Total > 0) {
                $('.add-products-section').hide();
                $('.add-products-section').after(
                    '<div class="shipment-warning alert alert-warning mt-3">' +
                    '<i class="fa fa-warning"></i> ' +
                    'Cannot add products when shipments exist. Please delete existing shipments first to add new products.' +
                    '</div>'
                );
            } else {
                $('.add-products-section').show();
                $('.shipment-warning').remove();
            }
        },
        error: function() {
            if (!isVerifiedOrder) {
                $('.add-products-section').show();
            }
        }
    });
}

function sendToReverificationFromProducts(orderId) {
    if (!confirm('Are you sure you want to send this order back to reverification? This will delete any existing shipments.')) {
        return;
    }
    
    $.ajax({
        url: "@Html.Raw(Url.Action("SendToReverification", "Order", new { area = "Admin" }))",
        type: "POST",
        data: addAntiForgeryToken({ orderId: orderId }),
        dataType: "json",
        success: function(result) {
            if (result.success) {
                window.location.reload();
            } else {
                alert('Error: ' + (result.message || 'Failed to send order to reverification'));
            }
        },
        error: function() {
            alert('Error occurred while sending order to reverification.');
        }
    });
}

// Order status change functionality (preserve from original)
function toggleChangeOrderStatus(editmode) {
    if (editmode) {
        $('#pnlChangeOrderStatus').show();
        $('#btnChangeOrderStatus').hide();
    } else {
        $('#pnlChangeOrderStatus').hide();
        $('#btnChangeOrderStatus').show();
    }
}

function toggleOrderTotals(editmode) {
    if (editmode) {
        $('#trEditOrderTotals').show();
        $('#btnEditOrderTotals').hide();
        $('#btnSaveOrderTotals').show();
        $('#btnCancelOrderTotals').show();
    } else {
        $('#trEditOrderTotals').hide();
        $('#btnEditOrderTotals').show();
        $('#btnSaveOrderTotals').hide();
        $('#btnCancelOrderTotals').hide();
    }
}

// Toggle products list expand/collapse
function toggleProductsList() {
    const content = $('#products-list-content');
    const arrow = $('#products-arrow');
    
    // Toggle content with smooth slide animation
    content.slideToggle(300);
    
    // Toggle arrow direction
    if (arrow.hasClass('fa-chevron-down')) {
        arrow.removeClass('fa-chevron-down').addClass('fa-chevron-up');
    } else {
        arrow.removeClass('fa-chevron-up').addClass('fa-chevron-down');
    }
}
</script>